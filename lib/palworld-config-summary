from pathlib import Path

SECRET_KEYS = {"AdminPassword", "ServerPassword"}
RELEVANT_KEYS = [
    "ServerName", "ServerDescription", "Region", "ServerPlayerMaxNum",
    "PublicIP", "PublicPort", "ServerPassword", "AdminPassword",
    "bUseAuth", "CrossplayPlatforms", "bShowPlayerList",
    "RESTAPIEnabled", "RESTAPIPort", "RCONEnabled", "RCONPort",
    "ExpRate", "PalCaptureRate", "PalSpawnNumRate", "DeathPenalty",
    "bEnableNonLoginPenalty", "PalEggDefaultHatchingTime",
    "BaseCampMaxNum", "BaseCampMaxNumInGuild", "BaseCampWorkerMaxNum",
    "GuildPlayerMaxNum", "MaxBuildingLimitNum", "AutoSaveSpan",
    "bIsUseBackupSaveData", "LogFormatType",
]

def parse_settings(path: str) -> dict[str, str]:
    text = Path(path).read_text(errors="ignore").replace("\r\n", "\n")
    marker = "OptionSettings=("
    start = text.find(marker)
    if start < 0:
        return {}
    i = start + len(marker)
    depth = 0
    in_str = False
    esc = False
    cur = []
    parts = []
    while i < len(text):
        ch = text[i]
        if esc:
            cur.append(ch); esc = False; i += 1; continue
        if ch == "\\" and in_str:
            cur.append(ch); esc = True; i += 1; continue
        if ch == "\"":
            in_str = not in_str; cur.append(ch); i += 1; continue
        if not in_str:
            if ch == "(":
                depth += 1; cur.append(ch); i += 1; continue
            if ch == ")":
                if depth == 0:
                    if cur: parts.append("".join(cur).strip())
                    break
                depth -= 1; cur.append(ch); i += 1; continue
            if ch == "," and depth == 0:
                parts.append("".join(cur).strip()); cur = []; i += 1; continue
        cur.append(ch); i += 1
    out = {}
    for part in parts:
        if "=" in part:
            k, v = part.split("=", 1)
            out[k.strip()] = v.strip()
    return out

def visible(key: str, val: str | None) -> str:
    if val is None:
        return "<missing>"
    if key in SECRET_KEYS:
        raw = val.strip().strip('"')
        return "set" if raw else "blank"
    if val == '""':
        return "blank"
    return val

def main():
    cfg = parse_settings("/opt/palworld/server/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini")
    print("Relevant server settings:")
    for key in RELEVANT_KEYS:
        if key in cfg:
            print(f"- {key}: {visible(key, cfg.get(key))}")

if __name__ == "__main__":
    main()
