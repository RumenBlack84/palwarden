import argparse
from pathlib import Path

SECRET_KEYS = {"AdminPassword", "ServerPassword"}
MAX_VALUE_LEN = 120

def parse_settings(path: str) -> dict[str, str]:
    text = Path(path).read_text(errors="ignore").replace("\r\n", "\n")
    start = text.find("OptionSettings=(")
    if start < 0:
        return {}
    i = start + len("OptionSettings=(")
    depth = 0
    in_str = False
    esc = False
    cur = []
    parts = []
    while i < len(text):
        ch = text[i]
        if esc:
            cur.append(ch); esc = False; i += 1; continue
        if ch == "\\" and in_str:
            cur.append(ch); esc = True; i += 1; continue
        if ch == "\"":
            in_str = not in_str; cur.append(ch); i += 1; continue
        if not in_str:
            if ch == "(":
                depth += 1; cur.append(ch); i += 1; continue
            if ch == ")":
                if depth == 0:
                    if cur:
                        parts.append("".join(cur).strip())
                    break
                depth -= 1; cur.append(ch); i += 1; continue
            if ch == "," and depth == 0:
                parts.append("".join(cur).strip())
                cur = []
                i += 1
                continue
        cur.append(ch)
        i += 1
    out = {}
    for part in parts:
        if "=" not in part:
            continue
        k, v = part.split("=", 1)
        out[k.strip()] = v.strip()
    return out

def sanitize(key: str, val: str | None) -> str:
    if val is None:
        return "<unset>"
    if len(val) > MAX_VALUE_LEN:
        return val[:MAX_VALUE_LEN-3] + "..."
    return val

def main():
    ap = argparse.ArgumentParser(description="Sanitized Palworld config diff")
    ap.add_argument("before")
    ap.add_argument("after")
    ap.add_argument("--discord", action="store_true", help="format as a compact Discord message body")
    args = ap.parse_args()
    before = parse_settings(args.before)
    after = parse_settings(args.after)
    keys = sorted(set(before) | set(after))
    changes = []
    for k in keys:
        if k in SECRET_KEYS:
            continue
        if before.get(k) != after.get(k):
            changes.append((k, sanitize(k, before.get(k)), sanitize(k, after.get(k))))
    if not changes:
        print("No non-secret config changes detected.")
        return
    if args.discord:
        lines = ["Config changes:"]
        for k, old, new in changes[:20]:
            lines.append(f"- {k}: {old} → {new}")
        if len(changes) > 20:
            lines.append(f"...and {len(changes)-20} more changes.")
        text = "\n".join(lines)
        if len(text) > 1700:
            text = text[:1690] + "\n...(truncated)"
        print(text)
    else:
        for k, old, new in changes:
            print(f"{k}: {old} -> {new}")

if __name__ == "__main__":
    main()
