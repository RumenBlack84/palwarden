#!/usr/bin/env python3
# Test fixture: a stand-in Palworld server binary that ALSO serves a minimal REST
# API on :8212, so the update-apply flow's readiness checks (palworld-api info)
# and the ss :8212 probe behave like a real server. Saves on SIGINT then exits.
import http.server, socketserver, threading, signal, sys, time, json

class H(http.server.BaseHTTPRequestHandler):
    def _ok(self, obj):
        b = json.dumps(obj).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        if self.path.startswith("/v1/api/info"):
            self._ok({"version": "v1.0.0", "servername": "fake"})
        elif self.path.startswith("/v1/api/metrics"):
            self._ok({"serverfps": 60, "currentplayernum": 0, "maxplayernum": 32, "uptime": 10, "days": 1})
        else:
            self.send_response(404); self.end_headers()
    def do_POST(self):
        self._ok({})   # save/shutdown endpoints (harmless no-ops)
    def log_message(self, *a):
        pass

class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True

def serve():
    Server(("0.0.0.0", 8212), H).serve_forever()

threading.Thread(target=serve, daemon=True).start()

def on_int(sig, frame):
    print("[game] SIGINT received: saving world...", flush=True)
    time.sleep(1)
    print("[game] world saved, exiting cleanly", flush=True)
    sys.exit(0)

signal.signal(signal.SIGINT, on_int)
print("[game] dedicated server running (REST on :8212)", flush=True)
while True:
    time.sleep(1)
