[Unit]
Description=Palworld web UI job worker (privileged half of the control plane)
After=network.target

[Service]
Type=simple
# Runs as root on purpose. This is the whole point of the split: the web UI
# (palworld-config-webui.service, User=palworld) can only *write* job files,
# while everything that needs privilege — applying config, restarting
# palworld.service, running SteamCMD — happens here, behind jobd's own
# allowlist re-validation of every action and parameter.
ExecStart=/usr/local/sbin/palwarden-jobd
Restart=on-failure
RestartSec=5
# Hardening is chosen against the exact set of writes this worker performs:
# /etc/palworld/engine.env, the game's config directory under /opt/palworld, the
# job queue plus telemetry DB under /var/lib/palworld, and its own flock at
# /run/palwarden-jobd.lock.
ProtectSystem=true
# ProtectSystem=true (not =strict, not =full) is the strongest setting compatible
# with that list: it makes /usr and /boot read-only, which the worker never
# writes, while leaving /etc, /opt, /var and /run writable. =full would make /etc
# read-only and break engine_save; =strict would make all of the above read-only
# and turn every action into a job that fails at its last step. It is also the one
# directive here that installs no syscall filter, so it cannot surprise SteamCMD.
#
# Deliberately still absent:
#  * ProtectHome= — SteamCMD (update_apply) writes the service account's
#    ~/.steam, and PALWORLD_DROP_PRIV runs it from this unit's process tree.
#  * NoNewPrivileges= — palworld-update drops to the service account with sudo
#    (PALWORLD_DROP_PRIV), which needs a setuid exec.
#  * ProtectKernelModules=/LockPersonality= — both were briefly set here and
#    removed. Both install a seccomp filter (and the former also hides
#    /usr/lib/modules) directly in the path of SteamCMD's 32-bit binaries during
#    update_apply, and no bare-metal update_apply has ever been run under this
#    unit: the integration suite is Docker/s6 only and cannot exercise a systemd
#    unit at all, so `systemd-analyze verify` — a parse, not a run — was the whole
#    of the evidence. Good candidates once someone has run a real bare-metal
#    update under this unit and seen it succeed.
#  * PrivateTmp=/PrivateDevices=/ProtectKernelTunables= — untested against the
#    full job chain (game restarts, SteamCMD); not added on speculation.
#
# The worker serialises itself with an exclusive flock on
# /run/palwarden-jobd.lock, which it creates itself; /run stays writable under
# ProtectSystem=true, so no RuntimeDirectory= is required for that.

[Install]
WantedBy=multi-user.target
