[Unit]
Description=Palworld authenticated web UI and config API
After=network.target

[Service]
Type=simple
User=palworld
Group=palworld
WorkingDirectory=/opt/palworld/tools/config-webui
ExecStart=/usr/local/sbin/palwarden-webui --serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/palworld

[Install]
WantedBy=multi-user.target
