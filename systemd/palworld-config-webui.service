[Unit]
Description=Palworld static config editor web UI (local-only)
After=network.target

[Service]
Type=simple
User=palworld
Group=palworld
WorkingDirectory=/opt/palworld/tools/config-webui
ExecStart=/usr/bin/python3 -m http.server 8088 --bind 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/palworld/tools/config-webui

[Install]
WantedBy=multi-user.target
