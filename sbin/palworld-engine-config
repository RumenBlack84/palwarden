    Setting("MAX_DYNAMIC_BANDWIDTH", "/Script/Engine.GameNetworkManager", "MaxDynamicBandwidth", "int", 10000, 500000, "Maximum dynamic bandwidth per client."),
    Setting("MIN_DYNAMIC_BANDWIDTH", "/Script/Engine.GameNetworkManager", "MinDynamicBandwidth", "int", 1000, 250000, "Minimum dynamic bandwidth per client."),
