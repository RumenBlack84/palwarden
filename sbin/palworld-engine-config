def parse_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text(errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if key in SETTING_BY_ENV:
            values[key] = value
    return values


def normalize_value(setting: Setting, raw: str) -> str:
    v = raw.strip()
    if setting.kind == "bool":
        low = v.lower()
        if low in {"1", "true", "yes", "on"}:
            return "1"
        if low in {"0", "false", "no", "off"}:
            return "0"
        raise ValueError(f"{setting.env} must be boolean-like, got {raw!r}")
    if setting.kind == "int":
        try:
            n = int(v)
        except ValueError as e:
            raise ValueError(f"{setting.env} must be an integer, got {raw!r}") from e
        if setting.minimum is not None and n < setting.minimum:
            raise ValueError(f"{setting.env} must be >= {setting.minimum}, got {n}")
        if setting.maximum is not None and n > setting.maximum:
            raise ValueError(f"{setting.env} must be <= {setting.maximum}, got {n}")
        return str(n)
    if setting.kind == "float":
        try:
            n = float(v)
        except ValueError as e:
            raise ValueError(f"{setting.env} must be numeric, got {raw!r}") from e
        if setting.minimum is not None and n < setting.minimum:
            raise ValueError(f"{setting.env} must be >= {setting.minimum}, got {n}")
        if setting.maximum is not None and n > setting.maximum:
            raise ValueError(f"{setting.env} must be <= {setting.maximum}, got {n}")
        return f"{n:g}"
    raise ValueError(f"unknown type for {setting.env}: {setting.kind}")


def split_sections(text: str) -> list[tuple[str | None, list[str]]]:
    sections: list[tuple[str | None, list[str]]] = []
    current_name: str | None = None
    current_lines: list[str] = []
    for line in text.replace("\r\n", "\n").splitlines():
        m = re.match(r"^\s*\[([^]]+)\]\s*$", line)
        if m:
            sections.append((current_name, current_lines))
            current_name = m.group(1).strip()
            current_lines = [line]
        else:
            current_lines.append(line)
    sections.append((current_name, current_lines))
    return sections


def set_key_in_section(lines: list[str], key: str, value: str) -> tuple[list[str], str | None]:
    out: list[str] = []
    old: str | None = None
    replaced = False
    key_re = re.compile(rf"^\s*{re.escape(key)}\s*=")
    for line in lines:
        if key_re.match(line):
            if old is None:
                old = line.split("=", 1)[1].strip()
            if not replaced:
                out.append(f"{key}={value}")
                replaced = True
            # Drop duplicate occurrences of the managed key in the same section.
            continue
        out.append(line)
    if not replaced:
        if out and out[-1].strip() != "":
            out.append(f"{key}={value}")
        else:
            out.append(f"{key}={value}")
    return out, old


def apply_settings(text: str, env_values: dict[str, str]) -> tuple[str, list[tuple[Setting, str | None, str]]]:
    desired: dict[tuple[str, str], tuple[Setting, str]] = {}
    for env, raw in env_values.items():
        setting = SETTING_BY_ENV[env]
        desired[(setting.section, setting.key)] = (setting, normalize_value(setting, raw))

    sections = split_sections(text)
    changes: list[tuple[Setting, str | None, str]] = []
    seen_sections: set[str] = set()
    new_sections: list[tuple[str | None, list[str]]] = []

    for name, lines in sections:
        if name is None:
            new_sections.append((name, lines))
            continue
        seen_sections.add(name)
        section_desired = [(s, v) for (section, _), (s, v) in desired.items() if section == name]
        for setting, value in section_desired:
            lines, old = set_key_in_section(lines, setting.key, value)
            if old != value:
                changes.append((setting, old, value))
        new_sections.append((name, lines))

    missing_by_section: dict[str, list[tuple[Setting, str]]] = {}
    for (section, _), (setting, value) in desired.items():
        if section in seen_sections:
            continue
        missing_by_section.setdefault(section, []).append((setting, value))
    for section, items in missing_by_section.items():
        lines = ["", f"[{section}]"]
        for setting, value in items:
            lines.append(f"{setting.key}={value}")
            changes.append((setting, None, value))
        new_sections.append((section, lines))
        seen_sections.add(section)

    out_lines: list[str] = []
    for _, lines in new_sections:
        out_lines.extend(lines)
    return "\n".join(out_lines).rstrip() + "\n", changes


def write_pretty(engine_ini: Path, pretty_ini: Path) -> None:
    # Both ends live in the config directory, which the unprivileged game/web user
    # owns: the read must not be redirected onto a secret (the pretty copy ends up
    # 0644 and owned by that user), and the write must not be redirected onto an
    # arbitrary file. See read_nofollow / write_dest_nofollow.
    raw, _ = read_nofollow(engine_ini, engine_ini.name)
    text = raw.decode(errors="replace").replace("\r\n", "\n")
    managed = {(s.section, s.key): s for s in SETTINGS}
    lines = ["; Human-readable reference copy. Engine.ini remains canonical.", "; Managed Palworld performance keys are annotated below.", ""]
    current_section: str | None = None
    for line in text.splitlines():
        m = re.match(r"^\s*\[([^]]+)\]\s*$", line)
        if m:
            current_section = m.group(1).strip()
            lines.append(line)
            continue
        if current_section and "=" in line:
            key = line.split("=", 1)[0].strip()
            setting = managed.get((current_section, key))
            if setting:
                lines.append(f"; {setting.env}: {setting.description}")
        lines.append(line)
    write_dest_nofollow(pretty_ini, ("\n".join(lines).rstrip() + "\n").encode(), pretty_ini.name)


def format_changes(changes: Iterable[tuple[Setting, str | None, str]]) -> str:
    changes = list(changes)
    if not changes:
        return "No Engine.ini performance changes detected."
    lines = ["Engine.ini performance changes:"]
    for setting, old, new in changes:
        lines.append(f"- [{setting.section}] {setting.key}: {old if old is not None else '<unset>'} → {new}")
    return "\n".join(lines)


def notify(message: str) -> None:
    if not Path(NOTIFY).exists():
        return
    env = os.environ.copy()
    env["PALWORLD_ENGINE_NOTIFY_MESSAGE"] = message
    command = f'source {NOTIFY} || true; palworld_notify success "$PALWORLD_ENGINE_NOTIFY_MESSAGE" >/dev/null 2>&1 || true'
    subprocess.run(
        ["bash", "-lc", command],
        env=env,
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def mark_event(label: str, category: str = "config", details: str | None = None) -> None:
    """Record an FPS event marker. Purely decorative: never break a config apply."""
    cmd = [FPS_BIN, "mark", label, "--category", category]
    if details:
        cmd.extend(["--details", details])
    try:
        subprocess.run(cmd, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass  # telemetry helper missing (e.g. not installed yet)


def parse_ini_values_multi(text: str) -> dict[str, list[str]]:
    """Collect every occurrence of each managed key.

    The game appends its own sections when it rewrites Engine.ini, so a managed
    key can legitimately appear more than once; keeping all occurrences lets the
    drift check flag a genuine conflict instead of silently taking the last one.
    """
    values: dict[str, list[str]] = {}
    env_by_section_key = {(s.section, s.key): s.env for s in SETTINGS}
    for section, lines in split_sections(text):
        if section is None:
            continue
        for line in lines:
            stripped = line.strip()
            if not stripped or stripped.startswith((";", "#", "[")) or "=" not in stripped:
                continue
            key, value = stripped.split("=", 1)
            env = env_by_section_key.get((section, key.strip()))
            if env:
                values.setdefault(env, []).append(value.strip())
    return values


def parse_ini_values(text: str) -> dict[str, str]:
    """Managed values from Engine.ini, last occurrence winning."""
    return {env: raws[-1] for env, raws in parse_ini_values_multi(text).items()}


def normalized_profile_values(profile: dict[str, str]) -> dict[str, str]:
    out: dict[str, str] = {}
    for env, raw in profile.items():
        out[env] = normalize_value(SETTING_BY_ENV[env], raw)
    return out


def match_profile(values: dict[str, str]) -> dict[str, object]:
    best: dict[str, object] | None = None
    for name, raw_profile in PROFILES.items():
        profile = normalized_profile_values(raw_profile)
        missing = [env for env in profile if env not in values]
        different = [
            {"env": env, "expected": expected, "actual": values.get(env)}
            for env, expected in profile.items()
            if env in values and values.get(env) != expected
        ]
        extra = [env for env in values if env not in profile]
        score = len(profile) - len(missing) - len(different) - len(extra)
        result: dict[str, object] = {
            "name": name,
            "exact": not missing and not different and not extra,
            "missing": missing,
            "different": different,
            "extra": extra,
            "score": score,
        }
        if result["exact"]:
            return result
        if best is None or int(result["score"]) > int(best["score"]):
            best = result
    if best is None:
        return {"name": "Custom/unknown", "exact": False, "missing": [], "different": [], "extra": list(values), "score": 0}
    best = dict(best)
    best["exact"] = False
    if int(best.get("score", 0)) <= 0:
        best["name"] = "Custom/unknown"
    return best


def list_backups(backup_dir: Path) -> list[Path]:
    if not backup_dir.exists():
        return []
    return sorted(backup_dir.glob("Engine.ini.*"), key=lambda p: p.stat().st_mtime, reverse=True)


# --- the untrusted backup directory ------------------------------------------
# BACKUP_DIR is writable by a *less privileged* user than the one running this
# tool: the web UI's unprivileged process owns it, and this tool then runs as root
# (from palwarden-jobd, or from an admin's sudo). Every entry in it — names,
# symlinks, existing files alike — is therefore attacker-controlled, and traffic
# goes in *both* directions:
#
#   * reads out of it (rollback's source) — a symlink would publish any
#     root-readable file: settings.env, /etc/shadow;
#   * writes into it (apply's backup, rollback's pre-rollback copy) — a symlink
#     pre-planted at the name we are about to create would redirect root's write
#     onto an arbitrary file. The names are `Engine.ini.<UTC stamp>` at
#     second resolution, so guessing them is trivial: plant a handful of stamps a
#     few seconds ahead and one of them lands.
#
# Reads use read_backup_nofollow; writes use write_new_nofollow. Both push the
# decision into the kernel at the moment of use rather than checking first.
#
# For the read, two guards, and both are needed:
#
#   * `is_symlink()` in resolve_backup gives the *caller* a clear refusal, and is
#     what --dry-run and the pre-flight path can report on. It cannot close the
#     hole on its own: it is a check-then-use, and the name it validated can be
#     replaced with a symlink before (or by another process, between) the open.
#     jobd's own validate_backup has exactly that gap — it validates the name and
#     then spawns *this* tool, which re-resolves it tens of milliseconds later.
#   * `O_NOFOLLOW` on the actual read makes the *kernel* refuse to traverse a
#     link at open() time. That is what actually closes the race: there is no
#     window between the decision and the use, because they are the same syscall.
#
# A *hardlink* with a legitimate-looking name passes both (it is a regular file,
# not a symlink). Deliberately not checked: `fs.protected_hardlinks=1` (default
# on the target distros) stops an unprivileged user hardlinking a file it does not
# own, and reading through a hardlink it *does* own discloses nothing it could not
# already read. Reading via a descriptor also means we never hand the destination
# path back to a follow-capable copy.
#
# --- and the untrusted *config* directory ------------------------------------
# The very same primitive, with no race needed at all: Engine.ini,
# Engine.pretty.ini and their PalWorldSettings siblings live in a directory the
# game's (and the web UI's) unprivileged user owns and must be able to write —
# docker/Dockerfile pre-creates it owned by steam, and the game rewrites
# Engine.ini itself. So that user can simply *replace* one of those names with a
# symlink and wait: root then writes the pretty copy through it, chmods it 0644
# and chowns it to the web user. Pointed at /etc/shadow that is full root, via
# jobd's non-disruptive engine_apply which needs no confirmation.
#
# Every write to those destinations therefore goes through write_dest_nofollow (or
# the O_RDWR open in command_apply), and the owner/mode that follow are applied
# with fchown/fchmod on that same descriptor — a path-based chown after a safe
# write is still a check-then-use the attacker can win by swapping the name in
# afterwards.

MAX_BACKUP_NAME_ATTEMPTS = 20
_OWNER_WARNED: set[str] = set()


def refuse_symlink(exc: OSError, path: Path, what: str) -> None:
    """Translate an O_NOFOLLOW open failure into an operator-readable refusal.

    Linux reports ELOOP when O_NOFOLLOW hits a symlink (some BSDs use EMLINK).
    Left raw that surfaces as "Too many levels of symbolic links", which reads
    like a filesystem fault when it is in fact us refusing to follow a planted
    link — a security event, so say so plainly and name the file. Any other errno
    keeps its own message; EEXIST in particular is usually an innocent same-second
    collision (see write_new_nofollow, which has to look closer because O_EXCL
    reports a symlink as EEXIST rather than reaching ELOOP at all).
    """
    if exc.errno in (errno.ELOOP, errno.EMLINK):
        raise ValueError(f"{what} must not be a symlink; refused: {path}") from exc


def owner_ids() -> tuple[int, int]:
    """Numeric uid/gid for PALWORLD_USER/PALWORLD_GROUP.

    fchown() takes numbers only — unlike shutil.chown it cannot resolve a name —
    so the lookup happens here, and an unknown user or group is reported as the
    configuration error it is rather than a bare KeyError.
    """
    try:
        uid = pwd.getpwnam(PALWORLD_USER).pw_uid
    except KeyError as exc:
        raise LookupError(f"unknown PALWORLD_USER {PALWORLD_USER!r}") from exc
    try:
        gid = grp.getgrnam(PALWORLD_GROUP).gr_gid
    except KeyError as exc:
        raise LookupError(f"unknown PALWORLD_GROUP {PALWORLD_GROUP!r}") from exc
    return uid, gid


def set_owner_mode_fd(fd: int, path: Path, mode: int = 0o644) -> None:
    """Apply the managed owner and mode to the file behind `fd`, not behind a name.

    fchown/fchmod act on the inode we just wrote. That is the point: the path-based
    shutil.chown/os.chmod these replace could be redirected by a symlink swapped in
    after the write, which is the whole escalation.

    Ownership stays best-effort, as it was before: not being root, or a host with
    no such user, must not fail an otherwise good apply — but it now says so once
    instead of silently. The mode is not best-effort; we just created the file.
    """
    try:
        uid, gid = owner_ids()
        os.fchown(fd, uid, gid)
    except (LookupError, OSError) as exc:
        key = f"{PALWORLD_USER}:{PALWORLD_GROUP}"
        if key not in _OWNER_WARNED:
            _OWNER_WARNED.add(key)
            print(f"Warning: cannot set owner {key} on {path}: {exc}", file=sys.stderr)
    os.fchmod(fd, mode)


def write_all(fd: int, data: bytes) -> int:
    """os.write can be a short write; loop until the buffer is out."""
    written = 0
    while written < len(data):
        written += os.write(fd, data[written:])
    return written


def read_fd_all(fd: int) -> bytes:
    """Read an open descriptor to EOF, from wherever its offset is."""
    chunks: list[bytes] = []
    while True:
        chunk = os.read(fd, 1 << 20)
        if not chunk:
            break
        chunks.append(chunk)
    return b"".join(chunks)


def write_new_nofollow(path: Path, data: bytes, mode: int = 0o644) -> Path:
    """Create a NEW file at `path`, refusing to follow a symlink or clobber.

    For writes *into* the untrusted backup directory. `O_EXCL | O_NOFOLLOW` means
    the kernel refuses if anything already exists at the name — including a
    symlink, dangling or not — so a pre-planted link cannot redirect the write,
    and there is no check-then-use window for one to appear in.

    The security property comes from `O_EXCL | O_NOFOLLOW` being on *every*
    attempt, not from the name being unique, so an ordinary collision does not
    have to be fatal: the stamp is second-resolution, and a double-clicked Apply
    (or an engine_save_apply_restart retried after a failed restart) can land two
    backups in one UTC second. On EEXIST over a *regular file* we therefore retry
    `<name>-1`, `-2`, … up to MAX_BACKUP_NAME_ATTEMPTS and return the name actually
    used. A symlink sitting at the name is a different situation entirely and is
    refused outright, never retried.

    Owner and mode are set through this descriptor (see set_owner_mode_fd), so the
    caller must not chown the path afterwards.

    Note this is *not* used for the Engine.ini / pretty destinations, which have
    the opposite requirement: they must truncate a file that already exists. See
    write_dest_nofollow.
    """
    for attempt in range(MAX_BACKUP_NAME_ATTEMPTS):
        candidate = path if attempt == 0 else path.with_name(f"{path.name}-{attempt}")
        try:
            fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
        except OSError as exc:
            refuse_symlink(exc, candidate, "backup")
            if exc.errno == errno.EEXIST:
                # O_CREAT|O_EXCL reports EEXIST for a *symlink* at the name too —
                # it never gets as far as ELOOP — so errno alone cannot separate an
                # innocent same-second collision from a planted link. lstat picks
                # which of the two this is. That is not a security check: the
                # kernel has already refused to create or write anything. It only
                # decides the message, and whether a retry is reasonable at all.
                if candidate.is_symlink():
                    raise ValueError(
                        f"backup must not be a symlink; refused: {candidate}") from exc
                continue
            raise
        try:
            write_all(fd, data)
            set_owner_mode_fd(fd, candidate, mode)
        finally:
            os.close(fd)
        return candidate
    raise OSError(errno.EEXIST,
                  f"no unused backup name after {MAX_BACKUP_NAME_ATTEMPTS} attempts",
                  str(path))


def write_dest_nofollow(path: Path, data: bytes, what: str, mode: int = 0o644) -> None:
    """Overwrite a managed config output in place, refusing to follow a symlink.

    For the destinations in the config directory (Engine.ini's pretty copy, and
    Engine.ini on the rollback path). `O_EXCL` would be wrong here — these files
    are legitimately rewritten on every apply — so `O_NOFOLLOW` alone is what
    refuses a link planted at the name, and it does so in the same syscall that
    creates the file. Owner/mode go on the descriptor, never the path.
    """
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, mode)
    except OSError as exc:
        refuse_symlink(exc, path, what)
        raise
    try:
        write_all(fd, data)
        set_owner_mode_fd(fd, path, mode)
    finally:
        os.close(fd)


def read_nofollow(path: Path, what: str) -> tuple[bytes, os.stat_result]:
    """Read a file in an attacker-writable directory, refusing to traverse a link.

    Returns the contents plus the fstat of the descriptor we actually read, so
    the caller can carry over metadata from the file it really read rather than
    re-stat'ing the (possibly since-swapped) path.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as exc:
        refuse_symlink(exc, path, what)
        raise FileNotFoundError(f"{what} not readable: {path} ({exc.strerror})") from exc
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise ValueError(f"{what} must be a regular file: {path}")
        data = read_fd_all(fd)
    finally:
        os.close(fd)
    return data, st


def read_backup_nofollow(backup: Path) -> tuple[bytes, os.stat_result]:
    """Read a rollback source from the untrusted backup directory."""
    return read_nofollow(backup, "backup")


def resolve_backup(name: str, backup_dir: Path) -> Path:
    if "/" in name or "\\" in name:
        raise ValueError("backup name must be a file name, not a path")
    backup = backup_dir / name
    # is_symlink() uses lstat, so it decides on the entry itself; exists()/
    # is_file() below both follow the link and would happily accept it.
    if backup.is_symlink():
        raise ValueError(f"backup must not be a symlink: {backup}")
    if not backup.exists() or not backup.is_file():
        raise FileNotFoundError(f"backup not found: {backup}")
    return backup


def rollback_engine(name: str, ini_path: Path, backup_dir: Path, pretty_path: Path, save_current: bool = True) -> Path:
    backup = resolve_backup(name, backup_dir)
    # Read the source *before* touching anything, and through a descriptor the
    # kernel refused to open via a symlink: if the entry was swapped since
    # resolve_backup looked at it, this raises instead of copying a secret.
    data, src_st = read_backup_nofollow(backup)
    if save_current and ini_path.exists():
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        pre = backup_dir / f"Engine.ini.pre-rollback.{stamp}"
        current, _ = read_nofollow(ini_path, ini_path.name)
        write_new_nofollow(pre, current)
    # Replaces shutil.copy2(backup, ini_path): same content, and mtime/atime are
    # carried over as copy2 did. The mode copy2 also propagated is dropped, which
    # changes nothing — the chmod 0644 that always followed overwrote it.
    # O_NOFOLLOW because the config directory is the game user's: a symlink left at
    # Engine.ini would otherwise send the backup's bytes (and root's chown/chmod)
    # to a file of the attacker's choosing.
    try:
        ini_fd = os.open(ini_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    except OSError as exc:
        refuse_symlink(exc, ini_path, ini_path.name)
        raise
    try:
        write_all(ini_fd, data)
        os.utime(ini_fd, ns=(src_st.st_atime_ns, src_st.st_mtime_ns))
        set_owner_mode_fd(ini_fd, ini_path, 0o644)
    finally:
        os.close(ini_fd)
    # write_pretty applies the same owner/mode through its own descriptor.
    write_pretty(ini_path, pretty_path)
    return backup


def expected_values_from_env(env_path: Path) -> dict[str, str]:
    if not env_path.exists():
        return {}
    return normalized_profile_values(parse_env(env_path))


def check_expected_values(raw_values: dict[str, list[str]], expected: dict[str, str]) -> dict[str, object]:
    """Compare Engine.ini against the expected (already normalised) values.

    Comparison is **semantic**, not textual: the game rewrites Engine.ini in its
    own format, so `True` must equal `1` and `60.000000` must equal `60`. Both
    sides are normalised before comparing, and a value we cannot parse is reported
    as invalid rather than raising.
    """
    missing: list[str] = []
    different: list[dict[str, object]] = []
    invalid: list[dict[str, object]] = []
    duplicates: list[dict[str, object]] = []

    for env, want in expected.items():
        raws = raw_values.get(env)
        if not raws:
            missing.append(env)
            continue
        setting = SETTING_BY_ENV[env]
        normalised: list[str] = []
        bad = False
        for raw in raws:
            try:
                normalised.append(normalize_value(setting, raw))
            except ValueError as exc:
                invalid.append({"env": env, "actual": raw, "reason": str(exc)})
                bad = True
        if bad:
            continue
        distinct = sorted(set(normalised))
        if len(distinct) > 1:
            duplicates.append({"env": env, "values": raws})
            continue
        if distinct[0] != want:
            different.append({"env": env, "expected": want, "actual": raws[-1]})

    ok = not (missing or different or invalid or duplicates)
    return {
        "ok": ok,
        "missing": missing,
        "different": different,
        "invalid": invalid,
        "duplicates": duplicates,
        "empty": not raw_values,
    }


def format_check(check: dict[str, object], ini_path: Path | None = None) -> str:
    if check.get("ok"):
        return "Engine.ini check OK: managed values match /etc/palworld/engine.env."
    where = f" in {ini_path}" if ini_path else ""
    if check.get("empty"):
        return (f"Engine.ini check FAILED: no managed values{where}. "
                "The server may have reset the file (it writes only non-default "
                "values); re-apply with `palworld-engine-config apply`.")
    lines = ["Engine.ini check FAILED: managed values drifted from /etc/palworld/engine.env."]
    missing = check.get("missing") or []
    different = check.get("different") or []
    invalid = check.get("invalid") or []
    duplicates = check.get("duplicates") or []
    if missing:
        lines.append("Missing: " + ", ".join(missing))
    if different:
        lines.append("Different:")
        for item in different:
            lines.append(f"- {item['env']}: expected {item['expected']}, actual {item['actual']}")
    if invalid:
        lines.append("Unparseable (cannot compare):")
        for item in invalid:
            lines.append(f"- {item['env']}: actual {item['actual']!r} ({item['reason']})")
    if duplicates:
        lines.append("Defined more than once with conflicting values:")
        for item in duplicates:
            lines.append(f"- {item['env']}: " + ", ".join(str(v) for v in item["values"]))
    return "\n".join(lines)


def format_status(ini_path: Path, backup_dir: Path) -> str:
    values = parse_ini_values(ini_path.read_text(errors="replace")) if ini_path.exists() else {}
    match = match_profile(values)
    lines = ["Engine.ini managed status", ""]
    lines.append("Current profile:")
    if match.get("exact"):
        lines.append(f"- {match.get('name')}: exact match")
    else:
        lines.append(f"- {match.get('name')}: partial/custom match")
        if match.get("different"):
            lines.append("  Differences from nearest profile:")
            for item in match.get("different", []):
                lines.append(f"  - {item['env']}: expected {item['expected']}, actual {item['actual']}")
        if match.get("missing"):
            lines.append("  Missing from nearest profile: " + ", ".join(match.get("missing", [])))
        if match.get("extra"):
            lines.append("  Extra managed values: " + ", ".join(match.get("extra", [])))
    lines.append("")
    lines.append("Protection:")
    lines.append("")
    lines.append("Managed values:")
    for setting in SETTINGS:
        if setting.env in values:
            lines.append(f"[{setting.section}] {setting.key}={values[setting.env]}")
        else:
            lines.append(f"[{setting.section}] {setting.key}=<unset>")
    backups = list_backups(backup_dir)
    lines.append("")
    lines.append("Latest Engine.ini backup:")
    lines.append(f"- {backups[0].name}" if backups else "- <none>")
    lines.append("")
    lines.append("Reminder: Engine.ini changes require a graceful restart to take effect.")
    return "\n".join(lines)


def command_status(args: argparse.Namespace) -> int:
    ini_path = Path(args.ini)
    backup_dir = Path(args.backup_dir)
    if args.check:
        if not ini_path.exists():
            print(f"Engine.ini check FAILED: cannot read {ini_path}", file=sys.stderr)
            return 2
        expected = expected_values_from_env(Path(args.env))
        if not expected:
            print(f"Engine.ini check FAILED: no managed values found in {args.env}", file=sys.stderr)
            return 2
        values = parse_ini_values_multi(ini_path.read_text(errors="replace"))
        check = check_expected_values(values, expected)
        print(format_check(check, ini_path))
        return 0 if check.get("ok") else 1
    print(format_status(ini_path, backup_dir))
    return 0


def command_rollback(args: argparse.Namespace) -> int:
    backup_dir = Path(args.backup_dir)
    if args.list:
        backups = list_backups(backup_dir)
        if not backups:
            print(f"No Engine.ini backups found in {backup_dir}")
            return 0
        print("Available Engine.ini backups:")
        for b in backups:
            print(f"- {b.name}")
        return 0
    if not args.backup:
        print("rollback requires a backup name, or use --list", file=sys.stderr)
        return 64
    ini_path = Path(args.ini)
    pretty_path = Path(args.pretty)
    try:
        backup = resolve_backup(args.backup, backup_dir)
    except (ValueError, FileNotFoundError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    if args.dry_run:
        print(f"Would restore {backup} to {ini_path}")
        print("Dry run only; no files changed.")
        return 0
    # rollback_engine re-resolves and re-opens the name: the entry can have been
    # swapped for a symlink since the check above, and O_NOFOLLOW turns that into
    # a ValueError. Report it the same way as a failed pre-flight, not a traceback.
    try:
        restored = rollback_engine(args.backup, ini_path, backup_dir, pretty_path)
    except (ValueError, FileNotFoundError, OSError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(f"Restored {restored} to {ini_path}")
    print(f"Regenerated {pretty_path}")
    print("Restart palworld.service for Engine.ini rollback to take effect.")
    notify(f"Engine.ini rollback restored `{restored.name}`. Restart palworld.service for rollback to take effect.")
    mark_event("Engine.ini rollback applied", details=f"restored={restored.name}")
    return 0


def command_apply(args: argparse.Namespace) -> int:
    env_path = Path(args.env)
    ini_path = Path(args.ini)
    backup_dir = Path(args.backup_dir)
    pretty_path = Path(args.pretty)
    if not env_path.exists():
        print(f"Cannot read {env_path}", file=sys.stderr)
        return 1
    if not ini_path.exists():
        print(f"Cannot read {ini_path}", file=sys.stderr)
        return 1
    env_values = parse_env(env_path)
    if not env_values:
        print(f"No known uncommented Engine.ini overrides found in {env_path}")
        return 0
    # One descriptor for both the read and the write. Engine.ini sits in a
    # directory the unprivileged user owns, so re-opening it by name to write the
    # result would be a TOCTOU: swap the file for a symlink between the two and
    # root writes attacker-authored bytes to an attacker-chosen path. O_NOFOLLOW
    # refuses a link that is there already, and reusing the descriptor means no
    # window exists for one to appear. --dry-run needs no write access.
    flags = (os.O_RDONLY if args.dry_run else os.O_RDWR) | os.O_NOFOLLOW
    try:
        ini_fd = os.open(ini_path, flags)
    except OSError as exc:
        try:
            refuse_symlink(exc, ini_path, ini_path.name)
        except ValueError as refusal:
            print(str(refusal), file=sys.stderr)
            return 1
        print(f"Cannot read {ini_path}: {exc.strerror}", file=sys.stderr)
        return 1
    try:
        return _apply_with_fd(args, ini_fd, ini_path, backup_dir, pretty_path, env_values)
    finally:
        os.close(ini_fd)


def _apply_with_fd(args: argparse.Namespace, ini_fd: int, ini_path: Path,
                   backup_dir: Path, pretty_path: Path, env_values: dict[str, str]) -> int:
    """The body of command_apply, once Engine.ini is open on a trusted descriptor."""
    raw = read_fd_all(ini_fd)
    before = raw.decode(errors="replace")
    try:
        after, changes = apply_settings(before, env_values)
    except ValueError as exc:
        print(f"Validation error: {exc}", file=sys.stderr)
        return 2
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup_dir.mkdir(parents=True, exist_ok=True)
    backup = backup_dir / f"Engine.ini.{stamp}"
    if not args.dry_run:
            # Reachable from the web UI as the engine_apply / engine_save_apply_restart
            # jobd actions, so the backup name is a write into a directory the
            # requester owns; see write_new_nofollow. The bytes are the ones we read
            # through ini_fd, not a second read of the name.
            try:
                backup = write_new_nofollow(backup, raw)
            except (OSError, ValueError) as exc:
                reason = exc.strerror if isinstance(exc, OSError) and exc.strerror else str(exc)
                print(f"Cannot write backup {backup}: {reason}", file=sys.stderr)
                return 1
            payload = after.encode()
            os.lseek(ini_fd, 0, os.SEEK_SET)
            write_all(ini_fd, payload)
            os.ftruncate(ini_fd, len(payload))
            set_owner_mode_fd(ini_fd, ini_path, 0o644)
            # write_pretty applies the same owner/mode through its own descriptor.
            # A refusal here comes after Engine.ini is already updated, so say that
            # too: the apply itself stands, only the reference copy is missing.
            try:
                write_pretty(ini_path, pretty_path)
            except (ValueError, OSError) as exc:
                print(str(exc), file=sys.stderr)
                print(f"Updated {ini_path} (backup: {backup}), but could not write "
                      f"the reference copy {pretty_path}", file=sys.stderr)
                return 1
    summary = format_changes(changes)
    print(summary)
    if args.dry_run:
        print("\nDry run only; no files changed.")
        return 0
    print(f"Updated {ini_path}")
    print(f"Backup: {backup}")
    print("Restart palworld.service for Engine.ini changes to take effect.")
    notify(f"Engine.ini performance config applied; backup: `{backup.name}`. Restart palworld.service for changes to take effect.\n\n{summary}")
    mark_event("Engine.ini performance config applied", details=f"backup={backup.name}; changes={len(changes)}")
    return 0


def command_pretty(args: argparse.Namespace) -> int:
    # A symlink at either end is refused by write_pretty; report it like any other
    # unusable path instead of as a traceback.
    try:
        write_pretty(Path(args.ini), Path(args.pretty))
    except (ValueError, OSError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(args.pretty)
    return 0


def command_diff(args: argparse.Namespace) -> int:
    before = Path(args.before).read_text(errors="replace")
    after = Path(args.after).read_text(errors="replace")
    diff = difflib.unified_diff(before.splitlines(), after.splitlines(), fromfile=args.before, tofile=args.after, lineterm="")
    print("\n".join(diff))
    return 0


def command_template(_: argparse.Namespace) -> int:
    print("# Palworld Engine.ini performance overrides")
    print("# Uncomment only values you intentionally want to manage. Apply with:")
    print("#   sudo /usr/local/sbin/palworld-engine-config apply")
    print("# Then restart gracefully when ready:")
    print("#   sudo /usr/local/sbin/palworld-graceful-restart")
    print("")
    for s in SETTINGS:
        print(f"# {s.description}")
        rng = []
        if s.minimum is not None:
            rng.append(f"min {s.minimum:g}")
        if s.maximum is not None:
            rng.append(f"max {s.maximum:g}")
        if rng:
            print(f"# Range: {', '.join(rng)}")
        print(f"# {s.env}=")
        print("")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("apply")
    p.add_argument("--env", default=str(ENGINE_ENV))
    p.add_argument("--ini", default=str(ENGINE_INI))
    p.add_argument("--backup-dir", default=str(BACKUP_DIR))
    p.add_argument("--pretty", default=str(PRETTY_INI))
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=command_apply)
    p = sub.add_parser("pretty")
    p.add_argument("--ini", default=str(ENGINE_INI))
    p.add_argument("--pretty", default=str(PRETTY_INI))
    p.set_defaults(func=command_pretty)
    p = sub.add_parser("diff")
    p.add_argument("before")
    p.add_argument("after")
    p.set_defaults(func=command_diff)
    p = sub.add_parser("template")
    p.set_defaults(func=command_template)
    p = sub.add_parser("status", help="show managed Engine.ini values and profile match")
    p.add_argument("--ini", default=str(ENGINE_INI))
    p.add_argument("--backup-dir", default=str(BACKUP_DIR))
    p.add_argument("--env", default=str(ENGINE_ENV), help="engine.env expected values for --check")
    p.add_argument("--check", action="store_true", help="exit nonzero if Engine.ini differs from engine.env managed values")
    p.set_defaults(func=command_status)
    p = sub.add_parser("rollback", help="list or restore Engine.ini backups")
    p.add_argument("backup", nargs="?", help="backup file name such as Engine.ini.20260710T182037Z")
    p.add_argument("--list", action="store_true", help="list available Engine.ini backups")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--ini", default=str(ENGINE_INI))
    p.add_argument("--backup-dir", default=str(BACKUP_DIR))
    p.add_argument("--pretty", default=str(PRETTY_INI))
    p.set_defaults(func=command_rollback)
    args = ap.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
