# Paths default to the bare-metal layout; the env overrides let the container
# (and the tests) point at a different tree.
ENGINE_INI = Path(os.environ.get(
    "PALWORLD_ENGINE_INI",
    "/opt/palworld/server/Pal/Saved/Config/LinuxServer/Engine.ini"))
ENGINE_ENV = Path(os.environ.get("PALWORLD_ENGINE_ENV", "/etc/palworld/engine.env"))
BACKUP_DIR = Path(os.environ.get("PALWORLD_BACKUP_DIR", "/opt/palworld/config-backups"))
PRETTY_INI = Path(os.environ.get(
    "PALWORLD_ENGINE_PRETTY_INI",
    "/opt/palworld/server/Pal/Saved/Config/LinuxServer/Engine.pretty.ini"))
NOTIFY = "/usr/local/lib/palworld-notify"
FPS_BIN = os.environ.get("PALWORLD_FPS_BIN", "/usr/local/sbin/palworld-fps")


@dataclass(frozen=True)
class Setting:
    env: str
    section: str
    key: str
    kind: str
    minimum: float | None = None
    maximum: float | None = None
    description: str = ""


SETTINGS: tuple[Setting, ...] = (
    Setting("NET_SERVER_MAX_TICK_RATE", "/Script/OnlineSubsystemUtils.IpNetDriver", "NetServerMaxTickRate", "int", 15, 120, "Dedicated server network tick cap."),
    Setting("MAX_CLIENT_RATE", "/Script/OnlineSubsystemUtils.IpNetDriver", "MaxClientRate", "int", 10000, 500000, "Maximum bytes/sec per LAN client."),
    Setting("MAX_INTERNET_CLIENT_RATE", "/Script/OnlineSubsystemUtils.IpNetDriver", "MaxInternetClientRate", "int", 10000, 500000, "Maximum bytes/sec per internet client."),
    Setting("CONNECTION_TIMEOUT", "/Script/OnlineSubsystemUtils.IpNetDriver", "ConnectionTimeout", "float", 10, 300, "Seconds before a stale connection times out."),
