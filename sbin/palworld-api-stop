#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
set -euo pipefail
source /usr/local/lib/palworld-notify 2>/dev/null || true
# Notifications are optional: no-op when the helper isn't installed, rather than
# aborting on "command not found".
declare -F palworld_notify >/dev/null || palworld_notify() { :; }
waittime="${1:-300}"
message="${2:-Server maintenance: saving and stopping in 5 minutes.}"
palworld_notify warning "REST API timed stop requested; players have ${waittime}s notice. Message: ${message}"
/usr/local/sbin/palworld-api stop "$waittime" "$message"
palworld_notify success "REST API timed stop request accepted; waiting ${waittime}s for server process to exit."
