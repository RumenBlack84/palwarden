#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
"""palwarden web UI server: static editors, a read-only JSON API, and the job queue.

Runs UNPRIVILEGED on purpose. It executes only read-only tools; anything that
mutates the server is *enqueued* as a job file for the root worker
(palwarden-jobd), so a bug in this HTTP parser cannot restart the game or run
SteamCMD. Writing a job file is the most this process can ever do.

Every path — including the static editors — requires HTTP Basic auth. Basic over
plain HTTP is acceptable only because the listener is loopback-bound and remote
access goes through an SSH tunnel, which supplies the encryption.

Mutations need the shared token in the `X-Palwarden-Token` header on top of
Basic. A browser attaches Basic credentials to a cross-origin POST all by
itself, so Basic alone is not proof of intent; a cross-origin page cannot set a
custom header without a CORS preflight, which we never answer.
Origin/Sec-Fetch-Site are checked as well, which is what catches DNS rebinding
(where Host alone would look legitimate).

The token is *not* a second human factor: our own pages fetch it from
`GET /api/token`, which needs nothing but the same Basic session that served the
page. So anyone who can authenticate can mutate — accepted deliberately, because
the password and the token live in the same 0600 file and go to the same
operator. What the custom header still buys is the CSRF property above, and that
is unaffected by how our page obtains the value.
"""

from __future__ import annotations

import argparse
import base64
import hmac
import http.server
import importlib.machinery
import importlib.util
import ipaddress
import json
import os
import re
import secrets
import socketserver
import subprocess
import sys
import urllib.parse
from pathlib import Path

# Mirror palwarden-jobd: prepend the bare-metal lib dir and the repo's lib/ so
# `palwarden_jobs` resolves in both installed and dev-checkout layouts. Both
# sides of the queue must use the *same* on-disk format implementation.
sys.path.insert(0, "/usr/local/lib")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import palwarden_jobs as jobs  # noqa: E402

WEBUI_ENV = Path(os.environ.get("PALWARDEN_WEBUI_ENV", "/etc/palworld/webui.env"))

WEB_ROOT = Path(os.environ.get("PALWARDEN_WEBUI_ROOT", "/opt/palworld/tools/config-webui"))
BIND = os.environ.get("PALWARDEN_WEBUI_BIND", "127.0.0.1")
PORT = int(os.environ.get("PALWARDEN_WEBUI_PORT", "8088"))
SBIN = Path(os.environ.get("PALWARDEN_SBIN_DIR", "/usr/local/sbin"))
PARSER_BIN = Path(os.environ.get("PALWARDEN_PARSER_BIN", "/usr/local/bin/palworld-config-parser"))
# Deliberately NOT derived from SBIN, for the same reason palwarden-jobd does not
# derive ENGINE_CONFIG_BIN from it: SBIN is where *invoked commands* live (tests
# point it at stub shell scripts, and module-loading a bash script as Python
# raises SyntaxError). The validators we import live next to this script in both
# the installed layout and a dev checkout.
JOBD_BIN = Path(os.environ.get(
    "PALWARDEN_JOBD_BIN", str(Path(__file__).resolve().parent / "palwarden-jobd")))
CONFIG_FILE = Path(os.environ.get(
    "PALWORLD_CONFIG_FILE",
    "/opt/palworld/server/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini"))
# NOTE: PALWORLD_BACKUP_DIR already means *config* backups elsewhere in this repo,
# so world-save backups get their own variable.
SAVE_BACKUP_DIR = Path(os.environ.get("PALWARDEN_SAVE_BACKUP_DIR", "/opt/palworld/backups"))
SNAPSHOT_DIR = Path(os.environ.get("PALWARDEN_SNAPSHOT_DIR", "/opt/palworld/config-snapshots"))

# Keys ep_config replaces with "<redacted>". Read the honest scope of that in
# ep_config and allowed_roots: it is hygiene for diffs, logs and screenshots, not
# an access boundary — an authenticated caller can read the same values verbatim
# from GET /current/PalWorldSettings.ini.
SECRET_KEYS = {"adminpassword", "serverpassword"}
# Windows palworld-fps accepts for `report --window`.
FPS_REPORT_WINDOWS = {"5m", "60m", "24h", "7d"}
WINDOW_RE = re.compile(r"^\d{1,4}[mhd]$")
REALM = "palwarden"

REQUIRED_KEYS = ("WEBUI_USER", "WEBUI_PASSWORD", "WEBUI_TOKEN")

TOKEN_HEADER = "X-Palwarden-Token"
# A client that disappears mid-response is routine (a browser tab closing, curl
# --max-time), not an internal error: it must never produce a traceback, and it
# must never make a response attempt raise a *second* time out of the handler.
# ConnectionError is the whole family (BrokenPipe, ConnectionReset,
# ConnectionAborted): naming the members individually silently omitted
# ConnectionAbortedError, which is what a local stack can raise instead of a
# reset. TimeoutError is the socket timeout below, not a connection error.
CLIENT_GONE = (ConnectionError, TimeoutError)
# 64 KiB is far more than any job body needs (the largest is an engine settings
# object) and small enough that an unauthenticated-shaped flood cannot make this
# process buffer anything interesting.
MAX_BODY_BYTES = 65536
# Reading a request must not block forever: a client that sends a Content-Length
# larger than its body would otherwise pin a worker thread for good. Not an env
# knob on purpose — a typo in a unit file would become a traceback at import,
# and 10s is generous for a loopback listener even over an SSH tunnel.
REQUEST_TIMEOUT = 10.0
# One limit for both "which jobs does GET /api/jobs show" and "which jobs can
# block a disruptive POST with a 409". They must be the same number: a job the
# operator cannot see in the listing must not be able to block them forever
# (palwarden-jobd runs one job at a time regardless, so the 409 is a UI
# nicety — the real serialisation is the worker's single-job loop).
JOBS_LIST_LIMIT = 200


def _escape(val: str) -> str:
    """Escape a value for double-quoted KEY="value" lines (shell-source-safe)."""
    val = val.replace("\\", "\\\\").replace('"', '\\"')
    val = val.replace("$", "\\$").replace("`", "\\`")
    return val


def _unescape(val: str) -> str:
    """Reverse `_escape`: turn \\X escapes back into literal characters."""
    out = []
    i = 0
    while i < len(val):
        ch = val[i]
        if ch == "\\" and i + 1 < len(val):
            out.append(val[i + 1])
            i += 2
        else:
            out.append(ch)
            i += 1
    return "".join(out)


def load_credentials(path: Path = WEBUI_ENV) -> dict[str, str]:
    """Read KEY="value" lines. Exits with a clear message if unusable."""
    if not path.is_file():
        sys.exit(
            f"error: no web UI credentials at {path}. "
            "Run 'palwarden-webui --init-credentials' as root to create them."
        )
    try:
        text = path.read_text(errors="replace")
    except OSError as exc:
        sys.exit(
            f"error: cannot read web UI credentials at {path}: {exc}. "
            "Check file ownership/permissions (expected readable by the service account)."
        )
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] == '"':
            val = _unescape(val[1:-1])
        elif len(val) >= 2 and val[0] == val[-1] and val[0] == "'":
            val = val[1:-1]
        values[key.strip()] = val
    missing = [k for k in REQUIRED_KEYS if not values.get(k)]
    if missing:
        sys.exit(f"error: web UI credentials in {path} are missing: {', '.join(missing)}")
    return values


def init_credentials(path: Path = WEBUI_ENV) -> tuple[dict[str, str], bool]:
    """Create the credential file if absent. Never overwrites an existing one."""
    if path.is_file():
        return load_credentials(path), False
    creds = {
        "WEBUI_USER": os.environ.get("WEBUI_USER") or "admin",
        "WEBUI_PASSWORD": os.environ.get("WEBUI_PASSWORD") or secrets.token_urlsafe(24),
        "WEBUI_TOKEN": os.environ.get("WEBUI_TOKEN") or secrets.token_urlsafe(32),
    }
    for key, val in creds.items():
        if "\n" in val:
            sys.exit(f"error: {key} contains a newline, which cannot be stored safely; "
                      "choose a value without one")

    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(path.name + ".tmp")
    try:
        # Create the file pre-restricted: never let it exist world/group readable,
        # even for the instant between creation and chmod.
        fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_EXCL, 0o600)
    except FileExistsError:
        sys.exit(
            f"error: stale temp file {tmp} already exists. "
            "A previous 'palwarden-webui --init-credentials' run may have been "
            "interrupted; remove it and retry."
        )
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write("".join(f'{k}="{_escape(v)}"\n' for k, v in creds.items()))
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise
    return creds, True


def check_basic(header: str | None, creds: dict[str, str]) -> bool:
    """Validate an HTTP Basic header in constant time."""
    if not header or not header.startswith("Basic "):
        return False
    try:
        decoded = base64.b64decode(header[6:], validate=True).decode("utf-8", "strict")
    except Exception:
        return False
    user, sep, password = decoded.partition(":")
    if not sep:
        return False
    ok_user = hmac.compare_digest(user.encode("utf-8"), creds["WEBUI_USER"].encode("utf-8"))
    ok_pass = hmac.compare_digest(password.encode("utf-8"), creds["WEBUI_PASSWORD"].encode("utf-8"))
    return ok_user and ok_pass


def check_token(headers, creds: dict[str, str]) -> bool:
    """Validate the mutation token in constant time. A missing header is a refusal.

    Requires *exactly one* token header. With two, `get()` would silently pick
    the first and "which one counts" becomes a question the attacker gets to
    answer; refusing outright removes the question.

    Header values arrive latin-1-decoded from http.client, so encoding back to
    bytes cannot fail for anything the wire can carry — but this runs before any
    authorisation decision, so it is wrapped anyway: a TypeError or
    UnicodeError reachable pre-auth would be a vulnerability, not a cosmetic
    bug. Same shape as check_basic.
    """
    values = headers.get_all(TOKEN_HEADER) or []
    if len(values) != 1:
        return False
    try:
        supplied = values[0].strip().encode("utf-8", "strict")
        expected = creds["WEBUI_TOKEN"].encode("utf-8", "strict")
    except Exception:
        return False
    return hmac.compare_digest(supplied, expected)


def origin_host_allowed(origin: str) -> bool:
    """Is this Origin's *host* a loopback name or address?

    This is a same-*machine* check, not a same-origin one, and the difference
    matters. Only the host is compared, never the scheme or port: the documented
    access path is an SSH tunnel, which remaps the port freely
    (`-L 9000:localhost:8088`), so pinning PORT here would reject every real
    browser session.

    What that defeats: DNS rebinding (an attacker name resolving to 127.0.0.1
    still carries its own hostname in Origin, which no rebinding can change) and
    any ordinary cross-site page on a public origin.

    What it does NOT defeat: another local origin. A dev server, a notebook, or
    anything else on 127.0.0.1 that serves attacker-supplied HTML gets an Origin
    this function accepts, and for those the X-Palwarden-Token header is the only
    remaining barrier — which is exactly why the token exists and is required
    independently (a cross-origin page cannot set it without a preflight we never
    answer).

    A non-loopback BIND is deliberately *not* allowed here: it would have to be
    accepted by hostname, and there is no vetted list of those (the removed
    PALWARDEN_WEBUI_ORIGIN_HOSTS knob was an untested relaxation of a security
    control). Consequence if someone sets PALWARDEN_WEBUI_BIND to a routable
    address anyway: reads keep working, but a browser loaded from that address
    sends its own Origin and every mutation is refused with a 403 naming the
    host. That fails closed; the supported remote path is the SSH tunnel.
    """
    try:
        host = urllib.parse.urlsplit(origin.strip()).hostname
    except ValueError:
        return False
    if not host:
        # "null" (an opaque origin: sandboxed iframe, redirect chain) and any
        # unparseable value land here.
        return False
    host = host.lower()
    if host == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def origin_ok(headers) -> bool:
    """Reject a cross-origin mutation on the evidence the browser volunteers.

    `Sec-Fetch-Site` is set by the browser and cannot be spoofed by page script,
    so anything other than `same-origin` is refused — including `none`, which a
    fetch() from our own page never produces. `Origin` is checked separately
    because older browsers omit Sec-Fetch-Site. Both absent means a non-browser
    client (curl, the CLI), which the token already gates.
    """
    for name in ("Sec-Fetch-Site", "Origin"):
        if len(headers.get_all(name) or []) > 1:
            return False  # ambiguous: refuse rather than pick one
    site = headers.get("Sec-Fetch-Site")
    if site is not None and site.strip().lower() != "same-origin":
        return False
    origin = headers.get("Origin")
    if origin is None:
        return True
    return origin_host_allowed(origin)


_JOBD_MODULE = None


def load_jobd_module():
    """Load the root worker's validators instead of writing a second copy.

    The API rejects bad input early and the worker rejects it again (it must not
    trust the queue), but both must agree on what "bad" means — so the rules
    live in exactly one place. Same hyphenated-script trick as
    load_parser_module.

    Note this executes palwarden-jobd's module body, which itself module-loads
    palworld-engine-config for its settings table. If that fails the import
    raises, so callers must turn it into a message rather than a traceback.
    (jobd's module body only defines things — it takes no lock and runs no
    command — so importing it here is inert.)

    Only `ACTIONS` and `validate_params` may be used from the result. The module
    also exposes `run_job`/`write_engine_env`, and calling either from here would
    make the unprivileged web process execute the work it is supposed to hand
    off; that split is the whole security property of the control plane.
    """
    global _JOBD_MODULE
    if _JOBD_MODULE is None:
        loader = importlib.machinery.SourceFileLoader("palwarden_jobd_for_webui", str(JOBD_BIN))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        sys.modules[loader.name] = module
        loader.exec_module(module)
        _JOBD_MODULE = module
    return _JOBD_MODULE


def disruptive_actions(jobd) -> frozenset[str]:
    return frozenset(name for name, spec in jobd.ACTIONS.items() if spec["disruptive"])


def find_blocking_job(actions: frozenset[str]) -> dict | None:
    """The unfinished job of one of `actions` that stands in the way, or None.

    Used instead of `jobs.has_pending`, which answers yes/no over
    `list_jobs(limit=1000)` — a different window from the one GET /api/jobs
    shows. Scanning the *same* JOBS_LIST_LIMIT window here keeps the two
    consistent: anything that can produce a 409 is also something the operator
    can list. The oldest match is returned, since that is the one actually
    holding the queue.
    """
    candidates = [job for job in jobs.list_jobs(limit=JOBS_LIST_LIMIT)
                  if job.get("state") in ("queued", "running")
                  and job.get("action") in actions]
    if not candidates:
        return None
    # list_jobs sorts newest-first; the blocker is the oldest of these.
    return candidates[-1]


def check_jobs_dir() -> str | None:
    """Return None if the queue directory is usable, else why it is not.

    Created 0700 by the store itself (job params carry config values), so this
    only has to confirm the result is ours to write. A wrong owner here is the
    most likely deployment mistake — POST must say so plainly instead of
    tracebacking on the first enqueue.

    Called once, at startup (see Handler.jobs_dir_error), so both messages have
    to tell the operator that fixing the directory is not enough on its own:
    re-checking on every POST would mean a stat per request to detect something
    that only a deployment change can alter.
    """
    try:
        jobs.JOBS_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    except OSError as exc:
        return (f"job queue directory {jobs.JOBS_DIR} cannot be created: {exc.strerror}. "
                "Create it owned by the web UI user, then restart the service "
                "(this is checked once at startup).")
    if not os.access(jobs.JOBS_DIR, os.W_OK | os.X_OK):
        return (f"job queue directory {jobs.JOBS_DIR} is not writable by this process. "
                "Check that it is owned by the web UI user, then restart the service "
                "(this is checked once at startup).")
    return None


def allowed_roots() -> list[Path]:
    """Directories the static server may serve from.

    The web root contains a deliberate `current` symlink into the live config
    directory, so that directory is allowed too — but nothing else is.

    Be clear about what that means: `GET /current/PalWorldSettings.ini` returns the
    live file *verbatim*, AdminPassword and ServerPassword included. Serving it is
    the feature — both editors fetch through `current/` to preload the values they
    are about to edit, and redacting there would leave them editing blanks — so
    **web UI access implies admin-password access**. Anyone who can authenticate to
    this server can read the game's admin password.

    Consequently ep_config's redaction is defence in depth, not a boundary: it
    keeps the secrets out of the JSON that ends up in diffs, service logs, bug
    reports and screenshots. It does not withhold them from the caller, and no
    caller should be granted access on the assumption that it does.

    The separate webui.env credentials exist to limit blast radius in the *other*
    direction: they are not the game's admin password, so someone who has the
    in-game admin password (handed out to trusted players, typed into RCON clients,
    pasted in chat) does not thereby get this HTTP API — which can queue root jobs.
    """
    roots = []
    for candidate in (WEB_ROOT, CONFIG_FILE.parent):
        try:
            roots.append(candidate.resolve())
        except OSError:
            continue
    return roots


def resolve_static(url_path: str) -> Path | None:
    """Map a URL path to a file inside the allowed roots, or None."""
    clean = urllib.parse.unquote(urllib.parse.urlparse(url_path).path)
    if clean in ("", "/"):
        clean = "/palwarden.html"
    candidate = (WEB_ROOT / clean.lstrip("/"))
    try:
        resolved = candidate.resolve()
    except OSError:
        return None
    if not any(resolved == root or root in resolved.parents for root in allowed_roots()):
        return None
    return resolved if resolved.is_file() else None


def run_tool(argv: list[str], timeout: int = 30) -> dict:
    """Run a read-only tool. A failure is data, not an exception."""
    try:
        proc = subprocess.run(argv, text=True, capture_output=True,
                              timeout=timeout, check=False)
    except FileNotFoundError:
        return {"ok": False, "error": f"{argv[0]} is not installed"}
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"{argv[0]} timed out after {timeout}s"}
    except OSError as exc:
        return {"ok": False, "error": f"{argv[0]} failed: {exc}"}
    return {
        "ok": True,
        "returncode": proc.returncode,
        "stdout": proc.stdout,
        "stderr": proc.stderr[:500],
    }


def run_tool_json(argv: list[str], timeout: int = 30) -> dict:
    result = run_tool(argv, timeout)
    if not result["ok"]:
        return result
    try:
        data = json.loads(result["stdout"] or "{}")
    except json.JSONDecodeError as exc:
        if result["returncode"] != 0:
            detail = result["stderr"].strip() or result["stdout"].strip()
            return {"ok": False,
                    "error": f"{argv[0]} exited {result['returncode']}: {detail}"}
        return {"ok": False, "error": f"{argv[0]} returned invalid JSON: {exc}"}
    if result["returncode"] != 0 and not (result["stdout"] or "").strip():
        detail = result["stderr"].strip() or f"exit {result['returncode']}"
        return {"ok": False, "error": f"{argv[0]} exited {result['returncode']}: {detail}"}
    return {"ok": True, "data": data}


def pick_window(query: dict[str, list[str]], default: str = "24h",
                allowed: set[str] | None = None) -> str:
    """Validate a window parameter; never pass an unvetted string to a tool."""
    value = (query.get("window") or query.get("since") or [default])[0]
    if allowed is not None:
        return value if value in allowed else default
    return value if WINDOW_RE.match(value) else default


def load_parser_module():
    """Reuse the config parser's OptionSettings splitter instead of duplicating it.

    palworld-health-report already loads palworld-fps this way.
    """
    loader = importlib.machinery.SourceFileLoader("palwarden_cfg_parser", str(PARSER_BIN))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def ep_health(_query: dict) -> dict:
    return run_tool_json([str(SBIN / "palworld-health-report"), "report", "--json"], 60)


def ep_fps(query: dict) -> dict:
    window = pick_window(query, "24h", FPS_REPORT_WINDOWS)
    return run_tool_json([str(SBIN / "palworld-fps"), "report", "--json",
                          "--no-live", "--window", window])


def ep_events(query: dict) -> dict:
    window = pick_window(query, "24h", FPS_REPORT_WINDOWS)
    return run_tool_json([str(SBIN / "palworld-fps"), "events",
                          "--window", window, "--json"])


def ep_service_events(query: dict) -> dict:
    window = pick_window(query, "24h", FPS_REPORT_WINDOWS)
    return run_tool_json([str(SBIN / "palworld-service-events"), "summary",
                          "--since", window, "--json"])


def ep_engine(_query: dict) -> dict:
    result = run_tool([str(SBIN / "palworld-engine-config"), "status", "--check"])
    if not result["ok"]:
        return result
    return {"ok": True, "drift_ok": result["returncode"] == 0,
            "text": result["stdout"].strip() or result["stderr"].strip()}


def ep_config(_query: dict) -> dict:
    try:
        text = CONFIG_FILE.read_text(errors="replace")
    except OSError as exc:
        return {"ok": False, "error": f"cannot read {CONFIG_FILE}: {exc}"}
    match = re.search(r"^OptionSettings=\((.*)\)[ \t]*$", text, re.MULTILINE)
    if not match:
        return {"ok": False, "error": f"no OptionSettings=(...) line in {CONFIG_FILE}"}
    try:
        split = load_parser_module().split_settings
    except Exception as exc:
        return {"ok": False, "error": f"cannot load the config parser: {exc}"}
    settings: dict[str, str] = {}
    for part in split(match.group(1)):
        key, sep, value = part.partition("=")
        if not sep:
            continue
        key = key.strip()
        value = value.strip()
        if key.lower() in SECRET_KEYS:
            # Hygiene, not a boundary. The same authenticated caller can read these
            # two values in cleartext from GET /current/PalWorldSettings.ini, which
            # allowed_roots serves on purpose so the editors can preload the live
            # file. What this buys is that the passwords do not travel in the JSON
            # blob that gets pasted into diffs, tickets and screenshots. See
            # allowed_roots' docstring for the full statement.
            settings[key] = "<redacted>"
        else:
            settings[key] = value[1:-1] if len(value) >= 2 and value[0] == value[-1] == '"' else value
    return {"ok": True, "data": settings}


def _list_dir(path: Path, limit: int = 50) -> dict:
    if not path.is_dir():
        return {"ok": True, "data": []}
    entries = []
    for item in sorted(path.iterdir(), key=lambda p: p.name, reverse=True)[:limit]:
        try:
            stat = item.stat()
        except OSError:
            continue
        entries.append({"name": item.name, "bytes": stat.st_size,
                        "modified": int(stat.st_mtime)})
    return {"ok": True, "data": entries}


def ep_backups(_query: dict) -> dict:
    return _list_dir(SAVE_BACKUP_DIR)


def ep_snapshots(_query: dict) -> dict:
    return _list_dir(SNAPSHOT_DIR)


READ_ENDPOINTS = {
    "/api/health": ep_health,
    "/api/fps": ep_fps,
    "/api/events": ep_events,
    "/api/service-events": ep_service_events,
    "/api/engine": ep_engine,
    "/api/config": ep_config,
    "/api/backups": ep_backups,
    "/api/snapshots": ep_snapshots,
}


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "palwarden-webui"
    credentials: dict[str, str] = {}
    # Set once at startup so a misconfigured queue is one clear 500 per POST
    # rather than a traceback, and reads keep working regardless.
    jobs_dir_error: str | None = None
    # socketserver applies this to the connection, so a body that never arrives
    # cannot hold a thread forever.
    timeout = REQUEST_TIMEOUT

    # --- helpers ----------------------------------------------------------
    def _send_json(self, status: int, payload: dict,
                   extra_headers: tuple[tuple[str, str], ...] = ()) -> None:
        body = json.dumps(payload, indent=2, sort_keys=True).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for name, value in extra_headers:
            self.send_header(name, value)
        self.end_headers()
        self.wfile.write(body)

    def _send_json_safely(self, status: int, payload: dict) -> None:
        """Send a response we are already on the error path for.

        Used only inside `except` blocks: if the client has gone, a second raise
        here would escape the handler and be logged as a traceback for what is
        really just a closed connection.
        """
        try:
            self._send_json(status, payload)
        except CLIENT_GONE as exc:
            self._note_client_gone("sending an error response", exc)

    def _note_client_gone(self, what: str, exc: BaseException) -> None:
        """Give up on a connection, leaving one line behind.

        Silence here would hide real failures: a TimeoutError raised by endpoint
        code (not by the socket) also lands in these handlers, and without a log
        line the request would end with no response and no trace of why.
        """
        self.close_connection = True
        self.log_message("client gone while %s: %s", what, type(exc).__name__)

    def _challenge(self) -> None:
        # Like _reject: a challenge answers a POST without reading its body, so the
        # socket must close for the same anti-desync reason.
        self.close_connection = True
        body = b"authentication required\n"
        self.send_response(401)
        self.send_header("WWW-Authenticate", f'Basic realm="{REALM}"')
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authenticated(self) -> bool:
        if check_basic(self.headers.get("Authorization"), self.credentials):
            return True
        self._challenge()
        return False

    def _read_body(self) -> tuple[bytes | None, str | None]:
        """Read exactly Content-Length bytes, or explain why we will not.

        Returns (body, error) with exactly one populated. Every rejection here is
        a 400: a missing, duplicated, non-integer, negative or oversized length
        must never become a hang or a traceback. Callers must close the
        connection on a rejection — see `_reject`.
        """
        if self.headers.get("Transfer-Encoding"):
            return None, "chunked transfer encoding is not supported; send Content-Length"
        raw = self.headers.get_all("Content-Length") or []
        if len(raw) != 1:
            return None, "exactly one Content-Length header is required"
        value = raw[0].strip()
        # RFC 9110 allows ASCII digits and nothing else, which is what
        # `isascii() and isdigit()` accepts. `int()` is wrong here twice over: it
        # takes PEP 515 underscores and a leading sign, so "1_0" would parse as
        # 10 and "+5" as 5 — values no HTTP client sends but a smuggling attempt
        # might, aimed at a proxy that framed the request differently. It also
        # accepts non-ASCII digits that `isdigit()` alone would wave through
        # while `int()` rejects, e.g. latin-1 "\xb2" (superscript two).
        # This also subsumes the negative case: "-5" has no digits-only form.
        if not (value.isascii() and value.isdigit()):
            return None, "Content-Length must be a decimal, non-negative integer"
        length = int(value)
        if length > MAX_BODY_BYTES:
            return None, f"request body must be at most {MAX_BODY_BYTES} bytes"
        if length == 0:
            return b"", None
        try:
            body = self.rfile.read(length)
        except OSError as exc:
            # Includes the socket timeout for a body that never fully arrives.
            return None, f"could not read the request body: {exc}"
        if len(body) != length:
            return None, "request body was shorter than Content-Length"
        return body, None

    def _reject(self, status: int, error: str, **extra) -> None:
        """Refuse a request whose body we have not read, and close the socket.

        Anything left in the socket after an unread (or over-cap, or
        wrongly-framed) body would be parsed as the *start of the next request*
        on a kept-alive connection — a request-smuggling desync. Today that
        cannot happen because `protocol_version` is BaseHTTPRequestHandler's
        `HTTP/1.0` default, which closes after every response; this makes the
        rejection paths safe on their own terms so that setting
        `protocol_version = "HTTP/1.1"` stays the one-line change it looks like.
        """
        self.close_connection = True
        self._send_json(status, {"ok": False, "error": error, **extra})

    def _send_token(self) -> None:
        """GET /api/token: hand the mutation token to our own authenticated page.

        Deliberately NOT a READ_ENDPOINTS entry. Those are `(query) -> dict`
        wrappers around read-only tools, dispatched uniformly by do_GET; this one
        reads the already-loaded credentials, needs an Origin gate the other
        reads must not grow, and needs a header they do not send. Adding
        per-endpoint metadata to that table to express two exceptions would be
        more machinery than a branch.

        Why *this* read is Origin-checked when none of the others are: a
        cross-site GET's response body is unreadable to the attacker's page
        anyway (same-origin policy blocks reading it, and we answer no
        preflight), so the other reads need no such check. But this response *is*
        the secret rather than merely being protected by one, and "the browser
        will refuse to show it to them" is a weaker guarantee than "we never sent
        it". A no-cors fetch, a stray extension, a mis-set proxy: all of those
        end with the token on the wire for a request we could simply have
        refused. So it fails closed, reusing the same origin_ok the mutation path
        uses.

        Headers: `Cache-Control: no-store` from _send_json, plus `Pragma:
        no-cache` because this process answers HTTP/1.0 (BaseHTTPRequestHandler's
        default `protocol_version`) and an HTTP/1.0-only intermediary — the SSH
        tunnel is transparent, but people put reverse proxies in front of things
        — may honour only Pragma. No `Vary: Authorization` is needed on top: a
        response with no-store must not be stored at all, so there is no cache
        entry for a second user's credentials to hit. No `X-Content-Type-Options`
        either; the payload is JSON consumed by fetch(), never navigated to as a
        document, so there is no sniffing outcome to prevent.

        Nothing here logs the token: log_message writes only the client address
        and the request line ("GET /api/token"), and the 500 path in do_GET is
        the one error path in this file that reports no exception text, precisely
        because this is the only handler whose locals hold the secret.
        """
        if not origin_ok(self.headers):
            # Named, like the mutation path's refusal, so an operator who bound
            # to a routable address can see why their page cannot save.
            origin = (self.headers.get("Origin") or "").strip()
            detail = f" (Origin {origin!r})" if origin else ""
            self._send_json(403, {"ok": False,
                                  "error": f"cross-origin request refused{detail}"})
            return
        self._send_json(200, {"ok": True, "token": self.credentials["WEBUI_TOKEN"]},
                        extra_headers=(("Pragma", "no-cache"),))

    def _enqueue(self) -> None:
        """POST /api/jobs: validate, then write a job file. Nothing else, ever."""
        # Basic auth is already established by the caller. It is not enough on
        # its own: the browser would attach it to a cross-origin POST for free.
        if not check_token(self.headers, self.credentials):
            self._reject(403, f"missing or invalid {TOKEN_HEADER} header")
            return
        if not origin_ok(self.headers):
            # Name the Origin we refused: with a non-loopback bind (unsupported,
            # but people try it) every mutation fails here, and a bare "refused"
            # gives the operator nothing to correct.
            origin = (self.headers.get("Origin") or "").strip()
            detail = f" (Origin {origin!r})" if origin else ""
            self._reject(403, f"cross-origin request refused{detail}")
            return
        if self.jobs_dir_error:
            self._reject(500, self.jobs_dir_error)
            return
        body, error = self._read_body()
        if error is not None:
            self._reject(400, error)
            return
        try:
            payload = json.loads(body.decode("utf-8"))
        except ValueError:  # covers UnicodeDecodeError and JSONDecodeError
            self._send_json(400, {"ok": False, "error": "body must be UTF-8 JSON"})
            return
        if not isinstance(payload, dict):
            self._send_json(400, {"ok": False, "error": "body must be a JSON object"})
            return
        action = payload.get("action")
        if not isinstance(action, str):
            self._send_json(400, {"ok": False, "error": "action must be a string"})
            return
        params = payload.get("params")
        if params is None:
            params = {}
        if not isinstance(params, dict):
            self._send_json(400, {"ok": False, "error": "params must be an object"})
            return

        try:
            jobd = load_jobd_module()
        except Exception as exc:  # a broken install must not leak a traceback
            self._send_json(500, {"ok": False,
                                  "error": f"cannot load the job validators: {exc}"})
            return
        # validate_params reports an unknown action too, but check first so the
        # 409 lookup below can trust ACTIONS[action].
        if action not in jobd.ACTIONS:
            self._send_json(400, {"ok": False,
                                  "error": f"{action!r} is not an allowed action"})
            return
        normalised, error = jobd.validate_params(action, params)
        if error is not None:
            self._send_json(400, {"ok": False, "error": error})
            return

        # Only disruptive jobs serialise against each other: a queued backup or
        # snapshot must not stand in the way of a restart the operator wants.
        if jobd.ACTIONS[action]["disruptive"]:
            blocker = find_blocking_job(disruptive_actions(jobd))
            if blocker is not None:
                # Identify the blocker inline. Without this the operator can be
                # stuck: if the worker died mid-job the blocker stays `running`
                # forever (reap_orphans only runs when a worker *starts*), and a
                # 409 that says only "something is in the way" leaves nothing to
                # inspect or cancel. The id here is always one GET
                # /api/jobs/<id> away, and JOBS_LIST_LIMIT keeps it in the
                # listing too.
                self._send_json(409, {
                    "ok": False,
                    "error": (f"another disruptive job is queued or running: "
                              f"{blocker['action']} {blocker['id']} "
                              f"({blocker.get('state')}); inspect it at "
                              f"/api/jobs/{blocker['id']}"),
                    "blocked_by": {"id": blocker["id"], "action": blocker["action"],
                                   "state": blocker.get("state")},
                })
                return
        try:
            # Enqueue the *normalised* params, so the worker runs what we vetted
            # rather than the raw request body.
            job = jobs.create_job(action, normalised)
        except OSError as exc:
            self._send_json(500, {"ok": False,
                                  "error": f"cannot write the job file: {exc.strerror}"})
            return
        self._send_json(202, {"ok": True, "id": job["id"]})

    # --- routes -----------------------------------------------------------
    def do_GET(self) -> None:  # noqa: N802 - stdlib naming
        if not self._authenticated():
            return
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path.startswith("/api/"):
            if parsed.path == "/api/token":
                try:
                    self._send_token()
                except CLIENT_GONE as exc:
                    self._note_client_gone("answering the token API", exc)
                except Exception:
                    # No `{exc}` here, unlike every other 500 in this file: the
                    # only secret this handler touches is the token, and an
                    # exception string is the one place it could escape into a
                    # response body or a log line.
                    self._send_json_safely(
                        500, {"ok": False, "error": "internal error"})
                return
            if parsed.path == "/api/jobs" or parsed.path.startswith("/api/jobs/"):
                try:
                    self._send_jobs(parsed.path)
                except CLIENT_GONE as exc:
                    self._note_client_gone("answering the job API", exc)
                except Exception as exc:  # never leak a traceback to the browser
                    self._send_json_safely(
                        500, {"ok": False, "error": f"internal error: {exc}"})
                return
            handler = READ_ENDPOINTS.get(parsed.path)
            if handler is None:
                self._send_json(404, {"ok": False, "error": "unknown endpoint"})
                return
            query = urllib.parse.parse_qs(parsed.query)
            try:
                self._send_json(200, handler(query))
            except CLIENT_GONE as exc:
                self._note_client_gone("answering the read API", exc)
            except Exception as exc:  # never leak a traceback to the browser
                self._send_json_safely(
                    500, {"ok": False, "error": f"internal error: {exc}"})
            return

        target = resolve_static(self.path)
        if target is None:
            self.send_error(404, "not found")
            return
        try:
            data = target.read_bytes()
        except OSError:
            self.send_error(404, "not found")
            return
        ctype = {
            ".html": "text/html; charset=utf-8",
            ".ini": "text/plain; charset=utf-8",
            ".css": "text/css",
            ".js": "application/javascript",
            ".svg": "image/svg+xml",
            ".json": "application/json",
        }.get(target.suffix, "application/octet-stream")
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _send_jobs(self, path: str) -> None:
        if path == "/api/jobs":
            # Same window find_blocking_job uses, so a job that can 409 a
            # request is always visible here.
            self._send_json(200, {"ok": True, "data": jobs.list_jobs(limit=JOBS_LIST_LIMIT)})
            return
        job_id = urllib.parse.unquote(path[len("/api/jobs/"):])
        # read_job returns None for a missing, corrupt or invalidly-named id, so a
        # crafted id can neither traverse nor raise — no pre-validation needed.
        job = jobs.read_job(job_id)
        if job is None:
            self._send_json(404, {"ok": False, "error": "unknown job"})
            return
        self._send_json(200, {"ok": True, "data": job})

    def do_POST(self) -> None:  # noqa: N802
        if not self._authenticated():
            return
        if urllib.parse.urlparse(self.path).path != "/api/jobs":
            self._reject(404, "unknown endpoint")
            return
        try:
            self._enqueue()
        except CLIENT_GONE as exc:
            # The client hung up (or its body never arrived and the socket timed
            # out). There is nobody left to send a status to, and trying would
            # raise a second time straight out of the handler.
            self._note_client_gone("enqueueing a job", exc)
        except Exception as exc:  # never leak a traceback to the browser
            self._send_json_safely(500, {"ok": False, "error": f"internal error: {exc}"})

    # --- logging: request lines only, never headers -----------------------
    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))


class ThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request, client_address) -> None:
        """Keep the log free of tracebacks for hangups and idle timeouts.

        A traceback in the service log should mean "a real bug happened here", so
        the routine ways a connection ends are logged as one line instead. Any
        other exception still gets the full traceback.
        """
        exc = sys.exc_info()[1]
        if isinstance(exc, CLIENT_GONE):
            print(f"{client_address[0]} connection ended early: "
                  f"{type(exc).__name__}", file=sys.stderr)
            return
        super().handle_error(request, client_address)


def make_server(creds: dict[str, str]) -> ThreadingHTTPServer:
    Handler.credentials = creds
    Handler.jobs_dir_error = check_jobs_dir()
    if Handler.jobs_dir_error:
        # A warning, not a fatal error: the read-only dashboard is still useful,
        # and refusing to start would hide the diagnosis behind a dead service.
        print(f"warning: {Handler.jobs_dir_error}", file=sys.stderr)
    return ThreadingHTTPServer((BIND, PORT), Handler)


def main() -> int:
    ap = argparse.ArgumentParser(description="palwarden web UI server")
    ap.add_argument("--init-credentials", action="store_true",
                    help="create /etc/palworld/webui.env if absent, then exit")
    ap.add_argument("--serve", action="store_true", help="run the HTTP server")
    args = ap.parse_args()

    if args.init_credentials:
        creds, created = init_credentials(WEBUI_ENV)
        if created:
            print(f"Created {WEBUI_ENV} with new web UI credentials:")
            for key in REQUIRED_KEYS:
                print(f"  {key}={creds[key]}")
            print("Store these now; they are not printed again.")
        else:
            print(f"{WEBUI_ENV} already exists; leaving it unchanged.")
        return 0

    if args.serve:
        creds = load_credentials(WEBUI_ENV)   # fail closed before binding
        if os.geteuid() == 0:
            sys.exit("error: refusing to run as root; run as the palworld/steam user.")
        # Load the worker's validators up front, for the same reason credentials
        # are loaded up front: a broken install must be a message at startup, not
        # a surprise 500 on the operator's first restart request.
        try:
            load_jobd_module()
        except Exception as exc:
            sys.exit(
                f"error: cannot load the job validators from {JOBD_BIN}: {exc}. "
                "Set PALWARDEN_JOBD_BIN if palwarden-jobd is not installed "
                "alongside this script."
            )
        httpd = make_server(creds)
        print(f"palwarden-webui listening on {BIND}:{PORT} (root {WEB_ROOT})",
              file=sys.stderr)
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            pass
        return 0

    ap.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
