"""Create labeled Palworld config and operational snapshots."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

SNAPSHOT_ROOT = Path("/opt/palworld/config-snapshots")
SERVER_CONFIG_DIR = Path("/opt/palworld/server/Pal/Saved/Config/LinuxServer")
ENGINE_INI = SERVER_CONFIG_DIR / "Engine.ini"
ENGINE_PRETTY = SERVER_CONFIG_DIR / "Engine.pretty.ini"
PAL_SETTINGS = SERVER_CONFIG_DIR / "PalWorldSettings.ini"
PAL_SETTINGS_PRETTY = SERVER_CONFIG_DIR / "PalWorldSettings.pretty.ini"
ENGINE_ENV = Path("/etc/palworld/engine.env")
SETTINGS_ENV = Path("/etc/palworld/settings.env")
MANIFEST = Path("/opt/palworld/server/steamapps/appmanifest_2394010.acf")

SECRET_ENV_RE = re.compile(r"^(\s*(?:ADMIN_PASSWORD|SERVER_PASSWORD|PALWORLD_DISCORD_WEBHOOK|DISCORD_WEBHOOK|.*SECRET.*|.*TOKEN.*|.*PASSWORD.*)\s*=).*$", re.I)


# --- SNAPSHOT_ROOT is root-owned, and nothing here writes by path ------------
# This tool runs as *root* — jobd's `snapshot_create` action, which is not
# disruptive and so needs no `confirm` — into a directory whose name is derived
# entirely from an attacker-chosen label, and it holds that directory open across
# six subprocesses at 30s timeouts each. Seconds of window, not a tight race.
#
# It used to be exploitable both ways. install.sh and the Dockerfile created
# /opt/palworld/config-snapshots owned by the unprivileged *web* account, and this
# module ended with a `chown_tree()` handing each finished snapshot to that
# account. Predict the directory name, wait for root's mkdir, rename the directory
# aside and drop a symlink in its place: root then wrote manifest.json, buildid.txt
# and every command output *through the link* — arbitrary root write — and the
# chown followed it too, so aimed at /etc/shadow or a unit file it was a host
# takeover (chown_tree's per-entry `iterdir()` made it worse: pointed at /etc it
# chowned every entry). `fs.protected_symlinks` does not help: that sysctl only
# covers world-writable *sticky* directories, and this one is 0755 — the same
# reasoning palwarden_jobs._allowed_owner_uids records for the 0700 job queue.
#
# Both halves are gone, and the class with them:
#
#   1. SNAPSHOT_ROOT is root-owned 0755 on both platforms (install.sh,
#      docker/Dockerfile) and no ownership is handed out at all — chown_tree is
#      deleted, not merely unused. Nothing unprivileged has any business writing
#      here: every creator is root (jobd, or a hand-run `sudo
#      palworld-config-snapshot create`), the only unprivileged readers are
#      palwarden-webui's /api/snapshots (`_list_dir`, a stat) and
#      palworld-health-report's `latest_snapshot` (an iterdir), both of which the
#      0755 already covers, and nothing prunes snapshots.
#   2. Even so, the writes no longer *depend* on that ownership. create_snapshot
#      opens the directory it just made with O_DIRECTORY|O_NOFOLLOW and every write
#      goes through that descriptor (see write_into), O_CREAT|O_EXCL|O_NOFOLLOW per
#      file. So the swap cannot redirect anything even where the directory is
#      writable — a rename after the open leaves the descriptor pointing at the
#      inode root actually created. Ownership is the boundary; the descriptor is
#      what makes the code correct without one, and it is what the unit test can
#      actually reproduce.
#
# House patterns this matches: palworld-engine-config's write_new_nofollow,
# palworld-config-pretty's fchown, palwarden_jobs._write.


def now_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def slugify(label: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", label.lower()).strip("-")
    slug = re.sub(r"-+", "-", slug)
    return slug or "snapshot"


def redact_env_text(text: str) -> str:
    lines: list[str] = []
    for line in text.splitlines():
        m = SECRET_ENV_RE.match(line)
        if m:
            prefix = m.group(1)
            quote = '"' if '"' in line.split("=", 1)[1][:1] else '"'
            lines.append(f"{prefix}{quote}<redacted>{quote}")
        else:
            lines.append(line)
    return "\n".join(lines) + ("\n" if text.endswith("\n") else "")


def write_into(dir_fd: int, name: str, data: str) -> os.stat_result:
    """Create `name` inside `dir_fd` and write `data`; return the fstat of what we wrote.

    The one and only way this module puts a file into a snapshot. Everything about
    it is relative to the *descriptor* opened on the directory root created, never
    to a path re-resolved from the root's name:

      * `dir_fd=` means the kernel starts from that inode. A rename of the
        directory, or a symlink swapped in at its name, cannot redirect the write —
        the descriptor still refers to the directory root actually made.
      * `O_CREAT|O_EXCL|O_NOFOLLOW` refuses anything already at `name`, symlink
        included (reported as EEXIST, never ELOOP — the lesson
        palworld-engine-config's write_new_nofollow records).
      * the size and mode recorded in the manifest come from an fstat on that same
        descriptor, so the manifest describes the file we wrote rather than
        whatever a later lookup of the name would find.

    `name` must be a bare file name: a snapshot is flat, and a name with a
    separator would reintroduce path resolution inside the tree.
    """
    if "/" in name or name in ("", ".", ".."):
        raise ValueError(f"snapshot entry must be a bare file name, got {name!r}")

    def opener(path: str, flags: int) -> int:
        return os.open(path, flags | os.O_NOFOLLOW, 0o644, dir_fd=dir_fd)

    with open(name, "x", opener=opener, encoding="utf-8", errors="replace") as fh:
        fh.write(data)
        fh.flush()
        return os.fstat(fh.fileno())


def copy_or_redact(dir_fd: int, src: Path, dest_name: str, redact: bool = False) -> dict[str, Any]:
    item: dict[str, Any] = {"source": str(src), "destination": dest_name,
                            "exists": src.exists(), "redacted": redact}
    if not src.exists():
        return item
    # Read the source by path (it lives in root-owned config directories, not in
    # the snapshot tree) and write the copy through the descriptor. This replaced
    # shutil.copy2: copy2 opens the *destination* by path, which is the write the
    # swap redirected. The mtime copy2 preserved is not reproduced — the manifest
    # already records where each file came from, and a snapshot's own mtimes being
    # its creation time is if anything more useful.
    text = src.read_text(errors="replace")
    if redact:
        text = redact_env_text(text)
    st = write_into(dir_fd, dest_name, text)
    item.update({"bytes": st.st_size, "mode": oct(st.st_mode & 0o777)})
    return item


def run_command(name: str, cmd: list[str], cwd: Path | None = None, timeout: int = 30) -> dict[str, Any]:
    proc = subprocess.run(cmd, cwd=str(cwd) if cwd else None, text=True, capture_output=True, timeout=timeout, check=False)
    output = (proc.stdout or "")
    if proc.stderr:
        output += ("\n" if output else "") + "STDERR:\n" + proc.stderr
    return {"name": name, "command": cmd, "exit_code": proc.returncode, "output": output}


def write_command_output(dir_fd: int, name: str, cmd: list[str], timeout: int = 30) -> dict[str, Any]:
    result = run_command(name, cmd, timeout=timeout)
    st = write_into(dir_fd, name, result["output"])
    result["destination"] = name
    result["bytes"] = st.st_size
    return result


def read_buildid(path: Path = MANIFEST) -> str | None:
    try:
        if not path.exists():
            return None
        text = path.read_text(errors="replace")
    except OSError:
        return None
    for line in text.splitlines():
        if '"buildid"' in line:
            parts = line.split('"')
            if len(parts) >= 4:
                return parts[3]
    return None


def default_files() -> list[tuple[Path, str, bool]]:
    return [
        (ENGINE_INI, "Engine.ini", False),
        (ENGINE_PRETTY, "Engine.pretty.ini", False),
        (PAL_SETTINGS, "PalWorldSettings.ini", False),
        (PAL_SETTINGS_PRETTY, "PalWorldSettings.pretty.ini", False),
        (ENGINE_ENV, "engine.env", False),
        (SETTINGS_ENV, "settings.env.redacted", True),
    ]


def default_commands() -> list[tuple[str, list[str]]]:
    return [
        ("engine-status.txt", ["/usr/local/sbin/palworld-engine-config", "status"]),
        ("fps-report.txt", ["/usr/local/sbin/palworld-fps", "report", "--no-live"]),
        ("fps-report.json", ["/usr/local/sbin/palworld-fps", "report", "--no-live", "--json"]),
        ("events-24h.txt", ["/usr/local/sbin/palworld-fps", "events", "--window", "24h"]),
        ("service-status.txt", ["systemctl", "show", "palworld.service", "-p", "ActiveState", "-p", "SubState", "-p", "MainPID", "-p", "ExecMainStartTimestamp", "-p", "NRestarts", "--no-pager"]),
        ("api-metrics.json", ["/usr/local/sbin/palworld-api", "metrics"]),
    ]


def create_snapshot(
    label: str,
    output_root: Path = SNAPSHOT_ROOT,
    files: list[tuple[Path, str] | tuple[Path, str, bool]] | None = None,
    commands: list[tuple[str, list[str]]] | None = None,
    metadata: dict[str, Any] | None = None,
    mark: bool = True,
) -> Path:
    stamp = now_stamp()
    snapshot_dir = output_root / f"{stamp}-{slugify(label)}"
    suffix = 1
    while snapshot_dir.exists():
        suffix += 1
        snapshot_dir = output_root / f"{stamp}-{slugify(label)}-{suffix}"
    # 0755: world-readable so the unprivileged web UI and health report can list
    # it, but writable only by the (root) creator — see the note above on why
    # nothing here may be handed to a less-privileged account.
    snapshot_dir.mkdir(parents=True, mode=0o755)
    # Pin the directory we just created, immediately, and do every write relative to
    # this descriptor. O_NOFOLLOW so we refuse to pin a symlink that beat us to the
    # name; O_DIRECTORY so we refuse to pin anything that is not a directory. From
    # here on the name `snapshot_dir` is only ever *reported* (in the manifest and
    # on stdout), never re-resolved to write through.
    dir_fd = os.open(snapshot_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        return _fill_snapshot(dir_fd, snapshot_dir, label, files, commands, metadata, mark)
    finally:
        os.close(dir_fd)


def _fill_snapshot(
    dir_fd: int,
    snapshot_dir: Path,
    label: str,
    files: list[tuple[Path, str] | tuple[Path, str, bool]] | None,
    commands: list[tuple[str, list[str]]] | None,
    metadata: dict[str, Any] | None,
    mark: bool,
) -> Path:
    normalized_files: list[tuple[Path, str, bool]] = []
    for item in files if files is not None else default_files():
        if len(item) == 2:  # type: ignore[arg-type]
            src, dest = item  # type: ignore[misc]
            redact = False
        else:
            src, dest, redact = item  # type: ignore[misc]
        normalized_files.append((Path(src), str(dest), bool(redact)))

    manifest: dict[str, Any] = {
        "label": label,
        "created_at_utc": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "snapshot_dir": str(snapshot_dir),
        "metadata": metadata or {},
        "buildid": read_buildid(),
        "files": [],
        "commands": [],
    }

    for src, dest_name, redact in normalized_files:
        manifest["files"].append(copy_or_redact(dir_fd, src, dest_name, redact=redact))

    for name, cmd in commands if commands is not None else default_commands():
        try:
            manifest["commands"].append(write_command_output(dir_fd, name, cmd))
        except Exception as exc:
            manifest["commands"].append({"name": name, "command": cmd, "exit_code": None, "error": str(exc), "destination": name})
            try:
                write_into(dir_fd, name, f"ERROR: {exc}\n")
            except OSError:
                # The command already failed and is recorded in the manifest;
                # failing to write its placeholder must not lose the whole snapshot.
                pass

    write_into(dir_fd, "buildid.txt", f"{manifest.get('buildid') or 'unknown'}\n")
    write_into(dir_fd, "manifest.json", json.dumps(manifest, indent=2, sort_keys=True) + "\n")

    if mark:
        subprocess.run(
            ["/usr/local/sbin/palworld-fps", "mark", "config snapshot created", "--category", "snapshot", "--details", f"label={label}; path={snapshot_dir}"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    return snapshot_dir


def command_create(args: argparse.Namespace) -> int:
    metadata = {"requested_by": "palworld-config-snapshot"}
    path = create_snapshot(args.label, Path(args.output_root), metadata=metadata, mark=not args.no_mark)
    print(f"Snapshot created: {path}")
    print(f"Manifest: {path / 'manifest.json'}")
    return 0


def command_list(args: argparse.Namespace) -> int:
    root = Path(args.output_root)
    if not root.exists():
        print(f"No snapshots found in {root}")
        return 0
    snaps = sorted([p for p in root.iterdir() if p.is_dir()], key=lambda p: p.stat().st_mtime, reverse=True)
    if not snaps:
        print(f"No snapshots found in {root}")
        return 0
    print("Available Palworld config snapshots:")
    for p in snaps[: args.limit]:
        print(f"- {p.name}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--output-root", default=str(SNAPSHOT_ROOT))
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("create", help="create a labeled config snapshot")
    p.add_argument("label")
    p.add_argument("--no-mark", action="store_true", help="do not record an FPS event marker")
    p.set_defaults(func=command_create)
    p = sub.add_parser("list", help="list snapshots")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(func=command_list)
    args = ap.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
