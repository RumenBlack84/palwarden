#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
#
# Manage the Linux immutable bit on PalWorldSettings.ini.
#
# Palworld rewrites its own config when the server shuts down, silently
# reverting managed settings. Locking the file (chattr +i) prevents that;
# palworld-config-apply-env locks it automatically after a successful apply, and
# this command is the manual equivalent (the counterpart to
# `palworld-engine-config lock|unlock` for Engine.ini).
#
# Usage:
#   palworld-config-protect status     # is the file locked?
#   palworld-config-protect lock       # chattr +i
#   palworld-config-protect unlock     # chattr -i
#
# Where the immutable bit is unavailable (a container without e2fsprogs or
# CAP_LINUX_IMMUTABLE) this reports the situation and exits 0 rather than failing.
set -euo pipefail
# shellcheck source=../lib/palworld-fileattr
source /usr/local/lib/palworld-fileattr 2>/dev/null \
  || source "$(dirname "${BASH_SOURCE[0]}")/../lib/palworld-fileattr"

server_dir="${PALWORLD_SERVER_DIR:-/opt/palworld/server}"
config_file="${PALWORLD_CONFIG_FILE:-$server_dir/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini}"

action="${1:-status}"
case "$action" in
  status)
    if [[ ! -e "$config_file" ]]; then
      echo "PalWorldSettings.ini immutable: unknown (file missing: $config_file)"
      exit 0
    fi
    if fileattr_is_immutable "$config_file"; then
      echo "PalWorldSettings.ini immutable: yes ($config_file)"
    else
      echo "PalWorldSettings.ini immutable: no ($config_file)"
    fi
    ;;
  lock)
    fileattr_set_immutable "$config_file" on
    echo "Locked $config_file with chattr +i"
    echo "Note: palworld-config-apply-env unlocks/relocks automatically; use 'unlock' for manual edits."
    ;;
  unlock)
    fileattr_set_immutable "$config_file" off
    echo "Unlocked $config_file with chattr -i"
    ;;
  -h|--help)
    sed -n '5,19p' "$0"
    ;;
  *)
    echo "Usage: $0 {status|lock|unlock}" >&2
    exit 64
    ;;
esac
