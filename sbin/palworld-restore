#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
"""Promote an uploaded world-save archive into the root-owned backups directory.

Runs as root (via `palwarden-jobd`, or by hand). `--import` is the bridge between
two directories with deliberately different ownership:

  * `PALWARDEN_UPLOAD_DIR` is written by `palwarden-webui`, which runs
    unprivileged and is treated as untrusted. Everything in it — names, link
    types, and the *bytes of a file we are already holding open* — is
    attacker-influenced.
  * `PALWARDEN_SAVE_BACKUP_DIR` is root-owned 0755 (see `palworld-backup`), for
    the same reason `palworld-config-snapshot` is: only root writes there, so a
    path root creates in it cannot be pre-empted by a planted symlink.

**The order of the two passes is the security property of this file.** The
obvious order — validate the staged file, then copy it — does not hold, and the
reason is spelled out in `palwarden_archive.extract_archive`'s docstring: reading
through one held descriptor guarantees the *name* cannot be swapped, but nothing
stops the owner of that file rewriting the *inode* in place (`O_WRONLY` without
`O_TRUNC`, or `pwrite`) between our two reads. Pass 2 would then see bytes pass 1
never saw. `O_NOFOLLOW` does not help either: it stops a symlink, not a hardlink
of some file the web user can read.

So this tool **copies first and validates the copy**, where the copy sits in the
backups directory the web process cannot write. At that point "validated" and
"persisted" are the same bytes unconditionally — no window to reason about, and
no dependence on how long a descriptor is held. The pre-validate on the staged
file stays, but only as an *advisory* pass that produces a good error message and
avoids copying obvious junk; it is never the authority.

A consequence worth stating: this makes `--restore`'s own re-validation a genuine
second, independent guarantee rather than the only real one.

`--restore` turns one of those archives back into a running world, and it inherits
the same reasoning one directory further along — see `restore_archive`. The short
version: the backups directory is root-owned so the *name* cannot be substituted,
but `palworld-backup` hands each archive it writes to the service account and
`palwarden-webui` runs as that account, so the *bytes* of any archive in there are
still web-writable. `--restore` therefore copies the chosen archive into a
root-only scratch directory through one descriptor and validates and extracts only
that copy. "Root-only" is *verified*, not assumed — both the directory's owner and
its parent's, see `SCRATCH_DIR` and `_open_scratch_dir` — because the whole scheme
is worth nothing if the scratch directory turns out to be somewhere the web
account can write.

`--restore` also refuses to run at all in `PALWARDEN_MODE=external`, where the
question "is the server running?" has no truthful local answer; see
`_require_answerable_service_state`.
"""

from __future__ import annotations

import argparse
import errno
import grp
import os
import pwd
import secrets
import shutil
import stat
import subprocess
import sys
import time
from collections.abc import Sequence
from pathlib import Path

# Mirror how palwarden-jobd locates palwarden_jobs: prepend the bare-metal lib
# dir and the repo's lib/ so `palwarden_archive` resolves in both the installed
# layout and a dev checkout (tests set PYTHONPATH instead).
sys.path.insert(0, "/usr/local/lib")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import palwarden_archive as archive  # noqa: E402

# Written by palwarden-webui as the unprivileged service account.
UPLOAD_DIR = Path(os.environ.get("PALWARDEN_UPLOAD_DIR", "/var/lib/palworld/uploads"))
# Deliberately the same variable palworld-backup writes to and palwarden-webui
# lists for /api/backups (PALWORLD_BACKUP_DIR already means *config* backups in
# this repo), so one override moves writer, lister and importer together.
BACKUP_DIR = Path(os.environ.get("PALWARDEN_SAVE_BACKUP_DIR", "/opt/palworld/backups"))

# --- --restore only ---------------------------------------------------------

# Where the operational tools live, located exactly as palwarden-jobd locates
# them, so one override moves the queue runner and this tool together (and so the
# suite can point at stubs that log their argv).
SBIN = Path(os.environ.get("PALWARDEN_SBIN_DIR", "/usr/local/sbin"))

# `systemctl` is not one of ours, so it is not under SBIN — and it deliberately is
# not branched on PALWARDEN_CONTAINER either: in the container the `systemctl` on
# PATH is docker/shims/systemctl, which already translates `start`/`is-active` to
# s6. Adding a second translation here would be a second thing to keep in sync
# with the shim. Overridable only so the suite can stub it.
SYSTEMCTL = os.environ.get("PALWARDEN_SYSTEMCTL_BIN") or "systemctl"
# Hardcoded like every other script in this repo (palworld-status,
# palworld-memory-watch, palworld-graceful-restart); the shim maps it to the s6
# service name.
SERVICE_UNIT = "palworld.service"

# Root-owned, mode 0700. The entire integrity argument of --restore rests on this
# being a directory the unprivileged web process cannot write; see
# `_scratch_copy`. Task 8 has the installer and the container entrypoint create
# it, and `_open_scratch_dir` creates it defensively too.
#
# **The parent matters as much as the directory does.** `/var/lib/palworld` — the
# obvious home, next to the uploads directory and the job queue — is created 0755
# owned by the *service account* by both `install.sh` and
# `docker/entrypoint.sh`, so a scratch directory under it sits inside a tree the
# untrusted web process can write. That is not a theoretical problem: the web
# account could pre-create the scratch directory itself (`mkdir(exist_ok=True)`
# succeeds and `fchmod` does not change ownership), or `rename` root's directory
# aside and put its own at the same name at any moment. `/opt/palworld` is the
# root-owned parent this repo already puts `backups` and `config-snapshots` under
# for exactly that reason, so the scratch directory goes there too — and
# `_open_scratch_dir` verifies the directory it opened rather than trusting the
# path to have been created correctly.
SCRATCH_DIR = Path(os.environ.get("PALWARDEN_RESTORE_SCRATCH",
                                  "/opt/palworld/restore-scratch"))

# `embedded` (this container runs the game) or `external` (the game runs
# somewhere else and we only manage it). Unset on bare metal, where systemd
# answers for the unit locally. `--restore` refuses to run in `external` mode; see
# `_require_answerable_service_state`.
PALWARDEN_MODE = (os.environ.get("PALWARDEN_MODE") or "").strip().lower()

# The live world tree, resolved exactly as palworld-backup resolves it — same
# variables, same precedence, and the same `${PALWORLD_SAVED_DIR-...}` semantics
# where a *set but empty* override is honoured while an unset one falls through
# PALWORLD_INSTALL_DIR. Two tools disagreeing about which directory is the world
# would make the safety backup archive a different tree than the one replaced.
_saved = os.environ.get("PALWORLD_SAVED_DIR")
if _saved is None:
    _saved = (os.environ.get("PALWORLD_INSTALL_DIR") or "/opt/palworld/server") + "/Pal/Saved"
SAVED_DIR = Path(_saved)

# Never a hardcoded "palworld": that account does not exist in the container
# (it is `steam` there), which is the bug that left config snapshots root-owned.
# `.get(name, default)` and not `or default`, so an explicitly empty override is
# honoured — it means "leave that half of the ownership alone", matching what
# `chown ":group"` does in the bash tools.
SERVICE_USER = os.environ.get("PALWORLD_USER", "palworld")
SERVICE_GROUP = os.environ.get("PALWORLD_GROUP", "palworld")

# Readiness bound, same default as palworld-graceful-restart's --startup-timeout,
# polled at the same 3s interval. Matched rather than re-chosen: "up" has one
# definition in this repo and it lives in that script.
STARTUP_TIMEOUT = archive.env_int("PALWARDEN_RESTORE_STARTUP_TIMEOUT", 180)
POLL_SECONDS = archive.env_int("PALWARDEN_RESTORE_POLL_SECONDS", 3)

# Ceiling on the compressed size of the archive copied into scratch. Same purpose
# as the import cap, with a sharper justification: the premise of the scratch copy
# is that an archive in the backups directory *is* web-writable, so it can be
# grown without limit, and an unbounded copy would fill the scratch volume —
# /opt/palworld, where the backups themselves and the config snapshots live.
MAX_RESTORE_BYTES = archive.env_int("PALWARDEN_RESTORE_MAX_BYTES", 8 * 1024**3)

# Ceiling on the *compressed* size of a single import. This is not the
# decompression-bomb cap (palwarden_archive owns that, on the uncompressed size);
# it bounds what one promotion can cost in copy time and disk. A real save
# archive is tens to hundreds of MiB.
#
# Named for its own env var (`PALWARDEN_IMPORT_MAX_BYTES`), and deliberately NOT
# `MAX_UPLOAD_BYTES`: palwarden-webui has a local of that name for a *different*
# limit — `PALWARDEN_MAX_UPLOAD_BYTES`, 2 GiB, the cap on the HTTP request body —
# and the shared name has already cost one review cycle a false "doc drift"
# finding. Two caps, two files, two values, two env vars.
#
# Both caps below reuse palwarden_archive's own public env-int reader rather
# than growing a second copy of "positive int or default" with its own bugs —
# the exact helper whose whole purpose is that a malformed override cannot
# lower a ceiling to zero.
MAX_IMPORT_BYTES = archive.env_int("PALWARDEN_IMPORT_MAX_BYTES", 8 * 1024**3)
# Free space required on the backups filesystem *beyond* the archive itself. A
# web process that can fill that volume by uploading is a denial of service
# against palworld-backup, which is the thing the operator will need next. Kept
# modest so a tight volume can still take an import, and overridable for the
# operator who knows their own margins.
FREE_HEADROOM_BYTES = archive.env_int("PALWARDEN_IMPORT_FREE_HEADROOM", 64 * 1024**2)

COPY_CHUNK = 1024 * 1024


def _staged_path(staged: str) -> Path:
    """Resolve a staged upload name inside UPLOAD_DIR, or raise ArchiveError.

    Two checks, in this order, and both before the filesystem is touched at all.

    The separator check comes first and has its own message. `valid_archive_name`
    would also refuse every name containing `/` (its pattern has no separator in
    it), so this guard cannot be reached by any input the pattern accepts — it is
    structurally redundant, which is exactly the shape of check that becomes
    unfalsifiable and then gets deleted by accident. It survives here because it
    states the *intent* ("this is a bare name, never a path") at the top of the
    function where a reader looks for it, and the suite pins its message so a
    regression that drops it is visible. Same pattern as palwarden-jobd's
    validate_backup.
    """
    if not isinstance(staged, str) or "/" in staged or "\\" in staged:
        raise archive.ArchiveError(
            f"staged upload must be a bare file name, got {staged!r}")
    if not archive.valid_archive_name(staged):
        raise archive.ArchiveError(
            f"{staged!r} is not a name palworld-backup could have written; refused")
    return UPLOAD_DIR / staged


def _open_staged(path: Path) -> int:
    """Open the staged archive for reading, or raise ArchiveError.

    The explicit `is_symlink` refusal is not redundant with `open_archive_fd`'s
    `O_NOFOLLOW`, which would also refuse this — it is the difference between
    naming the actual problem and surfacing an ELOOP from a syscall three layers
    down, in a directory where a symlink is the *expected* attack (the web user
    owns it and can point at anything root can read). `is_symlink` uses lstat, so
    it decides on the entry itself rather than following it.

    Everything else about the file — regular vs FIFO vs directory, and the
    non-blocking open that stops a planted FIFO hanging this root process — is
    open_archive_fd's job, and is not re-implemented here.
    """
    if path.is_symlink():
        raise archive.ArchiveError(f"staged upload must not be a symlink: {path}")
    return archive.open_archive_fd(path)


def _check_capacity(fd: int) -> int:
    """Refuse the promotion before copying if it will not fit. Returns the size.

    `statvfs` on the destination directory, not the source: the two can be
    different filesystems (a container volume for uploads, another for backups),
    and it is the backups volume that must survive this.
    """
    size = os.fstat(fd).st_size
    if size > MAX_IMPORT_BYTES:
        raise archive.ArchiveError(
            f"staged upload is {size} bytes, over the {MAX_IMPORT_BYTES}-byte "
            f"import limit; refused")
    try:
        st = os.statvfs(BACKUP_DIR)
    except OSError as exc:
        raise archive.ArchiveError(
            f"cannot check free space on {BACKUP_DIR}: {exc}") from exc
    # f_bavail, not f_bfree: the blocks available to *this* caller after any
    # reserved-block margin.
    available = st.f_bavail * st.f_frsize
    needed = size + FREE_HEADROOM_BYTES
    if available < needed:
        raise archive.ArchiveError(
            f"{BACKUP_DIR} has {available} bytes free space, need {needed} "
            f"({size} for the archive plus {FREE_HEADROOM_BYTES} headroom); refused")
    return size


def _pre_validate(fd: int, path: Path) -> dict:
    """Advisory validation of the staged bytes. Raises ArchiveError.

    Advisory, and only advisory: whatever this pass sees can be replaced before
    the copy below reads the same inode. Its value is that an obviously bad
    upload is refused without spending a copy on it, and that the operator's
    error message names the member rather than appearing after a successful-looking
    copy.

    Runs on a `dup` of the descriptor we already hold rather than re-opening
    `path`, so the advisory pass at least cannot be pointed at a *different file*
    than the one being promoted. `dup` shares the file offset, hence the explicit
    rewind in `_copy_fd_to_temp`.

    Calls palwarden_archive's `validate_archive_fileobj` directly rather than
    `validate_archive`, because that entry point takes a path and opens it
    itself; there is no other public door taking a descriptor, and
    `/proc/self/fd/N` is a symlink so `open_archive_fd` refuses it by design.
    Re-opening the name here was the alternative and is precisely what this
    file exists not to do. Safe only because `fd` traces back to
    `open_archive_fd` via `_open_staged` — see that function's docstring on the
    obligation this now-public helper puts on its caller.
    """
    fh = os.fdopen(os.dup(fd), "rb")
    with fh:
        return archive.validate_archive_fileobj(
            fh, path, max_members=archive.MAX_MEMBERS,
            max_bytes=archive.MAX_UNCOMPRESSED_BYTES)


def _temp_path(name: str) -> Path:
    """An unguessable temp name for the in-progress copy, inside BACKUP_DIR.

    Dot-prefixed so it reads as scaffolding rather than a backup, and carrying
    8 bytes of entropy so two concurrent promotions of the same archive cannot
    collide on it. The entropy is not a security control here — BACKUP_DIR is
    root-owned, so nothing unprivileged can plant at a predictable name in it —
    which is why O_EXCL below is what actually refuses an occupied name.
    """
    return BACKUP_DIR / f".{name}.import.{secrets.token_hex(8)}"


def _copy_fd_to_temp(fd: int, tmp_path: Path, cap: int) -> int:
    """Copy from `fd` into a freshly created `tmp_path`. Returns bytes copied.

    Never re-opens the source by name: the bytes come from the descriptor
    `_open_staged` returned, which is why this takes an fd and not a path.

    The destination is `O_CREAT|O_EXCL|O_WRONLY|O_NOFOLLOW` at 0644. O_EXCL is
    what makes an occupied temp name a refusal instead of a silent overwrite;
    O_NOFOLLOW is defence in depth behind it (O_EXCL already fails on a symlink,
    even a dangling one) and costs nothing. `fchmod` on the descriptor makes the
    mode independent of the caller's umask — the web UI has to be able to list
    and the operator to download what lands here.

    The copy is an explicit bounded loop rather than `shutil.copyfileobj`: the
    cap has to be enforced *while* copying, not from the `fstat` size taken
    earlier, because the web process can grow the staged file after that stat.
    copyfileobj cannot express that without a wrapper file object, which is more
    indirection than the six lines it would save.

    Cleanup of a partial copy lives *here*, not in the caller, because here is
    the only place that knows whether the temp file was created at all. A caller
    that unlinked `tmp_path` on any failure would delete the file whose existence
    O_EXCL just refused to overwrite — which is not ours to remove, and turns a
    clean refusal into destruction of whatever was in the way.
    """
    # The advisory pass read to EOF through a dup'd (offset-sharing) descriptor,
    # so rewind before copying.
    os.lseek(fd, 0, os.SEEK_SET)
    # Failing here means nothing was created, so there is nothing to clean up —
    # and in particular whatever is already at `tmp_path` stays exactly as it is.
    try:
        dst_fd = os.open(tmp_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o644)
    except OSError as exc:
        raise archive.ArchiveError(
            f"cannot create the import temp file {tmp_path}: {exc}") from exc
    copied = 0
    try:
        try:
            os.fchmod(dst_fd, 0o644)
            dst = os.fdopen(dst_fd, "wb")  # fdopen takes ownership of the fd
        except BaseException:
            os.close(dst_fd)
            raise
        with dst:
            while True:
                chunk = os.read(fd, COPY_CHUNK)
                if not chunk:
                    break
                copied += len(chunk)
                if copied > cap:
                    raise archive.ArchiveError(
                        f"staged upload exceeded the {cap}-byte import limit while "
                        f"copying; refused")
                dst.write(chunk)
    except BaseException:
        _unlink_quietly(tmp_path)
        raise
    return copied


def _unlink_quietly(path: Path) -> None:
    """Remove a path we created, tolerating its absence. Used on the failure path.

    A refused promotion must leave *nothing* in the backups directory: the web UI
    lists that directory verbatim, and `--restore` will read from it, so a
    half-copied or rejected archive left behind would be offered to the operator
    as if it were a real backup.
    """
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    except OSError as exc:
        # Report it rather than masking the original refusal with a second error.
        print(f"palworld-restore: warning: cannot remove {path}: {exc}", file=sys.stderr)


def import_staged(staged: str) -> Path:
    """Promote `staged` from UPLOAD_DIR into BACKUP_DIR. Raises ArchiveError.

    Returns the promoted path. The staged file is removed only on success; a
    refusal leaves it in place so the operator can inspect or retry it rather
    than watching a bad upload vanish with no artefact.
    """
    path = _staged_path(staged)
    # 0755 root-owned, exactly as palworld-backup creates it — needed here too so
    # a first-ever import into a fresh volume works, and so statvfs has something
    # to stat.
    BACKUP_DIR.mkdir(parents=True, exist_ok=True, mode=0o755)
    fd = _open_staged(path)
    try:
        size = _check_capacity(fd)
        _pre_validate(fd, path)  # advisory only; see the docstring
        tmp = _temp_path(path.name)
        # Outside the try below on purpose: _copy_fd_to_temp cleans up its own
        # partial output, and if it failed to *create* the temp at all (O_EXCL on
        # something already at that name) then that file is not ours to remove.
        #
        # Bounded by `size`, the size the free-space decision above was actually
        # made on, not by MAX_IMPORT_BYTES: the staging file is web-writable, so
        # a stat taken before the copy can grow stale, and licensing the copy up
        # to the (much larger) ceiling would let exactly that growth write past
        # the space statvfs approved — the same in-place-growth primitive the
        # capacity check exists to defend against, just moved a few lines later.
        _copy_fd_to_temp(fd, tmp, min(MAX_IMPORT_BYTES, size))
        try:
            # THE authoritative check. `tmp` is in a directory the web process
            # cannot write, so from here "what was validated" and "what is on
            # disk" are the same bytes, with no window in between.
            archive.validate_archive(tmp)
            # The destination name is built from `path.name`, which
            # valid_archive_name has already proved is a bare
            # `palworld-save-<stamp>.tar.gz` — never from anything else the
            # client supplied, and never from a name read back off disk.
            final = BACKUP_DIR / path.name
            # link()+unlink(), not rename(): rename silently replaces the
            # destination, and clobbering an existing backup is the one mistake
            # a restore tool must not make. link() fails EEXIST atomically, with
            # no check-then-use gap between "does it exist" and "put it there".
            try:
                os.link(tmp, final)
            except FileExistsError as exc:
                raise archive.ArchiveError(
                    f"{final} already exists; refusing to overwrite an existing "
                    f"backup") from exc
            except OSError as exc:
                raise archive.ArchiveError(
                    f"cannot place the imported archive at {final}: {exc}") from exc
        except BaseException:
            _unlink_quietly(tmp)
            raise
        # The archive is now at its final name; the temp link is surplus. Unlike
        # the failure path above, a failure *here* leaves a second, fully valid
        # hardlink to the promoted archive sitting in the backups directory
        # forever — indistinguishable from a real backup to anything that lists
        # the directory (GET /api/backups included) — so the warning names it
        # explicitly rather than folding it into _unlink_quietly's generic text.
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        except OSError as exc:
            print(f"palworld-restore: warning: promoted {final} but the surplus "
                  f"temp link {tmp} could not be removed and needs manual "
                  f"removal: {exc}", file=sys.stderr)
    finally:
        os.close(fd)
    # Only now is the upload disposable. Not fatal if it cannot be removed: the
    # backup is safely promoted, and a stuck staging file is an operator nuisance
    # rather than a reason to report failure.
    try:
        os.unlink(path)
    except OSError as exc:
        print(f"palworld-restore: warning: promoted {final} but cannot remove "
              f"the staged copy {path}: {exc}", file=sys.stderr)
    return final


# ---------------------------------------------------------------------------
# --restore
# ---------------------------------------------------------------------------


def _backup_path(name: str) -> Path:
    """Resolve a backup name inside BACKUP_DIR, or raise ArchiveError.

    Same two checks as `_staged_path`, in the same order and for the same
    reasons — the separator guard states the intent where a reader looks for it
    and the pattern is what actually decides. Deliberately a second, tiny
    function rather than a shared one parameterised by directory: the two
    messages name different directories and the suites pin them separately, and
    the parameterised version reads worse than the four lines it saves.
    """
    if not isinstance(name, str) or "/" in name or "\\" in name:
        raise archive.ArchiveError(
            f"backup must be a bare file name, got {name!r}")
    if not archive.valid_archive_name(name):
        raise archive.ArchiveError(
            f"{name!r} is not a name palworld-backup could have written; refused")
    return BACKUP_DIR / name


def _run(argv: list[str], echo: bool = False) -> tuple[int, str]:
    """Run a fixed argv list; return (exit code, stdout). Never a shell.

    A list, `shell=False`, and no parameter ever interpolated into a command
    string — the operator-supplied backup name never reaches any of these
    commands in the first place, but the rule holds regardless.

    stderr is inherited rather than captured, so a sub-tool's diagnostics reach
    the job log in the order they happened instead of being buffered and
    re-emitted out of sequence. `echo` mirrors stdout for the tools whose output
    the operator wants to see (the backup, the stop); the readiness poll leaves
    it off because it can run dozens of times.
    """
    sys.stdout.flush()
    try:
        proc = subprocess.run(argv, stdout=subprocess.PIPE, text=True, check=False)
    except OSError as exc:
        raise archive.ArchiveError(f"cannot run {argv[0]}: {exc}") from exc
    out = proc.stdout or ""
    if echo and out:
        sys.stdout.write(out)
        sys.stdout.flush()
    return proc.returncode, out


def _within(parent: Path, child: Path) -> bool:
    """True when `child` resolves to something strictly under `parent`.

    realpath on both sides, so a symlinked scratch or backups directory is judged
    on where it actually lands rather than on how it was spelled.
    """
    try:
        p = os.path.realpath(parent)
        c = os.path.realpath(child)
        return c != p and os.path.commonpath([p, c]) == p
    except (OSError, ValueError):
        return False


def _at(dfd: int, name: str) -> str:
    """A path that reaches `name` *through* the directory descriptor `dfd`.

    Every read of the scratch copy goes through one of these rather than through
    `SCRATCH_DIR / name`, and the difference is not cosmetic. A path spelled from
    the root resolves `restore-scratch` afresh on each use, so whoever can write
    the *parent* can `rename` the verified directory aside between two uses and be
    read from instead. `/proc/self/fd/<dfd>/<name>` resolves the directory from
    the descriptor `_open_scratch_dir` already fstat'd, so the directory half of
    the lookup is pinned for the life of the restore.

    The alternative — `dir_fd=` on every call — is not available: the two doors
    into `palwarden_archive` that this file must use (`validate_archive_fileobj`
    via `open_archive_fd`, and `extract_archive`) take a path, and teaching them
    `dir_fd` is a change to a module two other tools share. `O_NOFOLLOW` still
    does its job through this spelling, because it constrains the *final*
    component only, and that component is the ordinary file we created.

    /proc is required for this, which costs nothing anywhere palwarden runs: the
    container mounts it (s6 does not start without it) and `palworld-status`,
    `palworld-memory-watch` and every `pgrep` in the repo already depend on it.
    `_open_scratch_dir` proves it works rather than assuming it.
    """
    return f"/proc/self/fd/{dfd}/{name}"


def _open_scratch_dir() -> int:
    """Open SCRATCH_DIR as a root-only directory, creating it. Returns a dir fd.

    Task 8 has the installer and the container entrypoint create this 0700
    root-owned. It is created here too so a restore on a host that predates that
    — or on a fresh volume — is not what discovers the omission, which would be
    the one moment the tool exists for.

    O_NOFOLLOW because a symlink at this name would relocate the single directory
    the integrity argument below depends on, and `fchmod` on the descriptor we
    then use rather than `chmod` on the name so a directory left group-writable
    by an earlier install is tightened with no check-then-use gap in between.

    **Creating it is not the same as it being ours.** `mkdir(exist_ok=True)`
    succeeds on a directory that was already there, `O_DIRECTORY|O_NOFOLLOW`
    succeeds on it too (it is a real directory), and `fchmod` sets the *mode*
    without touching the *owner* — so a scratch directory pre-created by the
    untrusted web account would come out of all three steps looking perfect while
    still being fully writable by that account, which is precisely the property
    the rest of this file rests on not being true. So the owner is checked on the
    descriptor we are going to use, with its own message: this is the check whose
    removal turns the whole scratch scheme back into decoration.

    The owner has to be *us* rather than a literal uid 0. In production the two
    are the same thing (this tool runs as root under palwarden-jobd), and writing
    `geteuid()` is what lets the suite exercise the refusal unprivileged instead
    of leaving the most important check in the file untested.
    """
    try:
        SCRATCH_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    except OSError as exc:
        raise archive.ArchiveError(
            f"cannot create the restore scratch directory {SCRATCH_DIR}: {exc}") from exc
    try:
        dfd = os.open(SCRATCH_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise archive.ArchiveError(
            f"cannot open the restore scratch directory {SCRATCH_DIR}: {exc}") from exc
    try:
        me = os.geteuid()
        owner = os.fstat(dfd).st_uid
        if owner != me:
            raise archive.ArchiveError(
                f"the restore scratch directory {SCRATCH_DIR} is owned by uid "
                f"{owner}, not by uid {me} that this tool runs as; refusing to "
                f"stage a restore in a directory another account can rewrite")
        # mkdir's mode is masked by the umask, so this is also what actually
        # guarantees 0700 on the directory we just created — and it is what
        # tightens one an older install left group-readable.
        os.fchmod(dfd, 0o700)
        # A postcondition, not a second opinion: it is what notices an fchmod that
        # reported success without taking effect, and what fails loudly if the
        # tighten above is ever dropped or moved after the first read.
        mode = stat.S_IMODE(os.fstat(dfd).st_mode)
        if mode & 0o077:
            raise archive.ArchiveError(
                f"the restore scratch directory {SCRATCH_DIR} is still mode "
                f"{mode:04o} after being tightened; refusing to stage a restore "
                f"in a directory other accounts can read or write")
        # The directory being ours and 0700 is not enough on its own: write
        # permission on any *parent* lets another account rename this directory
        # aside and put its own at the same name. That is exactly how the default
        # under /var/lib/palworld was unsound (the service account owns that tree),
        # so verify the whole chain rather than trusting the default path to be the
        # right one. _check_scratch_identity narrows the residual race; this is what
        # stops it being reachable at all.
        _refuse_writable_parents(SCRATCH_DIR)
        # Prove the descriptor-relative spelling every later read uses actually
        # resolves, here, where the failure is a clean refusal — rather than
        # halfway through a restore as a mystery ENOENT.
        os.stat(_at(dfd, "."))
    except OSError as exc:
        os.close(dfd)
        raise archive.ArchiveError(
            f"cannot secure the restore scratch directory {SCRATCH_DIR}: {exc}") from exc
    except BaseException:
        os.close(dfd)
        raise
    return dfd


def _refuse_writable_parents(path: Path) -> None:
    """Refuse if any ancestor of `path` is writable by an account other than ours.

    Raises ArchiveError naming the offending component. Symlinked ancestors are
    resolved first, because it is the *real* directory whose permissions decide who
    can rename our scratch dir out from under us.
    """
    me = os.geteuid()
    for parent in Path(os.path.realpath(path)).parents:
        try:
            st = os.stat(parent)
        except OSError as exc:
            raise archive.ArchiveError(
                f"cannot check the restore scratch parent {parent}: {exc}") from exc
        # Sticky directories (/tmp) are excluded from the group/other-write test:
        # the sticky bit is precisely what stops one account renaming another's
        # entry, which is the attack this loop exists to prevent.
        sticky = bool(st.st_mode & stat.S_ISVTX)
        if st.st_uid != me and st.st_uid != 0:
            raise archive.ArchiveError(
                f"the restore scratch parent {parent} is owned by uid {st.st_uid}, "
                f"which could rename the scratch directory aside; refusing")
        if not sticky and st.st_mode & 0o022:
            raise archive.ArchiveError(
                f"the restore scratch parent {parent} is mode "
                f"{stat.S_IMODE(st.st_mode):04o} and so is writable by other "
                f"accounts, which could rename the scratch directory aside; refusing")


def _scratch_copy(src: Path, dfd: int) -> Path:
    """Copy `src` into the root-only scratch directory. Returns the copy's path.

    **This is the security core of --restore, not belt-and-braces.** Two
    guarantees are in play and they come from two different mechanisms:

      * The archive's *name* is guaranteed by BACKUP_DIR being root-owned 0755
        (see palworld-backup): nothing unprivileged can substitute the directory
        entry root opens.
      * The archive's *bytes* are guaranteed only by this copy. palworld-backup
        chowns every archive it writes to PALWORLD_USER:PALWORLD_GROUP and
        palwarden-webui runs as exactly that account, so every archive in the
        backups directory is writable by the untrusted web process *today*. A
        web-owned file can be rewritten in place (O_WRONLY without O_TRUNC, or
        pwrite) between any two reads: holding a descriptor defeats a rename, it
        does not defeat a write. Validating in place would therefore guarantee
        the name and not the bytes — the same unsoundness `--import` was
        reordered to avoid, and exactly what
        `palwarden_archive.extract_archive`'s docstring puts on its caller.

    That settles the ownership question in one place rather than two:
    palworld-backup's chown *stays*, because it is what lets an operator rotate
    and copy backups off the host without sudo, and integrity comes from this
    copy instead.

    The bytes come from the descriptor `open_archive_fd` returned and the source
    name is never re-opened — no `shutil.copy(path, ...)`, nothing that resolves
    `src` a second time. After this function returns, BACKUP_DIR is never touched
    again by a restore. `tests/unit/test_restore_apply.sh`'s `swapdir` harness is
    what holds that to a behaviour rather than a docstring: it renames a different
    archive over `src`'s directory entry while our descriptor is open, so a copy
    that resolved the name a second time would land the other archive.

    `dfd` is the caller's verified scratch-directory descriptor, held open for the
    whole restore, so the destination is created in the directory that was
    checked and not merely at a path that spells the same thing.
    """
    fd = archive.open_archive_fd(src)
    try:
        # Dot-prefixed and carrying entropy for the same reason the import
        # temp name does: two concurrent restores of the same archive must
        # not collide. O_EXCL below is what refuses an occupied name.
        tmp_name = f".{src.name}.restore.{secrets.token_hex(8)}"
        tmp_path = SCRATCH_DIR / tmp_name
        try:
            dst_fd = os.open(tmp_name,
                             os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW,
                             0o600, dir_fd=dfd)
        except OSError as exc:
            raise archive.ArchiveError(
                f"cannot create the restore scratch copy {tmp_path}: {exc}") from exc
        copied = 0
        try:
            # fchmod on the held descriptor, not chmod on the name: 0600 makes the
            # copy unreadable to the service account regardless of umask, so even
            # reading the bytes root is about to trust is not something the web
            # process can do.
            try:
                os.fchmod(dst_fd, 0o600)
                dst = os.fdopen(dst_fd, "wb")  # fdopen takes ownership of the fd
            except BaseException:
                os.close(dst_fd)
                raise
            with dst:
                while True:
                    chunk = os.read(fd, COPY_CHUNK)
                    if not chunk:
                        break
                    copied += len(chunk)
                    if copied > MAX_RESTORE_BYTES:
                        raise archive.ArchiveError(
                            f"{src.name} exceeded the {MAX_RESTORE_BYTES}-byte "
                            f"restore limit while copying; refused")
                    dst.write(chunk)
        except BaseException:
            _unlink_quietly_at(dfd, tmp_name, tmp_path)
            raise
    finally:
        os.close(fd)
    return tmp_path


def _unlink_quietly_at(dfd: int, name: str, display: Path) -> None:
    """`_unlink_quietly` for a name inside the scratch directory descriptor.

    Removal goes through `dfd` for the same reason every read does: the name must
    be removed from the directory that was verified, not from whatever is at that
    path by the time the cleanup runs. `display` is only ever used in the message.
    """
    try:
        os.unlink(name, dir_fd=dfd)
    except FileNotFoundError:
        pass
    except OSError as exc:
        print(f"palworld-restore: warning: cannot remove {display}: {exc}",
              file=sys.stderr)


def _validate_scratch(scratch: Path, dfd: int) -> tuple[dict, tuple[int, int]]:
    """THE authoritative validation — and it must be of the scratch copy.

    Returns `(info, ident)`, where `ident` is the `(st_dev, st_ino)` of the inode
    these bytes were actually read from, obtained by `fstat` on the descriptor the
    validation ran over rather than by a separate `stat` of the name. That is what
    lets `_check_scratch_identity` say, before the extraction, "the file about to
    be unpacked is the file that was validated" — not "a file with the same name
    is there".

    The two guards are not decoration. They are what makes "restore validates the
    copy, never the web-writable original" a property of the code rather than of
    a reader's memory: a scratch directory misconfigured to sit inside the
    backups directory would silently return --restore to validating a
    web-writable file with every other line of this file unchanged. Both are
    reachable by configuration alone, so both are falsifiable and the suite
    pins each message. They judge `scratch` — the path as spelled, which is what
    an operator sees and what a misconfiguration gets wrong — while the read goes
    through `_at(dfd, ...)`.

    `validate_archive_fileobj` and not `validate_archive`, for the reason
    `_pre_validate` gives: `validate_archive` takes a path and opens it itself, so
    there would be no descriptor left to `fstat`. The fd-safety obligation that
    entry point documents is met the only way it can be — the descriptor comes
    straight from `open_archive_fd`, which is what refuses a symlink or a FIFO.
    """
    if not _within(SCRATCH_DIR, scratch):
        raise archive.ArchiveError(
            f"refusing to validate {scratch}: it is not inside the restore "
            f"scratch directory {SCRATCH_DIR}")
    if _within(BACKUP_DIR, scratch):
        raise archive.ArchiveError(
            f"refusing to validate {scratch}: the restore scratch directory "
            f"{SCRATCH_DIR} is inside the backups directory {BACKUP_DIR}, whose "
            f"archives the unprivileged web process can rewrite")
    fd = archive.open_archive_fd(_at(dfd, scratch.name))
    try:
        st = os.fstat(fd)
        fh = os.fdopen(fd, "rb")
    except OSError as exc:
        os.close(fd)
        raise archive.ArchiveError(f"cannot read {scratch}: {exc}") from exc
    except BaseException:
        os.close(fd)
        raise
    with fh:
        info = archive.validate_archive_fileobj(
            fh, scratch, max_members=archive.MAX_MEMBERS,
            max_bytes=archive.MAX_UNCOMPRESSED_BYTES)
    return info, (st.st_dev, st.st_ino)


def _check_scratch_identity(scratch: Path, dfd: int,
                            ident: tuple[int, int]) -> None:
    """Refuse if the scratch copy is no longer the inode that was validated.

    `extract_archive` re-opens by name, so validation and extraction are two
    lookups of the same directory entry. Holding `dfd` pins the *directory* half
    of that lookup; this pins the *file* half. Without it, anything that can
    write the scratch directory — which is meant to be nobody, but "meant to be"
    is what the check is for — can `unlink` the validated copy between the two
    passes and drop a different, individually valid archive at the same name, and
    the restore unpacks bytes no pass ever checked while reporting success. A
    reviewer did exactly that.

    It is a check and not a structural guarantee because there is no door into
    `palwarden_archive` that extracts from a descriptor; making one is a change to
    a module `--import` and the web handler also use. What it does buy is that the
    window is no longer silent: the mismatch is a refusal *before* the world is
    touched, which is the only ordering that matters here.
    """
    try:
        st = os.stat(scratch.name, dir_fd=dfd)
    except OSError as exc:
        raise archive.ArchiveError(
            f"the restore scratch copy {scratch} became unreadable after it was "
            f"validated ({exc}); refusing to extract") from exc
    if (st.st_dev, st.st_ino) != ident:
        raise archive.ArchiveError(
            f"the restore scratch copy {scratch} was replaced between validation "
            f"and extraction (it is no longer the inode that was checked); "
            f"refusing to extract bytes that were never validated")


def _open_staging_dir(new_tree: Path) -> int:
    """Open the just-created staging tree and pin it. Returns a dir fd.

    The scratch-copy scheme pins the *archive* root is about to trust. This pins
    the other half — the *destination* root is about to write — and it is needed
    for the same reason, one directory over: `SAVED_DIR.parent` (`.../Pal`) is
    owned by the service account, and `palwarden-webui` runs as that account. So
    the account we are defending against can `rename` the directory `os.mkdir`
    just created aside and drop a symlink at the same name, at any moment between
    the mkdir and the extraction. `extract_archive` resolves its destination path
    when it extracts, so it would follow that link and unpack the archive
    wherever the link points, as root.

    `O_DIRECTORY|O_NOFOLLOW` refuses a name that is already a link, and `fstat`
    on the descriptor is what proves the thing we opened is the directory we made
    (ours, and a real directory) rather than something that merely answered to the
    name. Every write then goes through `/proc/self/fd/<tfd>/` — see `_at` — so
    the destination cannot be re-resolved after this point.
    """
    try:
        tfd = os.open(new_tree, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise archive.ArchiveError(
            f"cannot open the staging tree {new_tree}: {exc}") from exc
    try:
        st = os.fstat(tfd)
        me = os.geteuid()
        if not stat.S_ISDIR(st.st_mode):
            raise archive.ArchiveError(
                f"the staging tree {new_tree} is not a directory; refusing to "
                f"extract into it")
        if st.st_uid != me:
            raise archive.ArchiveError(
                f"the staging tree {new_tree} is owned by uid {st.st_uid}, not by "
                f"uid {me} that this tool runs as; refusing to extract a world "
                f"into a directory another account can rewrite")
        # Prove the descriptor-relative spelling the extraction uses resolves,
        # here, where the failure is a clean refusal — same reason
        # `_open_scratch_dir` does it for the read side.
        os.stat(_at(tfd, "."))
    except OSError as exc:
        os.close(tfd)
        raise archive.ArchiveError(
            f"cannot secure the staging tree {new_tree}: {exc}") from exc
    except BaseException:
        os.close(tfd)
        raise
    return tfd


def _check_staging_identity(new_tree: Path, tfd: int) -> None:
    """Refuse if `new_tree` no longer names the directory we extracted into.

    The extraction is pinned to the descriptor, but the *swap* is a `rename` of a
    name, and the same account that could swap the name before the extraction can
    swap it after. Renaming a planted symlink into `SAVED_DIR` is what leaves the
    live world a link — which `_chown_tree` would then walk through. This is the
    same trade `_check_scratch_identity` documents: no door in the API takes a
    descriptor, so the window is narrowed to the rename itself and made loud
    instead of silent, and it refuses *before* the live world is moved aside.
    """
    try:
        st = os.lstat(new_tree)
    except OSError as exc:
        raise archive.ArchiveError(
            f"the staging tree {new_tree} became unreadable after it was "
            f"extracted ({exc}); refusing to swap it into place") from exc
    pinned = os.fstat(tfd)
    if (st.st_dev, st.st_ino) != (pinned.st_dev, pinned.st_ino):
        raise archive.ArchiveError(
            f"the staging tree {new_tree} was replaced after it was extracted "
            f"(it is no longer the directory this restore created); refusing to "
            f"swap it into {SAVED_DIR}")


def _discard_staging(tfd: int, display: Path) -> None:
    """Remove the staging tree we created, located through its descriptor.

    Not `shutil.rmtree(new_tree)`: if that name was swapped for a symlink while we
    were extracting, that spelling has root deleting whatever the link points at,
    which is a worse outcome than the debris we are cleaning up. The descriptor's
    /proc link names the directory we actually created, wherever it now lives.
    """
    try:
        real = os.readlink(f"/proc/self/fd/{tfd}")
    except OSError as exc:
        print(f"palworld-restore: warning: cannot locate the staging tree "
              f"{display} to clean it up: {exc}", file=sys.stderr)
        return
    if real.endswith(" (deleted)") or not os.path.isdir(real):
        print(f"palworld-restore: warning: the staging tree {display} is no "
              f"longer a directory ({real}); leaving it alone", file=sys.stderr)
        return
    # ignore_errors so a cleanup problem cannot mask the failure that is the real
    # news.
    shutil.rmtree(real, ignore_errors=True)


class _SwapError(archive.ArchiveError):
    """A swap that failed, carrying the state the tree was left in.

    `replaced` is the replaced-world tree if one exists by the time of the failure
    (so `_print_recovery` can still name it), and `touched_live` says whether
    `SAVED_DIR` itself was modified before the failure. The caller needs that
    second bit to decide the staging tree's fate: debris nobody needs when nothing
    moved, and the only copy of the not-yet-moved half of the new world when
    something did.
    """

    def __init__(self, message: str, replaced: Path | None,
                 touched_live: bool) -> None:
        super().__init__(message)
        self.replaced = replaced
        self.touched_live = touched_live


def _entry_bytes(path: str) -> int:
    """Apparent size of one top-level entry, following no symlink.

    `st_size` and not `st_blocks * 512`: the question this answers is "how much
    will writing a copy of this consume", and a copy writes the bytes, not the
    source's allocation. A sparse or reflinked source therefore reads as bigger
    than it is on disk, which errs towards refusing a restore that would just fit
    rather than starting one that will not — the right direction, given the state
    a mid-swap `ENOSPC` leaves behind.
    """
    try:
        st = os.lstat(path)
    except OSError:
        return 0
    if not stat.S_ISDIR(st.st_mode):
        return st.st_size
    total = st.st_size
    for dirpath, _dirnames, filenames in os.walk(path, followlinks=False):
        for entry in filenames:
            try:
                total += os.lstat(os.path.join(dirpath, entry)).st_size
            except OSError:
                # A file that vanished mid-walk contributes nothing; this is a
                # budget estimate, not an inventory, and one unreadable name must
                # not turn a capacity check into a failed restore.
                continue
    return total


def _check_copy_capacity(remaining: Sequence[str], src_fd: int, dst_fd: int,
                         src_display: Path, dst_display: Path) -> None:
    """Refuse a cross-mount copy that will not fit. Raises OSError(ENOSPC).

    **Why here and not once before the swap.** A `rename` consumes no space at
    all, so an unconditional precheck would refuse restores on bare metal that
    would have worked; and the only honest way to know a copy is coming is the
    `EXDEV` the kernel already gave us. Deliberately *not* an `st_dev`
    comparison — two bind mounts off one host filesystem report the same device
    and the rename is refused anyway, so that test would pass vacuously and the
    copy would still happen (the same reasoning as `_move_entry`'s fallback).

    **Why the whole remainder of the phase and not just this entry.** Once one
    entry has come back `EXDEV`, every later entry of the same phase will too:
    it is the same pair of directories. Checking only the entry in hand would
    approve a first copy that fits and then run out of room on the second — which
    is precisely the mixed-tree state the swap exists to avoid producing. So the
    budget is the sum of everything still to move in this phase.

    `os.fstatvfs(dst_fd)`, not `statvfs(path)`: the destination is a descriptor
    from here on and the free space that matters is the one on the filesystem that
    descriptor is open on, which is not necessarily the one its name resolves to
    now. `f_bavail`, matching `_check_capacity` — the blocks available to this
    caller after the reserved-block margin.

    OSError and not ArchiveError, for `_move_entry`'s reason: the callers catch
    OSError to build the mid-swap state report, and the whole value of refusing
    here is that the report says nothing has moved yet.
    """
    needed = sum(_entry_bytes(_at(src_fd, entry)) for entry in remaining)
    needed += FREE_HEADROOM_BYTES
    try:
        vfs = os.fstatvfs(dst_fd)
    except OSError:
        # A destination we cannot measure is not a reason to refuse a
        # disaster-recovery restore; the copy below will fail on ENOSPC with the
        # mid-swap report if it really does not fit.
        return
    available = vfs.f_bavail * vfs.f_frsize
    if available >= needed:
        return
    raise OSError(
        errno.ENOSPC,
        f"copying {len(remaining)} entr"
        f"{'y' if len(remaining) == 1 else 'ies'} of {src_display} into "
        f"{dst_display} needs about {needed} bytes ({FREE_HEADROOM_BYTES} of that "
        f"headroom) but only {available} bytes are free there. This move crosses a "
        f"mount boundary, so it is a copy and not a rename, and a restore that "
        f"runs out of space partway leaves the world split across two directories "
        f"- so it is refused before anything moves. Free space beside "
        f"{dst_display} and restore again")


def _remove_partial_copy(name: str, dst_fd: int, dst_display: Path) -> None:
    """Delete the half-written destination entry a failed copy left behind.

    Without this a failed copy leaves debris the mid-swap report contradicts:
    `shutil.copytree` copies what it can and *then* raises, so an `ENOSPC` partway
    through `SaveGames` left a full-looking `SAVED_DIR/SaveGames` while the
    recovery instructions told the operator to move `SaveGames` back from the
    replaced tree — a `mv` that collides, or silently merges a half copy over the
    good tree. "A failure leaves the entry where it was" is only true of the
    *source*; this is what makes it true of the destination too.

    Located through `dst_fd`, and only for something we could have created: an
    entry that is a symlink now is not our debris (we never create one at a
    destination without `dir_fd`), and `shutil.rmtree` refuses a symlink anyway
    rather than deleting through it. Never fatal — it runs on a failure path, and
    the caller's report is the news.
    """
    try:
        st = os.lstat(name, dir_fd=dst_fd)
    except FileNotFoundError:
        return
    except OSError as exc:
        print(f"palworld-restore: warning: cannot inspect the partially copied "
              f"{dst_display / name} to remove it: {exc}", file=sys.stderr)
        return
    try:
        if stat.S_ISDIR(st.st_mode):
            # By a path whose directory half is pinned by `_at`; rmtree itself
            # walks with descriptors on Linux and refuses a symlink at the root.
            shutil.rmtree(_at(dst_fd, name))
        else:
            os.unlink(name, dir_fd=dst_fd)
    except OSError as exc:
        print(f"palworld-restore: warning: could not remove the partially copied "
              f"{dst_display / name}: {exc}; remove it by hand before following "
              f"the recovery instructions below", file=sys.stderr)


def _move_entry(name: str, src_fd: int, dst_fd: int, src_display: Path,
                dst_display: Path, remaining: Sequence[str] = ()) -> None:
    """Move one top-level entry between two pinned directories.

    `rename` first, through both descriptors: that is what runs on bare metal and
    in any layout where the two directories share a filesystem — atomic per entry
    and free.

    **The fallback is not a second strategy, it is an errno.** Where `Pal/Saved` is
    its own mount (a named volume in `docker/compose.yaml`, a bind mount in
    `docker/compose.live.yaml`) its children sit under a *different mount* from its
    siblings, so a rename between `Pal/Saved` and `Pal/Saved.replaced-…` returns
    `EXDEV` — measured, errno 18, in both directions. Worth being precise about:
    "mount", not "filesystem". Two bind mounts off the same host filesystem report
    the *same* `st_dev` and the rename is refused regardless, so this cannot be
    predicted by comparing devices — only by asking the kernel and handling the
    answer, which is what this does. `shutil.move` crosses
    the same boundary the same way. Doing it here keeps one code path for every
    deployment: nothing detects a mount point and nothing branches on the
    container, the kernel says when a rename cannot serve and only then is a copy
    paid for. The cost where it fires is real — the world is copied rather than
    relinked — and a restore is a disaster-recovery operation where correctness
    outranks minutes.

    `src_dir_fd`/`dst_dir_fd` on the rename, and `/proc/self/fd/<fd>/` spellings on
    the copy, so neither directory can be re-resolved mid-move; see `_at`.

    The entry is classified with `lstat` and copied by type rather than handed to
    one do-everything call: the *live* world is written by the game and by
    operators, so unlike the extracted tree (whose members `_check_member` limits
    to files and directories) it may hold a symlink, and `copy2` on a link with
    `follow_symlinks=True` would duplicate its target instead of the link.

    **Every destination is created by a call that refuses an existing final
    component**, through `dst_fd`: `os.mkdir`, `os.symlink`, and
    `O_CREAT|O_EXCL|O_NOFOLLOW`. That is not belt and braces, it is the whole
    guarantee — and its absence was a root privilege escalation reachable by the
    account `palwarden-webui` runs as. `_at` pins the *directory* half of a
    destination path; the final component is not pinned, and `SAVED_DIR` is owned
    by that account. This branch was `shutil.copy2(src, dst,
    follow_symlinks=False)`, where `follow_symlinks=False` governs the **source**
    only: `shutil.copyfile` opens the destination with a plain `open(dst, "wb")`,
    which follows a symlink at the final component. So a symlink planted at the
    destination name had root writing the archive's bytes into a file of the
    attacker's choosing — `/root/.ssh/authorized_keys`, `/etc/cron.d/*`,
    `/etc/ld.so.preload` — while the restore reported success. Reproduced end to
    end, and every link of the chain is reachable in the shipped code: an archive
    whose only member is a *regular file named `Config`* passes `_check_member`
    (first component in `ALLOWED_TOPLEVEL`, `isreg()`), the web account can
    `--import` it, and `_swap_contents` snapshots the live directory's entries
    *once* before the out-phase, so a name planted after that snapshot is never
    moved aside and is still there when the in-phase copies onto it. The whole
    out-phase is the window; there is no race to win.

    An occupied destination is now a refusal, not a clobber. It is `EEXIST` out of
    the syscall rather than a check of our own, because a check would have the same
    gap the old code did: whatever we looked at could be replaced before we wrote.
    """
    try:
        os.rename(name, name, src_dir_fd=src_fd, dst_dir_fd=dst_fd)
        return
    except OSError as exc:
        if exc.errno != errno.EXDEV:
            raise
    src = _at(src_fd, name)
    st = os.lstat(src)
    if remaining:
        # Before the first byte, so a destination that cannot hold the rest of this
        # phase is a refusal with nothing moved rather than a mixed tree.
        _check_copy_capacity(remaining, src_fd, dst_fd, src_display, dst_display)
    if stat.S_ISDIR(st.st_mode):
        # mkdir first, and not `copytree`'s own makedirs: it claims the name with a
        # call that fails EEXIST on anything already there (a directory, a file, or
        # even a dangling symlink — mkdir does not follow the final component), and
        # it makes the partial tree below unambiguously *ours* to remove. 0700 while
        # it fills; `copytree`'s closing `copystat` puts the source's mode on.
        os.mkdir(name, 0o700, dir_fd=dst_fd)
        try:
            # dirs_exist_ok is False by default and is written out because the
            # whole point of the mkdir above is that this must never merge into a
            # tree someone else put here — except the one we just made, hence the
            # True: the refusal is the mkdir, not this.
            shutil.copytree(src, _at(dst_fd, name), symlinks=True,
                            dirs_exist_ok=True)
        except BaseException:
            _remove_partial_copy(name, dst_fd, dst_display)
            raise
    elif stat.S_ISLNK(st.st_mode):
        # Both halves through a descriptor: the target read from `src_fd`, the link
        # created in `dst_fd`, where an occupied name is EEXIST.
        os.symlink(os.readlink(name, dir_fd=src_fd), name, dir_fd=dst_fd)
    elif stat.S_ISREG(st.st_mode):
        # 0600 while it fills, then the source's mode: a world save must not be
        # briefly group-readable in a directory the service account can read.
        out_fd = os.open(name, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW,
                         0o600, dir_fd=dst_fd)
        try:
            with os.fdopen(out_fd, "wb") as out:
                # The *source* through `src_fd` with `O_NOFOLLOW` as well, so the
                # type we classified is the type we read: in the out-phase the
                # source directory is the service account's, and `open(src, "rb")`
                # on a name swapped for a symlink after the `lstat` reads whatever
                # it points at.
                in_fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=src_fd)
                with os.fdopen(in_fd, "rb") as inp:
                    shutil.copyfileobj(inp, out)
                os.fchmod(out.fileno(), stat.S_IMODE(st.st_mode))
                # What copy2 did for us and the game cares about: a save file's
                # mtime is how an operator tells which world they are looking at.
                os.utime(out.fileno(), ns=(st.st_atime_ns, st.st_mtime_ns))
        except BaseException:
            _remove_partial_copy(name, dst_fd, dst_display)
            raise
    else:
        # OSError and not ArchiveError, deliberately: the callers catch OSError to
        # build the mid-swap state report, and an ArchiveError raised here would
        # sail past that and lose the one thing the operator needs — which of the
        # entries had already moved.
        raise OSError(
            errno.EINVAL,
            f"{src_display / name} is neither a regular file, a directory nor a "
            f"symbolic link, so it cannot be copied across the filesystem "
            f"boundary into {dst_display}")
    # Only after the copy is complete, so a failure up to here leaves the entry
    # where it was *and* leaves nothing of it at the destination (see
    # `_remove_partial_copy`) — the recoverable half of a mid-swap failure. Both
    # halves are needed: the recovery instructions tell the operator to move whole
    # entries back, and a half copy sitting at the destination is what makes that
    # `mv` collide or merge.
    if stat.S_ISDIR(st.st_mode):
        shutil.rmtree(src)
    else:
        os.unlink(name, dir_fd=src_fd)


def _open_live_dir(replaced_path: Path) -> tuple[int, Path | None]:
    """Pin `SAVED_DIR` as a real directory, creating it if need be.

    Returns its descriptor and the replaced-tree path if the *name* had to be
    moved aside — which happens in exactly one case: something that is not a
    directory sits there. That is the old code's `is_symlink()` branch kept intact
    (a link at this name must be moved aside, never followed and never clobbered),
    and it is safe to rename because nothing but a directory can be a mount point,
    so this is the one path where the name itself still moves.

    `O_DIRECTORY|O_NOFOLLOW` for the same reason `_open_staging_dir` uses it, one
    directory over: `SAVED_DIR.parent` is owned by the service account that
    `palwarden-webui` runs as, so between the check above and this open that
    account can put a link at this name. The descriptor is what every later rename
    is aimed at, so it — not the name — is the destination from here on.
    """
    replaced: Path | None = None
    try:
        st: os.stat_result | None = os.lstat(SAVED_DIR)
    except FileNotFoundError:
        st = None
    except OSError as exc:
        raise _SwapError(
            f"cannot inspect {SAVED_DIR} before restoring into it: {exc}",
            None, False) from exc

    if st is not None and not stat.S_ISDIR(st.st_mode):
        try:
            os.rename(SAVED_DIR, replaced_path)
        except OSError as exc:
            raise _SwapError(
                f"{SAVED_DIR} is not a directory and it cannot be moved aside to "
                f"{replaced_path} ({exc}); refusing to restore over it",
                None, False) from exc
        replaced = replaced_path
        print(f"replaced: {SAVED_DIR} was not a directory, so it was moved whole "
              f"to {replaced}")
        st = None

    if st is None:
        try:
            # 0755, which is the mode the staging tree used to carry in when the
            # swap was a rename of the directory. An *existing* directory keeps its
            # own mode: where it is a mount point, its mode belongs to the volume
            # and silently rewriting it is not this tool's business. Ownership is
            # still normalised either way, by `_chown_tree`.
            SAVED_DIR.mkdir(parents=True, mode=0o755)
        except OSError as exc:
            raise _SwapError(
                f"cannot create {SAVED_DIR} to restore into: {exc}",
                replaced, False) from exc

    try:
        sfd = os.open(SAVED_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise _SwapError(
            f"cannot open {SAVED_DIR} to restore into: {exc}",
            replaced, False) from exc
    return sfd, replaced


def _swap_contents(new_tree: Path, tfd: int, replaced_path: Path) -> Path | None:
    """Put the extracted world into `SAVED_DIR` by moving *contents*, not the
    directory. Returns the replaced-world tree, or None if there was nothing to
    move aside. Raises `_SwapError`.

    **Why contents.** This was two renames of the directories themselves, which was
    atomic, shorter, and cannot succeed in any Docker deployment:
    `/opt/palworld/server/Pal/Saved` is a mount point in both compose files, and
    `rename(2)` on a mount point is `EBUSY` — measured, errno 16. Moving the
    children works whether the target is a mount point or an ordinary directory, so
    bare metal and every container shape run the same code. A mount-point detector
    with two strategies would put the deployment that matters on the branch the
    suite exercises least.

    **The cost, plainly: this is not atomic.** A directory `rename` either happened
    or did not, so a failure left the old world untouched and complete. Moving
    entries one at a time can fail halfway and leave `SAVED_DIR` *mixed* — part of
    the new world in, part of the old world still there, or the old world split
    across two directories. That is strictly worse than what it replaces, and the
    answer is not to hide it: every failure below names which of those states the
    tree is in and where both routes back are, because a partial recovery the
    operator cannot diagnose from the job output is this project's worst outcome.

    Everything the previous version guarded is still guarded. `SAVED_DIR` is pinned
    with `O_DIRECTORY|O_NOFOLLOW` before anything moves and every rename is aimed
    at the descriptor, which is *stronger* than the by-name rename it replaces —
    the destination cannot be re-resolved at all now, rather than being re-checked
    just before. `_check_staging_identity` still runs before the first entry moves.
    `_chown_tree`'s `S_ISLNK` refusal still stands over the ownership pass.
    """
    sfd, replaced = _open_live_dir(replaced_path)
    try:
        old = sorted(os.listdir(sfd))
        if not old:
            # "held no entries" rather than "was empty" or "did not exist": both
            # are true here (a missing one was just created by `_open_live_dir`)
            # and this is the wording that is not a lie in either case.
            print(f"replaced: nothing to move aside - {SAVED_DIR} held no entries")
        else:
            try:
                # 0700 and mkdir (not exist_ok): the name carries entropy precisely
                # so that an occupied one means someone else got there first, which
                # is a refusal and not something to extract a world into. 0700
                # because this is a full world save sitting in a service-account
                # directory until an operator removes it.
                os.mkdir(replaced_path, 0o700)
                rfd = os.open(replaced_path,
                              os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            except OSError as exc:
                raise _SwapError(
                    f"cannot create the replaced-world tree {replaced_path} "
                    f"({exc}); {SAVED_DIR} has not been touched, so the previous "
                    f"world is intact and this restore did nothing",
                    replaced, False) from exc
            moved = 0
            try:
                for index, name in enumerate(old):
                    try:
                        # `old[index:]` is the capacity budget: everything this
                        # phase has still to move, needed in full if the first
                        # entry turns out to cross a mount boundary.
                        _move_entry(name, sfd, rfd, SAVED_DIR, replaced_path,
                                    remaining=old[index:])
                    except OSError as exc:
                        raise _SwapError(_mid_swap_out(
                            name, moved, old, replaced_path, new_tree, exc),
                            replaced_path if moved else replaced,
                            moved > 0) from exc
                    moved += 1
                    replaced = replaced_path
            finally:
                os.close(rfd)
            print(f"replaced: the previous world's {moved} top-level entr"
                  f"{'y' if moved == 1 else 'ies'} moved to {replaced}")

        fresh = sorted(os.listdir(tfd))
        landed = 0
        for index, name in enumerate(fresh):
            try:
                _move_entry(name, tfd, sfd, new_tree, SAVED_DIR,
                            remaining=fresh[index:])
            except OSError as exc:
                raise _SwapError(_mid_swap_in(
                    name, landed, fresh, replaced, new_tree, exc),
                    replaced, True) from exc
            landed += 1
    finally:
        os.close(sfd)
    return replaced


def _mid_swap_out(name: str, moved: int, old: list[str], replaced_path: Path,
                  new_tree: Path, exc: OSError) -> str:
    """The message for a failure while moving the *previous* world aside.

    Split out from `_swap_contents` because the exact state of the tree is the
    whole product of this failure path, and it is long enough that burying it in
    the control flow is how one of the two states quietly stops being reported.

    Entries are named and not just counted. With `ALLOWED_TOPLEVEL` at two that is
    a nicety; the point is that "1 of 2 moved" stops being enough the moment a
    third is added, and one `', '.join` is cheaper than noticing later.

    "was discarded" is stated as an *intent* rather than a fact because
    `_discard_staging` can warn and leave the tree alone (a staging name swapped
    for something that is no longer a directory), and that warning is on stderr
    right next to this message. Claiming a removal that did not happen is how an
    operator stops believing the rest of the report.
    """
    partial = (f"Nothing of {name} was left at the destination - a copy that fails "
               f"partway is removed, so both directories hold only whole entries")
    if moved == 0:
        return (f"cannot move {SAVED_DIR / name} aside to {replaced_path} "
                f"({exc}). Nothing was moved: the previous world is complete and "
                f"untouched in {SAVED_DIR}, and no part of the restored world was "
                f"written into it. {partial}. The extracted world at {new_tree} is "
                f"being discarded")
    # "none" rather than an empty pair of brackets: a report is read under
    # pressure and `()` is a typo, not a state.
    done = ", ".join(old[:moved]) or "none"
    left = ", ".join(old[moved:]) or "none"
    return (f"cannot move {SAVED_DIR / name} aside to {replaced_path} ({exc}). "
            f"The restore stopped PARTWAY: {moved} of {len(old)} top-level "
            f"entries of the previous world are now in {replaced_path} ({done}) "
            f"and the remaining {len(old) - moved} are still in {SAVED_DIR} "
            f"({left}), so the previous world is SPLIT ACROSS THE TWO. No part of "
            f"the restored world was written into {SAVED_DIR}. {partial}. To undo: "
            f"move everything from {replaced_path} back into {SAVED_DIR}")


def _mid_swap_in(name: str, landed: int, fresh: list[str],
                 replaced: Path | None, new_tree: Path, exc: OSError) -> str:
    """The message for a failure while moving the *restored* world in.

    This is the bad one: `SAVED_DIR` holds part of one world and part of another,
    and the server must not be started on it. So it says so, in those words, and
    names the tree the rest of the restored world is still in as well as both
    routes back — by name, for `_mid_swap_out`'s reason.
    """
    if replaced is not None:
        state = (f"the previous world is complete in {replaced}. To undo: empty "
                 f"{SAVED_DIR}, then move everything from {replaced} back into it")
    else:
        state = (f"there was no previous world to move aside, so the only route "
                 f"back is the safety archive named below - if one was taken")
    done = ", ".join(fresh[:landed]) or "none"
    left = ", ".join(fresh[landed:]) or "none"
    return (f"cannot move {new_tree / name} into {SAVED_DIR} ({exc}). The restore "
            f"stopped PARTWAY: {landed} of {len(fresh)} top-level entries of the "
            f"restored world are in {SAVED_DIR} ({done}) and the remaining "
            f"{len(fresh) - landed} are still in {new_tree} ({left}), so "
            f"{SAVED_DIR} is a MIXED tree and the server must NOT be started on "
            f"it. Nothing of {name} was left in {SAVED_DIR} - a copy that fails "
            f"partway is removed, so it holds only whole entries - {state}")


def _saved_populated() -> bool:
    """True when SAVED_DIR exists and holds at least one entry.

    A restore is disaster recovery: `Pal/Saved` may not exist at all on a rebuilt
    host, and an *empty* one is what a partially-created install leaves behind.
    Neither is a reason to abort, and neither is worth an archive of nothing —
    which is why this is a question and not an assertion. scandir stops at the
    first entry rather than listing a few thousand save files to learn one bit.
    """
    try:
        with os.scandir(SAVED_DIR) as entries:
            for _ in entries:
                return True
        return False
    except (FileNotFoundError, NotADirectoryError):
        return False
    except OSError as exc:
        # Anything else (EACCES, EIO) is a real problem with the world directory
        # and must not be silently read as "nothing to preserve".
        raise archive.ArchiveError(f"cannot inspect {SAVED_DIR}: {exc}") from exc


def _safety_backup() -> str | None:
    """Archive the current world before replacing it. Returns its name, or None.

    Conditional, per the disaster-recovery case: skipped with a printed note when
    there is no world to preserve. A *failed* backup, on the other hand, aborts —
    replacing a world that does exist with no way back is the one outcome this
    tool must never produce.
    """
    if not _saved_populated():
        print(f"safety backup: skipped - {SAVED_DIR} does not exist or is empty, "
              f"so there is no world to preserve (the normal case on a rebuilt "
              f"host).")
        return None
    rc, out = _run([str(SBIN / "palworld-backup")], echo=True)
    if rc != 0:
        raise archive.ArchiveError(
            f"the pre-restore safety backup failed (exit {rc}); refusing to "
            f"replace a world with no way back to it")
    # palworld-backup prints the archive path on stdout as its last line.
    lines = [ln for ln in out.splitlines() if ln.strip()]
    name = os.path.basename(lines[-1].strip()) if lines else "(unknown)"
    print(f"safety backup: {name}")
    return name


def _service_active() -> bool:
    """True when the game server is running, via the same command everything else
    in this repo asks with (and which the container shim answers from s6)."""
    rc, _ = _run([SYSTEMCTL, "is-active", "--quiet", SERVICE_UNIT])
    return rc == 0


def _graceful_stop(wait: int | None) -> None:
    """Stop the server, tolerating "already stopped". Raises on a real failure.

    The server being down is the *expected* state for a restore — it is why the
    operator is here — so a stop that fails because there was nothing to stop
    must not abort. But "ignore the exit code" would equally swallow a stop that
    genuinely could not stop a *running* server, and replacing the world under a
    live server corrupts both the restore and the save the server then writes.

    So the postcondition decides, not the exit code: a non-zero stop is tolerated
    only when the server is demonstrably not running. This is a real shape, not a
    hypothetical: `s6-svc -d` on a service directory that does not exist yet
    (fresh container, server service not yet selected) exits non-zero with
    nothing running, and bare-metal `graceful-stop` exits non-zero if the REST
    save call fails on a crashlooping server.
    """
    argv = [str(SBIN / "palworld-graceful-stop")]
    if wait is not None:
        argv += ["--wait", str(wait)]
    rc, _ = _run(argv, echo=True)
    if rc == 0:
        print("stop: graceful stop completed.")
        return
    if _service_active():
        raise archive.ArchiveError(
            f"graceful stop failed (exit {rc}) and {SERVICE_UNIT} is still "
            f"active; refusing to replace the world under a running server")
    print(f"stop: graceful stop exited {rc}, but {SERVICE_UNIT} is not active - "
          f"treating it as already stopped.")


def _resolve_account() -> tuple[int, int]:
    """(uid, gid) for the service account; -1 for either half we must not change.

    Warns and returns -1 rather than aborting on an unresolvable name: a restored
    world owned by root is a fixable annoyance, a restore refused at the last step
    is not. Silence is the thing to avoid — that was the swallowed LookupError in
    palworld-config-snapshot.
    """
    uid = gid = -1
    if SERVICE_USER:
        try:
            uid = pwd.getpwnam(SERVICE_USER).pw_uid
        except KeyError:
            print(f"palworld-restore: warning: user {SERVICE_USER!r} does not "
                  f"exist; leaving the restored tree's owner as is", file=sys.stderr)
    if SERVICE_GROUP:
        try:
            gid = grp.getgrnam(SERVICE_GROUP).gr_gid
        except KeyError:
            print(f"palworld-restore: warning: group {SERVICE_GROUP!r} does not "
                  f"exist; leaving the restored tree's group as is", file=sys.stderr)
    return uid, gid


def _chown_tree(root: Path) -> None:
    """Give the restored tree to the service account. A failed `chown` warns; the
    two *integrity* checks — the root is not a symlink, and no entry is a hardlink
    — are fatal by design, because either one means the tree is not the one this
    restore extracted.

    `os.fwalk(follow_symlinks=False)` plus `chown(..., dir_fd=…,
    follow_symlinks=False)`, so a symlink *inside* the tree cannot redirect the
    chown at a path outside it, and no directory in the walk is re-resolved by
    name after it was checked.

    **Why descriptors and not `os.walk` + `lchown` any more.** This used to walk a
    staging tree root had just created and renamed into place, so nothing could
    inject into it during the walk. It now walks `SAVED_DIR` — writable by the
    service account for the whole restore, because the swap moves *contents* and
    the directory itself is the mount point. A directory planted mid-walk is
    therefore reachable, and `os.walk`'s name-by-name `lchown` would follow the
    parent chain afresh for each one.

    **Hardlinks are the part a descriptor does not fix**, so they are refused
    rather than defended. A name is only a name: a hardlink to `/etc/shadow`
    planted inside the tree resolves to that inode through a `dir_fd` exactly as
    it does through a path, and `lchown` on it hands root's file to the service
    account. `fs.protected_hardlinks=1` makes creating such a link impossible for
    an account that cannot read the target, but that is a *host* sysctl this
    project neither sets nor verifies, so it cannot be the guarantee. Instead:
    every non-directory entry is `stat`ed through its parent's descriptor and an
    `st_nlink > 1` aborts. A world save this tool extracted cannot contain one —
    `_check_member` refuses hardlink members by type and a fresh extraction creates
    each file once — so a link count above one means something that is not our
    world is in the tree, which is the same reasoning as the root-is-a-symlink
    refusal below and gets the same answer. Directories are exempt because their
    link count is how subdirectories are counted.

    **The root of the walk is the exposure those two do not cover.**
    `followlinks=False` is about *descending* into symlinked subdirectories; the
    directory os.walk is *given* is followed unconditionally. So if `root` is
    itself a symlink — which is what a swap of the staging name for a link, and
    then the rename into place, leaves behind — this function walks the link's
    target and hands every path under it to the service account. A reviewer
    demonstrated exactly that, with the restore reporting success while it
    happened. `os.lstat` + `S_ISLNK` is the refusal, and it is a raise rather
    than a warning: the tree we are about to hand over not being the tree we
    extracted means the swap already succeeded, and there is nothing about the
    rest of the restore worth continuing at that point.

    The guarantee that makes this belt and braces is `palwarden_archive`'s
    `_check_member` type rule — `if not (member.isreg() or member.isdir())` — which
    refuses a symlink or hardlink member by *type*, before any name reasoning, so
    the tree we just created cannot contain a link at all. That rule, in another
    module, is the one whose loosening would matter here, and the cost of it being
    loosened is root handing ownership of an arbitrary path to the service
    account.

    `extract_archive`'s `filter="data"` is the second-order backstop and covers
    strictly less: Python's data filter refuses a link whose target is absolute or
    escapes the destination, and *accepts* an internal relative symlink (verified,
    not assumed). So it would not on its own keep a link out of this walk —
    `_check_member` is what does. `followlinks=False` is os.walk's default; it is
    written out because the whole point of the line is that it must not change.
    """
    try:
        st = os.lstat(root)
    except OSError as exc:
        raise archive.ArchiveError(
            f"cannot inspect the restored tree {root} before giving it to the "
            f"service account: {exc}") from exc
    if stat.S_ISLNK(st.st_mode):
        raise archive.ArchiveError(
            f"the restored tree {root} is a symbolic link, not a directory; "
            f"refusing to change ownership through it (a link at this name would "
            f"redirect the chown at a tree this restore never created)")
    if not stat.S_ISDIR(st.st_mode):
        raise archive.ArchiveError(
            f"the restored tree {root} is not a directory; refusing to change "
            f"ownership through it")
    uid, gid = _resolve_account()
    if uid == -1 and gid == -1:
        return
    failures = 0
    first: str | None = None

    def chown(name: str, display: str, dir_fd: int) -> None:
        nonlocal failures, first
        try:
            # follow_symlinks=False is `lchown`, and dir_fd is what makes the
            # *parent* of that name the descriptor we are already holding.
            os.chown(name, uid, gid, dir_fd=dir_fd, follow_symlinks=False)
        except OSError as exc:
            failures += 1
            if first is None:
                first = f"{display}: {exc}"

    # The root through a descriptor opened O_NOFOLLOW, so the name is resolved
    # once, here, and the walk below hangs off that resolution rather than
    # repeating it. The lstat checks above stay: they are what produce the
    # operator-facing message, where this open would only produce ELOOP/ENOTDIR.
    try:
        rfd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise archive.ArchiveError(
            f"cannot open the restored tree {root} to give it to the service "
            f"account: {exc}") from exc
    try:
        try:
            os.fchown(rfd, uid, gid)
        except OSError as exc:
            failures += 1
            first = f"{root}: {exc}"
        for dirpath, dirnames, filenames, dirfd in os.fwalk(
                dir_fd=rfd, follow_symlinks=False):
            for entry in filenames:
                display = os.path.normpath(os.path.join(str(root), dirpath, entry))
                try:
                    est = os.stat(entry, dir_fd=dirfd, follow_symlinks=False)
                except OSError as exc:
                    failures += 1
                    if first is None:
                        first = f"{display}: {exc}"
                    continue
                if est.st_nlink > 1:
                    raise archive.ArchiveError(
                        f"{display} has {est.st_nlink} hard links, so this name is "
                        f"shared with a file outside the world this restore "
                        f"extracted; refusing to give it to "
                        f"{SERVICE_USER}:{SERVICE_GROUP} (a hardlink planted in "
                        f"{root} is how root's own files are handed to the service "
                        f"account). {root} holds the restored world - remove the "
                        f"offending name and re-run the ownership pass by hand")
                chown(entry, display, dirfd)
            for entry in dirnames:
                chown(entry, os.path.normpath(
                    os.path.join(str(root), dirpath, entry)), dirfd)
    finally:
        os.close(rfd)
    if failures:
        # One warning with a count, not one per file: a wrong uid would otherwise
        # bury the rest of the restore's output under thousands of lines.
        print(f"palworld-restore: warning: could not set owner "
              f"{SERVICE_USER}:{SERVICE_GROUP} on {failures} path(s) under "
              f"{root}; first was {first}", file=sys.stderr)
    else:
        print(f"ownership: {root} given to {SERVICE_USER or '(unchanged)'}:"
              f"{SERVICE_GROUP or '(unchanged)'}")


def _confirm_startup(timeout: int) -> str:
    """Poll for readiness. Returns "ready", "unverifiable", or "timeout".

    The mechanism is palworld-graceful-restart's, reused rather than reinvented:
    `palworld-api info` succeeding is what "up" means in this repo.

    The three-way return is the point. palworld-api exits **2** for "REST API not
    enabled / no ADMIN_PASSWORD", which no amount of waiting can fix;
    graceful-restart treats that as "restarted, readiness not checked" and exits
    0. For a restore that is *not* a confirmed startup, and it drives a different
    decision than a timeout does — so it gets its own answer instead of being
    folded into either success or failure. Deletion of the replaced tree hangs on
    a positive "ready", never on the absence of an error.
    """
    argv = [str(SBIN / "palworld-api"), "info"]
    deadline = time.monotonic() + timeout
    while True:
        rc, _ = _run(argv)
        if rc == 0:
            return "ready"
        if rc == 2:
            return "unverifiable"
        if time.monotonic() >= deadline:
            return "timeout"
        time.sleep(POLL_SECONDS)


def _require_answerable_service_state() -> None:
    """Refuse --restore where "is the server running?" has no truthful answer.

    `_graceful_stop` tolerates a failed stop *only* when the service is
    demonstrably inactive, and that logic is only as good as `is-active`. In
    `PALWARDEN_MODE=external` it is not good at all: there is no `palworld-server`
    s6 service in that mode, so `docker/shims/systemctl` finds nothing for
    `s6-svstat`, falls through to `pgrep -f PalServer-Linux-Shipping`, and finds
    nothing there either — because the game is running on another host entirely. A
    stop that failed against a live external server therefore reports "not
    active", `_graceful_stop` prints "treating it as already stopped", and the
    restore replaces `Pal/Saved` under a running server: the exact outcome that
    branch exists to prevent, produced by the branch itself.

    So an unanswerable question is refused rather than read as "inactive". This is
    a refusal and not a best-effort attempt for a second reason as well: `systemctl
    start` has nothing to start in external mode either, so the restore as
    currently written would replace the world and *then* report failure. Refusing
    up front is the only version of this that cannot destroy a world.

    Gated on PALWARDEN_MODE rather than on probing for a service directory: the
    mode is what the entrypoint decides everything else from, it is set in the
    environment every job inherits, and it is unset on bare metal — where systemd
    answers for the unit locally and the question is answerable — so bare metal
    keeps working with no branch of its own.
    """
    if PALWARDEN_MODE == "external":
        raise archive.ArchiveError(
            "--restore is not supported in PALWARDEN_MODE=external: the game "
            "server runs on another host, so this tool cannot tell whether it is "
            "running, cannot stop it, and cannot start it again - and a restore "
            "that mistakes a live server for a stopped one replaces the world "
            "underneath it. Stop the server and restore on the host that runs it")


def _report_stale_replaced() -> None:
    """Name any world trees earlier restores left behind. Never fatal.

    Both kinds, `.replaced-*` and `.restore-*`. Only the first used to be globbed,
    which was fine while a staging tree could only survive a crash — and wrong from
    the moment the swap could fail with the staging tree deliberately kept (see
    `_swap_contents`). Each is a full world save, so a glob that names one kind and
    not the other is how the disk quietly fills.

    Every restore whose startup could not be confirmed keeps a full copy of the
    previous world beside the target, on purpose and forever — it is the fastest
    undo there is. Nothing ever mentions them again, so they accumulate silently
    at one world save each, and `shutil.rmtree(..., ignore_errors=True)` is this
    file's one deliberate silence. Naming them at the *start* of a restore is the
    cheapest fix: the operator sees the accumulation at the moment they are already
    thinking about this directory, before adding one more to it.

    Deliberately no `du` and no deletion: sizing means walking a few thousand save
    files for a number the operator can get themselves, and deleting someone's
    only route back to a world is not something a tool should do unasked.
    """
    try:
        stale = sorted(p.name for pattern in ("replaced", "restore")
                       for p in SAVED_DIR.parent.glob(
                           f"{SAVED_DIR.name}.{pattern}-*"))
    except OSError:
        # The parent may not exist at all on a rebuilt host, and a directory we
        # cannot list is not a reason to refuse a disaster-recovery restore.
        return
    if not stale:
        return
    print(f"note: {len(stale)} leftover world tree(s) from earlier restores are "
          f"still in {SAVED_DIR.parent}, each holding a full world save: "
          f"{', '.join(stale)}. Remove them by hand once those servers are known "
          f"good.")


def _print_recovery(replaced: Path | None, safety: str | None) -> None:
    """Name every route back, on the failure path. Two of them where possible.

    Printed before the error itself is reported, and to stderr, so a failed
    restore ends with the operator holding both the cheap undo (a rename) and the
    durable one (an archive) rather than having to work out what state the tree
    was left in.
    """
    if replaced is not None:
        print(f"palworld-restore: the replaced world is kept at {replaced}; "
              f"moving it back over {SAVED_DIR} undoes this restore",
              file=sys.stderr)
    if safety is not None:
        print(f"palworld-restore: the pre-restore safety archive is {safety} "
              f"in {BACKUP_DIR}", file=sys.stderr)
    else:
        print(f"palworld-restore: no pre-restore safety archive was taken (there "
              f"was no world in {SAVED_DIR} to preserve)", file=sys.stderr)


def restore_archive(name: str, wait: int | None = None,
                    startup_timeout: int | None = None) -> int:
    """Turn the named backup back into a running world. Raises ArchiveError.

    Returns 0 when the world was restored (whether or not readiness could be
    confirmed) and raises on anything that stopped the restore short.

    The order below is the design, and each step's failure stops the next:
    validate the scratch copy → conditional safety backup → graceful stop →
    extract *beside* the target → swap the target's *contents* → chown → start and
    confirm → delete the replaced tree only on a confirmed startup.

    The swap moves entries rather than renaming the directory because `Pal/Saved`
    is a mount point in every Docker deployment and `rename(2)` on one is EBUSY;
    the trade — it is no longer atomic — and how a partial swap is reported are in
    `_swap_contents`.

    The scratch-directory descriptor is opened before the copy and held until the
    restore is over, so the copy, the validation, the extraction and the cleanup
    all reach the scratch file through one verified directory rather than through
    four independent resolutions of its path.
    """
    _require_answerable_service_state()
    src = _backup_path(name)
    if startup_timeout is None:
        startup_timeout = STARTUP_TIMEOUT
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    safety: str | None = None
    replaced: Path | None = None

    _report_stale_replaced()
    dfd = _open_scratch_dir()
    scratch: Path | None = None
    try:
        scratch = _scratch_copy(src, dfd)
        try:
            info, ident = _validate_scratch(scratch, dfd)
            print(f"validated: {name} ({info['members']} members, {info['bytes']} "
                  f"bytes uncompressed), from the root-owned scratch copy {scratch}")

            safety = _safety_backup()
            _graceful_stop(wait)

            # The entropy is not cosmetic and it is not about collisions. The
            # staging and replaced names live in `SAVED_DIR.parent` (`.../Pal`),
            # which is owned by the *service account* — the account
            # `palwarden-webui` runs as, and the one this whole file is defending
            # against. A second-resolution stamp is a name that account can
            # *predict*, and therefore pre-place a symlink at: `os.mkdir` then
            # fails EEXIST at best, and at worst the name is swapped after the
            # mkdir. `secrets.token_hex` is the same treatment the scratch and
            # import temp names already get, for the same reason — the destination
            # deserved it as much as the source did.
            suffix = f"{stamp}-{secrets.token_hex(8)}"
            new_tree = SAVED_DIR.parent / f"{SAVED_DIR.name}.restore-{suffix}"
            replaced_path = SAVED_DIR.parent / f"{SAVED_DIR.name}.replaced-{suffix}"
            try:
                # The parent may not exist at all on a rebuilt host.
                SAVED_DIR.parent.mkdir(parents=True, exist_ok=True)
                # mkdir, not makedirs(exist_ok=True): an occupied name is a clean
                # refusal rather than an extraction into someone else's directory.
                os.mkdir(new_tree, 0o755)
            except OSError as exc:
                raise archive.ArchiveError(
                    f"cannot create the staging tree {new_tree}: {exc}") from exc
            # Pin the destination before anything is written to it, and keep the
            # descriptor until the swap is done: creating the directory is not the
            # same as still having it. See `_open_staging_dir`.
            tfd = _open_staging_dir(new_tree)
            try:
                try:
                    # Immediately before the extraction, not anywhere earlier: the
                    # point is that no unchecked bytes reach the staging tree.
                    _check_scratch_identity(scratch, dfd, ident)
                    # Extract beside the target, never over it: a partial extraction
                    # must not be able to leave a half-replaced world. Everything up
                    # to here is reversible by doing nothing.
                    #
                    # *Both* paths go through a held descriptor — the archive
                    # through `dfd`, the destination through `tfd` — so neither the
                    # bytes read nor the directory written can be re-resolved to
                    # something else between the check and the use. See `_at`.
                    archive.extract_archive(_at(dfd, scratch.name), _at(tfd, "."))
                    print(f"extracted: {new_tree}")
                    # The rename below is by name, so the name is re-checked against
                    # the descriptor first: a staging tree swapped for a symlink
                    # after the extraction would otherwise be renamed into place and
                    # leave the live world a link. Deliberately before the live tree
                    # is moved aside, so the refusal costs nothing.
                    _check_staging_identity(new_tree, tfd)
                except BaseException:
                    # The live tree has not been touched yet, so the only debris is
                    # ours — and `_discard_staging` removes *ours*, found through
                    # `tfd`, not whatever the name points at now. That distinction is
                    # the whole reason the identity failure above is inside this
                    # try: `rmtree(new_tree)` on a swapped name would have root
                    # deleting an attacker-chosen tree while cleaning up.
                    _discard_staging(tfd, new_tree)
                    raise

                # The swap is inside the descriptor's lifetime now, because it
                # moves the staging tree's *entries* and therefore needs `tfd` —
                # see `_swap_contents` for why it cannot be a rename of the
                # directory.
                try:
                    replaced = _swap_contents(new_tree, tfd, replaced_path)
                except _SwapError as exc:
                    # The staging tree used to leak on every failure here: this
                    # `except` sat outside the `_discard_staging` try above, so a
                    # failed swap left a fully extracted world save behind with
                    # nothing printed about it — which, since the swap could not
                    # succeed in a container at all, was every containerised
                    # restore attempt.
                    replaced = exc.replaced
                    if exc.touched_live:
                        # Not discarded: it holds the entries that had not been
                        # moved in yet, and an operator reconstructing a mixed tree
                        # may want them. Named instead, so it is never silent.
                        print(f"palworld-restore: the extracted world is left at "
                              f"{new_tree}; it still holds the entries that were "
                              f"not moved in. Remove it by hand once this restore "
                              f"has been sorted out", file=sys.stderr)
                    else:
                        _discard_staging(tfd, new_tree)
                    raise
                except BaseException:
                    _discard_staging(tfd, new_tree)
                    raise
                # Emptied by the swap; removed through the descriptor for
                # `_discard_staging`'s reason, not by name.
                _discard_staging(tfd, new_tree)
            finally:
                os.close(tfd)
            print(f"restored: {SAVED_DIR}")

            _chown_tree(SAVED_DIR)

            rc, _ = _run([SYSTEMCTL, "start", SERVICE_UNIT], echo=True)
            if rc != 0:
                raise archive.ArchiveError(
                    f"the world was restored, but starting {SERVICE_UNIT} failed "
                    f"(exit {rc})")
            state = _confirm_startup(startup_timeout)
            if state == "timeout":
                raise archive.ArchiveError(
                    f"the world was restored and {SERVICE_UNIT} was started, but "
                    f"the REST API did not become ready within {startup_timeout}s, "
                    f"so the startup is not confirmed")
        except BaseException:
            _print_recovery(replaced, safety)
            raise
    finally:
        # On both success and failure: nothing may be left in the scratch
        # directory, which is the one place a restore reads its authoritative
        # bytes from. `scratch` is None when the copy itself never got as far as
        # creating a file, in which case there is nothing to remove and — as in
        # `_copy_fd_to_temp` — nothing of ours to guess at either.
        if scratch is not None:
            _unlink_quietly_at(dfd, scratch.name, scratch)
        os.close(dfd)

    if state == "ready":
        print(f"started: {SERVICE_UNIT} is up and the REST API is healthy.")
        if replaced is not None:
            # Conditional on a *positive* confirmation, never on the absence of
            # an error: until the restored server answers, the replaced tree is
            # the fastest undo there is (a rename, no untarring). Keeping it
            # forever would cost a full world save per restore, so it goes now
            # that the durable safety net (the archive above) is the only one
            # still needed.
            shutil.rmtree(replaced, ignore_errors=True)
            print(f"cleaned up: removed the replaced world {replaced}")
    else:  # "unverifiable"
        print(f"started: {SERVICE_UNIT} was started, but the REST API is not "
              f"configured (palworld-api exit 2), so readiness could NOT be "
              f"verified.")
        if replaced is not None:
            print(f"kept: the replaced world stays at {replaced} precisely "
                  f"because the startup could not be confirmed; remove it by hand "
                  f"once the server is known good.")
    if safety is not None:
        print(f"safety archive retained: {safety} in {BACKUP_DIR}")
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="palworld-restore",
        description="Import and restore Palworld world-save archives.")
    # A group, not two bare flags: the two modes must never be given together.
    # `required` keeps a bare invocation an error rather than a silent no-op,
    # while leaving --help at exit 0.
    mode = ap.add_mutually_exclusive_group(required=True)
    mode.add_argument("--import", dest="import_name", metavar="ARCHIVE",
                      help="promote an uploaded archive from the staging "
                           "directory into the backups directory")
    mode.add_argument("--restore", dest="restore_name", metavar="ARCHIVE",
                      help="replace the live world with the contents of an "
                           "archive from the backups directory")
    # --restore only. Left off --import rather than accepted-and-ignored there:
    # a flag that silently does nothing is how an operator learns the wrong model
    # of a tool. argparse's own error names the flag, so no extra check is needed.
    ap.add_argument("--wait", type=int, metavar="SECONDS",
                    help="player-warning window forwarded to palworld-graceful-stop "
                         "(--restore only; the stop tool's own default applies "
                         "when omitted)")
    ap.add_argument("--startup-timeout", type=int, metavar="SECONDS",
                    default=None,
                    help=f"how long to wait for REST API readiness after starting "
                         f"the server (--restore only; default {STARTUP_TIMEOUT})")
    args = ap.parse_args(argv)

    if args.import_name is not None and (args.wait is not None
                                         or args.startup_timeout is not None):
        ap.error("--wait and --startup-timeout apply to --restore only")
    if args.wait is not None and args.wait < 0:
        ap.error("--wait must not be negative")

    try:
        if args.import_name is not None:
            print(import_staged(args.import_name))
        else:
            return restore_archive(args.restore_name, wait=args.wait,
                                   startup_timeout=args.startup_timeout)
    except archive.ArchiveError as exc:
        print(f"palworld-restore: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        # An unexpected filesystem error is still an operator-facing message, not
        # a traceback out of a root process.
        print(f"palworld-restore: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
