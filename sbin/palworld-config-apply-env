#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
set -euo pipefail
source /usr/local/lib/palworld-notify 2>/dev/null || true
# Notifications are optional: without the helper installed, no-op rather than
# aborting the apply on "command not found".
declare -F palworld_notify >/dev/null || palworld_notify() { :; }
# Immutable-bit helpers; fall back to the repo copy when not installed yet.
# shellcheck source=../lib/palworld-fileattr
source /usr/local/lib/palworld-fileattr 2>/dev/null \
  || source "$(dirname "${BASH_SOURCE[0]}")/../lib/palworld-fileattr"
# Paths default to the bare-metal layout; overrides exist for the container/tests.
config_env="${PALWORLD_SETTINGS_ENV:-/etc/palworld/settings.env}"
server_dir="${PALWORLD_SERVER_DIR:-/opt/palworld/server}"
config_file="${PALWORLD_CONFIG_FILE:-$server_dir/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini}"
backup_dir="${PALWORLD_BACKUP_DIR:-/opt/palworld/config-backups}"
parser_bin="${PALWORLD_PARSER_BIN:-/usr/local/bin/palworld-config-parser}"
# Palworld rewrites its config on shutdown, reverting managed settings, so the
# file is left immutable (chattr +i) after a successful apply. --no-protect skips
# that. Where the immutable bit is unavailable (containers) this degrades to a
# warning; see lib/palworld-fileattr.
protect=1
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-protect) protect=0; shift ;;
    -h|--help) echo "Usage: $0 [--no-protect]"; exit 0 ;;
    *) echo "Usage: $0 [--no-protect]" >&2; exit 64 ;;
  esac
done
# Owner of the server files. Defaults to the bare-metal `palworld` service
# account; the container overrides this to `steam`.
PALWORLD_USER="${PALWORLD_USER:-palworld}"
PALWORLD_GROUP="${PALWORLD_GROUP:-palworld}"
if [[ ! -r "$config_env" ]]; then
  echo "Cannot read $config_env" >&2
  exit 1
fi
# Sourced only to validate. The parser reads $config_env itself via --env-file,
# so secrets never have to pass through this script's environment.
# shellcheck disable=SC1090
source "$config_env"
if [[ "${REST_API_ENABLED:-False}" == "True" && -z "${ADMIN_PASSWORD:-}" ]]; then
  echo "REST_API_ENABLED=True requires ADMIN_PASSWORD to be set." >&2
  exit 2
fi
install -d -o "$PALWORLD_USER" -g "$PALWORLD_GROUP" -m 0755 "$backup_dir"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
backup="$backup_dir/PalWorldSettings.ini.$stamp"
cp -a "$config_file" "$backup"
chown "$PALWORLD_USER:$PALWORLD_GROUP" "$backup"
# Unlock before writing (a previous apply, or the operator, may have locked it)
# and make sure we relock on the way out even if something below fails.
was_immutable=0
if fileattr_is_immutable "$config_file"; then
  was_immutable=1
  fileattr_set_immutable "$config_file" off
fi
relock() {
  if [[ "$protect" -eq 1 || "$was_immutable" -eq 1 ]]; then
    fileattr_set_immutable "$config_file" on
  fi
}
trap relock EXIT

# Apply every setting (including passwords) in one pass. The parser redacts
# secret values in its own output, so no log scrubbing is needed here.
"$parser_bin" --config "$config_file" --env-file "$config_env"
chown "$PALWORLD_USER:$PALWORLD_GROUP" "$config_file"
chmod 0644 "$config_file"
/usr/local/sbin/palworld-config-pretty >/dev/null 2>&1 || true
diff_text=$(/usr/local/lib/palworld-config-diff --discord "$backup" "$config_file" || true)
if [[ -z "$diff_text" ]]; then
  diff_text="No non-secret config changes detected."
fi
summary_text=$(/usr/local/lib/palworld-config-summary || true)
if [[ -z "$summary_text" ]]; then
  summary_text="Relevant server settings summary unavailable."
fi
# shellcheck disable=SC2016  # backticks are literal Discord markdown, not expansions
printf -v notify_msg 'config parser applied environment changes; backup: `%s`. Restart palworld.service for config changes to take effect.\n\n%s\n\n%s' "$(basename "$backup")" "$diff_text" "$summary_text"
palworld_notify success "$notify_msg"
/usr/local/sbin/palworld-fps mark "PalWorldSettings.ini config applied" --category config --details "backup=$(basename "$backup")" >/dev/null 2>&1 || true
echo "Updated $config_file"
echo "Backup: $backup"
printf "%s\n\n%s\n" "$diff_text" "$summary_text"
