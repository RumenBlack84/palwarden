#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
"""Root worker for the web UI control plane's job queue.

Runs as root. Its only input is a job file dropped in `PALWARDEN_JOBS_DIR` by
`palwarden-webui`, which runs unprivileged and is treated as untrusted: a bug
in that HTTP handler, or a hand-edited job file, must not be able to run
anything this worker did not itself validate. So every action name and every
parameter is re-checked here, from scratch, against a fixed allowlist — the
job file's contents are a *request*, never a command.

Every action maps to a fixed argv list built from typed, validated slots.
Nothing is ever passed through a shell, and no parameter is ever interpolated
into a string that reaches one.
"""

from __future__ import annotations

import argparse
import fcntl
import importlib.machinery
import importlib.util
import os
import re
import secrets
import subprocess
import sys
import time
import traceback
from pathlib import Path

# Mirror how palworld-health-report locates palworld-fps: prepend the
# bare-metal lib dir and the repo's lib/ so `palwarden_jobs` resolves in both
# installed and dev-checkout layouts (tests set PYTHONPATH instead).
sys.path.insert(0, "/usr/local/lib")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import palwarden_jobs as jobs  # noqa: E402

SBIN = Path(os.environ.get("PALWARDEN_SBIN_DIR", "/usr/local/sbin"))
ENGINE_ENV = Path(os.environ.get("PALWORLD_ENGINE_ENV", "/etc/palworld/engine.env"))
BACKUP_DIR = Path(os.environ.get("PALWORLD_BACKUP_DIR", "/opt/palworld/config-backups"))
# Deliberately NOT derived from SBIN: SBIN is where *invoked commands* live
# (tests point it at stub binaries), but the module we load here for its
# setting definitions is palwarden-jobd's own neighbour — same directory in
# both the installed layout (/usr/local/sbin) and a dev checkout (repo sbin/).
# Consequence for real deployments: if you set PALWARDEN_SBIN_DIR you must set
# PALWARDEN_ENGINE_CONFIG_BIN to match, or jobd validates settings against one
# copy of palworld-engine-config's table and applies them with another.
ENGINE_CONFIG_BIN = Path(os.environ.get(
    "PALWARDEN_ENGINE_CONFIG_BIN", str(Path(__file__).resolve().parent / "palworld-engine-config")))
JOBD_LOCK = Path(os.environ.get("PALWARDEN_JOBD_LOCK", "/run/palwarden-jobd.lock"))
JOBD_INTERVAL_DEFAULT = 2.0


def _interval_from_env(raw: str | None) -> float:
    """Poll interval from the environment, tolerating a bad value.

    A typo in a unit file or compose env must not turn into a traceback at
    import time: that would take out *every* action rather than just slowing
    the loop, so warn and fall back to the default.
    """
    if raw is None or raw.strip() == "":
        return JOBD_INTERVAL_DEFAULT
    try:
        value = float(raw)
    except ValueError:
        value = -1.0
    if value <= 0 or value > 3600:
        print(f"PALWARDEN_JOBD_INTERVAL={raw!r} is not a sane number of seconds; "
              f"using {JOBD_INTERVAL_DEFAULT}", file=sys.stderr)
        return JOBD_INTERVAL_DEFAULT
    return value


JOBD_INTERVAL = _interval_from_env(os.environ.get("PALWARDEN_JOBD_INTERVAL"))

LABEL_RE = re.compile(r"[A-Za-z0-9._-]{1,64}")
# The exact shape palworld-engine-config writes: `Engine.ini.<UTC stamp>` from
# `backup_engine`/`command_apply`, plus `Engine.ini.pre-rollback.<stamp>` from
# `rollback_engine`. Anchoring on that (rather than any name at all) is what
# stops an attacker-chosen file in the web-writable backup dir from being
# rolled into place; see validate_backup.
# The trailing `-<n>` is the de-duplicating suffix write_new_nofollow adds when two
# applies land in the same UTC second; without it those backups would list but
# refuse to roll back.
BACKUP_RE = re.compile(r"Engine\.ini\.(?:pre-rollback\.)?[0-9]{8}T[0-9]{6}Z(?:-[0-9]{1,2})?")


def load_engine_config_module():
    """Load palworld-engine-config as a module rather than duplicating its
    settings table: the 15 known engine settings, their types and their
    min/max ranges must live in exactly one place.

    Same pattern as palworld-health-report's load_fps_module / palwarden-webui's
    load_parser_module (hyphenated script names cannot be imported normally).
    """
    loader = importlib.machinery.SourceFileLoader("palwarden_engine_config_for_jobd", str(ENGINE_CONFIG_BIN))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


_engine = load_engine_config_module()
SETTING_BY_ENV = _engine.SETTING_BY_ENV
normalize_value = _engine.normalize_value


# --- parameter validators ---------------------------------------------------
# Each raises ValueError with a message safe to surface in job output.


def validate_label(params: dict, key: str = "label") -> str:
    value = params.get(key)
    if not isinstance(value, str) or not LABEL_RE.fullmatch(value):
        raise ValueError(f"{key} must match {LABEL_RE.pattern!r}, got {value!r}")
    return value


def validate_text(params: dict, key: str = "text") -> str:
    value = params.get(key)
    if not isinstance(value, str) or len(value) > 200 or not value.isprintable():
        raise ValueError(f"{key} must be <=200 printable characters")
    return value


def validate_wait(params: dict) -> int | None:
    """Validate the *optional* `wait` seconds.

    Returns None when the caller did not ask for a particular wait, so the argv
    builders can omit `--wait` entirely and let the invoked tool apply its own
    default (palworld-update's is 300s) rather than jobd inventing a second one.
    """
    if "wait" not in params or params.get("wait") is None:
        return None
    value = params["wait"]
    # bool is an int subclass in Python; reject it explicitly so {"wait": true}
    # doesn't silently become wait=1.
    if isinstance(value, bool) or not isinstance(value, int) or not (0 <= value <= 1800):
        raise ValueError(f"wait must be an integer 0-1800, got {value!r}")
    return value


def validate_dry_run(params: dict) -> bool:
    value = params.get("dry_run", False)
    if not isinstance(value, bool):
        raise ValueError(f"dry_run must be a boolean, got {value!r}")
    return value


def validate_backup(params: dict) -> str:
    """Validate a rollback source in the *web-writable* backup directory.

    BACKUP_DIR is owned by the unprivileged web user, so anything in it — names
    and symlinks alike — is attacker-controlled. A rollback ends in "copy
    <backup> over Engine.ini", chown-to-palworld, chmod 0644, so accepting a
    symlink here would publish any root-readable file (settings.env,
    /etc/shadow) to the web user. Hence: never stat through the link before the
    name is validated, reject links outright, and require the exact name shape
    palworld-engine-config itself writes.

    These checks are a *pre-flight*, not the security boundary. jobd validates
    the name and then spawns palworld-engine-config as a separate process, which
    re-resolves it — the entry can be swapped for a symlink inside that window,
    and the attacker can retry by re-enqueueing. What actually closes that race
    is palworld-engine-config opening the source with O_NOFOLLOW (see
    read_backup_nofollow there): a kernel refusal at the moment of use, with no
    check-then-use gap. Refusing here still matters — it fails the job with a
    clear reason instead of relying on the tool's error path.

    A *hardlink* with a legitimate-looking name passes every check below (it is
    a regular file, not a symlink). Considered and deliberately not checked:
    `fs.protected_hardlinks=1` (default on the target distros) stops an
    unprivileged user hardlinking a file it does not own, and the O_NOFOLLOW
    read covers what remains.
    """
    value = params.get("backup")
    if not isinstance(value, str) or "/" in value or "\\" in value:
        raise ValueError(f"backup must be a bare file name, got {value!r}")
    if not BACKUP_RE.fullmatch(value):
        raise ValueError(f"backup must match {BACKUP_RE.pattern!r}, got {value!r}")
    candidate = BACKUP_DIR / value
    # lstat/is_symlink do NOT follow the link, so this decides on the entry
    # itself; is_file() below would have followed it.
    if candidate.is_symlink():
        raise ValueError(f"backup must not be a symlink: {value!r}")
    if not candidate.is_file():
        raise ValueError(f"backup not found: {value!r}")
    # No containment check on the resolved path: with a bare name (no separators)
    # that is not itself a symlink, realpath resolves a symlinked *parent*
    # identically on both sides of any comparison, so such a check could never
    # fire. Containment is structural here; the target's O_NOFOLLOW open is what
    # enforces it at the moment of use.
    return value


def validate_message(params: dict) -> str | None:
    # message is optional; validate only when present.
    if "message" not in params or params.get("message") is None:
        return None
    return validate_text(params, "message")


def validate_settings(params: dict) -> dict[str, str]:
    raw = params.get("settings")
    if not isinstance(raw, dict) or not raw:
        raise ValueError("settings must be a non-empty object")
    normalised: dict[str, str] = {}
    for key, value in raw.items():
        setting = SETTING_BY_ENV.get(key)
        if setting is None:
            raise ValueError(f"unknown engine setting: {key!r}")
        # A JSON UI naturally posts numbers as numbers, so accept int/float and
        # coerce to the string form normalize_value parses. bool is an int
        # subclass — reject it explicitly rather than storing True as "1".
        if isinstance(value, bool) or not isinstance(value, (str, int, float)):
            raise ValueError(f"{key} value must be a string or number, got {value!r}")
        normalised[key] = normalize_value(setting, str(value))
    return normalised


def require_confirm(params: dict) -> None:
    if params.get("confirm") is not True:
        raise ValueError("disruptive action requires confirm: true")


# --- engine_save: the one action that writes a file instead of running a
# command ---------------------------------------------------------------


def _read_nofollow_text(path: Path) -> str | None:
    """Read `path` through an O_NOFOLLOW descriptor. None when it does not exist.

    A missing engine.env is normal (nothing has been saved yet), so it is None
    rather than an error; a symlink at that name is refused by the kernel.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "r") as fh:  # fdopen takes ownership of the fd
        return fh.read()


class _AlreadyRead:
    """Text pretending to be a Path, for palworld-engine-config's parse_env.

    parse_env(path) only ever calls `path.read_text(errors=...)`, so handing it
    this lets write_engine_env verify through a descriptor it opened O_NOFOLLOW
    instead of re-opening engine.env by name, while still using the *one* env
    parser rather than a second copy of it.
    """

    def __init__(self, text: str) -> None:
        self._text = text

    def read_text(self, *_args, **_kwargs) -> str:
        return self._text


def write_engine_env(settings: dict[str, str]) -> None:
    """Atomically merge already-normalised settings into ENGINE_ENV.

    A *merge*, not a replace: engine.env is the set of values
    `palworld-engine-config apply` manages and its drift check compares against.
    Dropping a key the request happened not to include would silently unmanage
    it — apply would stop enforcing it, the drift check would go blind to it,
    and Engine.ini would keep the stale value.

    Never destroys an existing file on failure: write a temp file in the same
    directory, rename it into place, then re-read and re-parse it to confirm
    the result is sane before declaring success.
    """
    # 0755 to match how /etc/palworld is created elsewhere (install.sh's
    # `install -d -m 0755`); engine.env is tuning, not a secret.
    ENGINE_ENV.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    # Same reader palworld-engine-config uses, so "what is currently managed"
    # means exactly what apply would see (unknown keys are not ours to keep).
    # Read through an O_NOFOLLOW descriptor, like the verify read below. /etc/palworld
    # is root:root 0755 so nothing can plant here today, and parse_env filters to the
    # 15 known keys either way — but one function reading by path and writing by
    # descriptor reads as an oversight, and this is the file that taught us the
    # difference.
    merged: dict[str, str] = {}
    existing = _read_nofollow_text(ENGINE_ENV)
    if existing is not None:
        merged.update(_engine.parse_env(_AlreadyRead(existing)))
    merged.update(settings)
    lines = [
        "# Generated by palwarden-jobd (engine_save). Do not edit by hand;",
        "# use the Engine.ini performance editor instead.",
        f"# Written: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
        "",
    ]
    for key, value in sorted(merged.items()):
        lines.append(f"{key}={value}")
    text = "\n".join(lines) + "\n"

    # Unguessable temp name, O_CREAT|O_EXCL|O_NOFOLLOW, and fchmod on the
    # descriptor rather than chmod on the name — the same shape as
    # palwarden_jobs._write and palworld-engine-config's write_new_nofollow.
    # /etc/palworld is root:root 0755 today, so nothing can plant a link at a fixed
    # "engine.env.tmp" and there is no live escalation here; this closes the
    # *pattern* rather than an instance. It was the last check-then-use-by-path
    # write left in a confirm-free action (engine_save is not disruptive), and it
    # cost nothing to remove: a fixed name would be plantable the moment anything
    # ever loosened /etc/palworld, and it also collided between two concurrent
    # writers.
    tmp = ENGINE_ENV.with_name(f"{ENGINE_ENV.name}.tmp.{os.getpid()}.{secrets.token_hex(4)}")
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o644)
    try:
        os.fchmod(fd, 0o644)  # belt-and-braces: independent of umask
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        # rename(2) replaces a symlink at the destination rather than writing
        # through it, so the destination needs no separate guard.
        tmp.replace(ENGINE_ENV)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise

    # Confirm the file we just wrote actually parses back to what we wrote —
    # a self-check against a corrupt/truncated write, using the same reader
    # palworld-engine-config uses (one parser, not a second copy). Read back
    # through a descriptor we opened O_NOFOLLOW rather than by path: re-opening
    # the name is exactly the check-then-use gap the temp write above just closed,
    # and a symlink swapped in here would make the round-trip check validate some
    # other file entirely (or pass while engine.env is wrong).
    verify_fd = os.open(ENGINE_ENV, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(verify_fd, "r") as fh:  # fdopen takes ownership of the fd
        written = fh.read()
    # Still exactly palworld-engine-config's parse_env — one parser, not a second
    # copy — fed the bytes we read from the descriptor. parse_env's only use of its
    # argument is `.read_text(errors=...)`, so a one-method stand-in is enough to
    # decouple it from re-opening the name.
    reparsed = _engine.parse_env(_AlreadyRead(written))
    for key, value in merged.items():
        if reparsed.get(key) != value:
            raise ValueError(f"engine.env write did not round-trip for {key}")


# --- action table ------------------------------------------------------------
# Each entry maps to argv(params) -> list of argv lists, run in order, plus
# whether the action is disruptive (requires confirm) and the exact set of
# parameter names the action recognises. engine_save has no command at all — it
# only writes a file — so it is handled separately in build_commands/run_job.
#
# Every action runs as root, the uid this worker already has. A `drop_priv` flag
# on the file-only actions (mark, snapshot_create, config_pretty) was tried and
# reverted: it was justified by root leaving root-owned SQLite `-wal`/`-shm` side
# files that unprivileged fps-samples could then not write, but SQLite's
# robustFchown() (os_unix.c) chowns both side files to the *database's* owner when
# it is running as root, precisely so the original owner keeps working — measured,
# then confirmed in the source. Dropping privilege instead *created* a bare-metal
# failure: palworld-fps-sample.service has no User=, so root created
# /var/lib/palworld/metrics.sqlite3 on first use and a `mark` dropped to the
# service account then died on every write with "attempt to write a readonly
# database" (every connect() runs PRAGMA journal_mode=WAL, which is a write).
#
# Half of that condition is now gone: install.sh pre-creates the DB owned by the
# service account, exactly as the container entrypoint already did, because the
# *unprivileged* side needed it — palwarden-webui runs as $SVC_USER and its
# /api/fps, /api/events, /api/service-events and /api/health all open the same DB.
# A root-created DB degraded three read endpoints on every fresh bare-metal
# install. The other half stands: palworld-fps-sample.service still has no `User=`,
# so root remains a legitimate writer, and robustFchown is what keeps the two
# compatible. Re-introducing drop_priv would still need that unit changed first.
#
# Ownership of an action's *outputs* is the individual tool's job, done on the
# descriptor it wrote — see palworld-config-pretty's fchown. It is deliberately
# *not* done for snapshots or save backups: those roots are root-owned precisely
# so root never writes an attacker-nameable path (see palworld-config-snapshot).
#
# `params` is a whitelist, not documentation: validate_params refuses any key
# not listed (plus `confirm`, which every disruptive action takes) and builds the
# normalised dict from these names alone. Both halves matter. Copying the request
# through meant a typo'd `waitt: 30` was silently ignored instead of reported,
# and it let an authenticated caller store arbitrary JSON in the queue — the API
# accepts a 64 KiB body, so that was 64 KiB of junk written to disk per request.
# Fixing it here rather than in palwarden-webui fixes the API too: the web
# process enqueues whatever this function returns, and the worker is the side
# that must not trust the queue.


def _argv_config_apply(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-config-apply-env")]]


def _argv_engine_apply(params: dict) -> list[list[str]]:
    dry_run = validate_dry_run(params)
    argv = [str(SBIN / "palworld-engine-config"), "apply"]
    if dry_run:
        argv.append("--dry-run")
    return [argv]


def _argv_config_pretty(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-config-pretty")]]


def _argv_snapshot_create(params: dict) -> list[list[str]]:
    label = validate_label(params)
    # `--` before every parameter-derived positional: `-` is a legal label
    # character and `text` only has to be printable, so a value like "--no-mark"
    # would otherwise be parsed as an *option* by the target's argparse.
    return [[str(SBIN / "palworld-config-snapshot"), "create", "--", label]]


def _argv_backup(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-backup")]]


def _argv_mark(params: dict) -> list[list[str]]:
    text = validate_text(params)
    # --category must precede the `--`: argparse treats *everything* after the
    # terminator as positional, so `mark -- <text> --category manual` fails.
    return [[str(SBIN / "palworld-fps"), "mark", "--category", "manual", "--", text]]


def _argv_graceful_restart(params: dict) -> list[list[str]]:
    wait = validate_wait(params)
    message = validate_message(params)
    argv = [str(SBIN / "palworld-graceful-restart")]
    if wait is not None:  # absent wait: let the tool's own default stand
        argv += ["--wait", str(wait)]
    if message is not None:
        # No `--` protects an option *value*: a terminator can only mark the end
        # of options, so a flag-shaped message ("--force") is safe here purely
        # because of what the targets do with it — not because of anything jobd
        # can add. Current chain: palworld-graceful-restart →
        # palworld-graceful-stop → palworld-api-stop → palworld-api, every hop
        # bash positionals, and the message itself ends up in an environment
        # variable consumed by json.dumps. No argparse, no shell interpolation.
        # That is a property of today's targets, not an invariant: if any of them
        # becomes argparse-based, the fix is the single-token `--message=<value>`
        # form (argparse never treats the value as a separate option), not a `--`.
        argv += ["--message", message]
    return [argv]


def _argv_graceful_stop(params: dict) -> list[list[str]]:
    wait = validate_wait(params)
    message = validate_message(params)
    argv = [str(SBIN / "palworld-graceful-stop")]
    if wait is not None:
        argv += ["--wait", str(wait)]
    if message is not None:
        argv += ["--message", message]  # see _argv_graceful_restart on `--`
    return [argv]


def _argv_update_check(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-update"), "--check"]]


def _argv_update_apply(params: dict) -> list[list[str]]:
    wait = validate_wait(params)
    argv = [str(SBIN / "palworld-update")]
    if wait is not None:  # else palworld-update's own default (300s) applies
        argv += ["--wait", str(wait)]
    return [argv]


def _argv_engine_rollback(params: dict) -> list[list[str]]:
    backup = validate_backup(params)
    return [[str(SBIN / "palworld-engine-config"), "rollback", "--", backup]]


def _argv_api_save(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-api-save")]]


def _argv_engine_save_apply_restart(params: dict) -> list[list[str]]:
    # engine_save itself writes no command (build_commands handles it before
    # calling here); this only builds the apply + restart steps that follow.
    wait = validate_wait(params)
    restart = [str(SBIN / "palworld-graceful-restart")]
    if wait is not None:
        restart += ["--wait", str(wait)]
    return [
        [str(SBIN / "palworld-engine-config"), "apply"],
        restart,
    ]


ACTIONS: dict[str, dict] = {
    "config_apply": {"argv": _argv_config_apply, "disruptive": False, "params": ()},
    "engine_apply": {"argv": _argv_engine_apply, "disruptive": False, "params": ("dry_run",)},
    "config_pretty": {"argv": _argv_config_pretty, "disruptive": False, "params": ()},
    "snapshot_create": {"argv": _argv_snapshot_create, "disruptive": False,
                        "params": ("label",)},
    "backup": {"argv": _argv_backup, "disruptive": False, "params": ()},
    "mark": {"argv": _argv_mark, "disruptive": False, "params": ("text",)},
    "engine_save": {"argv": None, "disruptive": False, "params": ("settings",)},
    "graceful_restart": {"argv": _argv_graceful_restart, "disruptive": True,
                         "params": ("wait", "message")},
    "graceful_stop": {"argv": _argv_graceful_stop, "disruptive": True,
                      "params": ("wait", "message")},
    "update_check": {"argv": _argv_update_check, "disruptive": True, "params": ()},
    "update_apply": {"argv": _argv_update_apply, "disruptive": True, "params": ("wait",)},
    "engine_rollback": {"argv": _argv_engine_rollback, "disruptive": True,
                        "params": ("backup",)},
    "api_save": {"argv": _argv_api_save, "disruptive": True, "params": ()},
    "engine_save_apply_restart": {"argv": _argv_engine_save_apply_restart, "disruptive": True,
                                  "params": ("settings", "wait")},
}


def recognised_params(action: str) -> frozenset[str]:
    """Every parameter name `action` accepts, `confirm` included where it applies."""
    spec = ACTIONS[action]
    names = set(spec["params"])
    if spec["disruptive"]:
        # Not listed per action: it is required of *all* of them, and forgetting
        # it in one entry would make that action unenqueueable.
        names.add("confirm")
    return frozenset(names)


def validate_params(action: str, params: dict) -> tuple[dict | None, str | None]:
    """Re-validate action + params from scratch. Returns (normalised_params, error).

    Exactly one of the two return slots is populated. Never trust that params
    already passed validation elsewhere (the API, or an earlier version of this
    same job file) — the job file is untrusted input.

    The returned dict is built key by key from the action's whitelist, so it
    contains recognised, normalised values and nothing else. An unrecognised key
    is an *error* rather than a silent drop: a caller that wrote `waitt` meant
    something by it, and a restart that quietly ignored the wait it was asked for
    is worse than one that was refused.
    """
    spec = ACTIONS.get(action)
    if spec is None:
        return None, f"{action!r} is not an allowed action"
    if not isinstance(params, dict):
        return None, "params must be an object"
    unknown = sorted(k for k in params if k not in recognised_params(action))
    if unknown:
        allowed = ", ".join(sorted(recognised_params(action))) or "no parameters"
        return None, (f"{action} does not take the parameter "
                      f"{', '.join(repr(k) for k in unknown)}; it takes: {allowed}")
    if spec["disruptive"]:
        try:
            require_confirm(params)
        except ValueError as exc:
            return None, str(exc)
    try:
        # Whitelist, not a copy: only the slots below ever reach the job file.
        normalised: dict = {}
        if spec["disruptive"]:
            normalised["confirm"] = True  # already proven to be exactly True
        if action in ("engine_save", "engine_save_apply_restart"):
            normalised["settings"] = validate_settings(params)
        if action in ("graceful_restart", "graceful_stop", "update_apply", "engine_save_apply_restart"):
            normalised["wait"] = validate_wait(params)
        if action in ("graceful_restart", "graceful_stop"):
            normalised["message"] = validate_message(params)
        if action == "engine_apply":
            normalised["dry_run"] = validate_dry_run(params)
        if action == "snapshot_create":
            normalised["label"] = validate_label(params)
        if action == "mark":
            normalised["text"] = validate_text(params)
        if action == "engine_rollback":
            normalised["backup"] = validate_backup(params)
    except ValueError as exc:
        return None, str(exc)
    return normalised, None


def build_commands(action: str, params: dict) -> list[list[str]]:
    """Build the fixed argv list(s) for an already-validated action+params.

    Callers must run validate_params first; this does not re-validate (it can
    raise if given bad input, but run_job always calls validate_params first).
    """
    spec = ACTIONS[action]
    if spec["argv"] is None:
        return []  # engine_save: file-only, no command
    # Exactly the tool's own command line, with no privilege-changing prefix: the
    # worker is already root and every action stays there (see the ACTIONS
    # preamble on the reverted drop_priv flag).
    return spec["argv"](params)


def run_job(job: dict) -> int:
    """Validate, then execute a job's steps in order, recording output/state.

    Stops at the first failing step (composite actions like
    engine_save_apply_restart never reach a restart after a failed apply).
    Returns the exit code recorded on the job (0 on success).
    """
    job_id = job["id"]
    action = job.get("action")
    params, error = validate_params(action, job.get("params") or {})
    if error is not None:
        jobs.append_output(job_id, f"refused: {error}\n")
        jobs.update_job(job_id, state="failed", exit_code=1, finished_at=int(time.time()))
        return 1

    # engine_save (and the save half of the composite action) writes a file
    # rather than running a command; do that first so a bad write fails the
    # whole job before any command runs.
    if action in ("engine_save", "engine_save_apply_restart"):
        try:
            write_engine_env(params["settings"])
        except (OSError, ValueError) as exc:
            jobs.append_output(job_id, f"engine_save failed: {exc}\n")
            jobs.update_job(job_id, state="failed", exit_code=1, finished_at=int(time.time()))
            return 1
        jobs.append_output(job_id, "wrote engine.env\n")

    exit_code = 0
    for argv in build_commands(action, params):
        try:
            result = subprocess.run(argv, capture_output=True, text=True, timeout=1800, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            jobs.append_output(job_id, f"failed to run {argv!r}: {exc}\n")
            exit_code = 1
            break
        jobs.append_output(job_id, result.stdout)
        if result.stderr:
            jobs.append_output(job_id, result.stderr)
        exit_code = result.returncode
        if exit_code != 0:
            break

    state = "succeeded" if exit_code == 0 else "failed"
    jobs.update_job(job_id, state=state, exit_code=exit_code, finished_at=int(time.time()))
    return exit_code


def reap_orphans() -> int:
    """Mark any job left `running` (from a crash/restart) as failed.

    A job can only be `running` here because a previous worker claimed it and
    then died before finishing — this process only ever sees `running` jobs
    of its own making, moved there by claim_next just before run_job.
    """
    reaped = 0
    for job in jobs.list_jobs(limit=1000):
        if job.get("state") == "running":
            jobs.append_output(job["id"], "worker restarted; this job did not finish\n")
            jobs.update_job(job["id"], state="failed", exit_code=1, finished_at=int(time.time()))
            reaped += 1
    return reaped


def poll_once() -> None:
    # claim_next is an unlocked read-modify-write; that is safe here only
    # because every mode of main() holds the flock, so at most one worker
    # process ever calls it.
    #
    # It is *inside* the guard, not before it: a raise from claim_next may fail a
    # job or fail this poll, but must never end the daemon. It was outside, and a
    # job file whose `id` disagreed with its filename made claim_next raise
    # KeyError straight past this handler into main's loop — a traceback every
    # interval and no job ever draining again. palwarden_jobs.read_job now refuses
    # that file outright, but the structural point stands regardless of which
    # single bug prompted it.
    job = None
    try:
        job = jobs.claim_next()
        if job is None:
            return
        run_job(job)
    except Exception:  # noqa: BLE001 - one bad job must not stop the queue
        # A job file that vanished between claim and completion makes
        # append_output/update_job raise KeyError. Letting that escape would
        # end the worker's loop and silently stop the whole queue draining, so
        # fail this job (best effort — the file may genuinely be gone) and go
        # on. KeyboardInterrupt/SystemExit are BaseException and still escape.
        traceback.print_exc()
        if job is None:
            # The failure was in claim_next itself, so there is no claimed job to
            # record it on. Logged and swallowed: the next poll retries.
            return
        try:
            # Say *something* on the job itself: the traceback only goes to the
            # service log, and a job that flipped to "failed" with no output at
            # all is indistinguishable in the UI from a tool that printed nothing.
            jobs.append_output(job["id"],
                               "worker hit an internal error; see the service log\n")
        except Exception:  # noqa: BLE001 - the job file may genuinely be gone
            pass
        try:
            jobs.update_job(job["id"], state="failed", exit_code=1,
                            finished_at=int(time.time()))
        except Exception:  # noqa: BLE001 - nothing left to record it on
            pass


def acquire_lock() -> int | None:
    """Take the exclusive, non-blocking worker lock, or None if already held.

    *Every* mode takes it, not just the daemon loop: reap_orphans cannot tell a
    live sibling's `running` job from a crashed one, so a stray `--once`/`--reap`
    would mark a 20-minute update_apply as failed while it kept running, and
    would race the daemon in claim_next.
    """
    # Opening the lock is now on the path of *every* mode, including the one-shots
    # an operator may try by hand. The default lives in /run, which only root can
    # write, so a non-root invocation used to die with a raw PermissionError
    # traceback; say what is actually wrong instead.
    try:
        JOBD_LOCK.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(JOBD_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError as exc:
        raise SystemExit(
            f"cannot open lock {JOBD_LOCK}: {exc.strerror}; "
            "palwarden-jobd must run as root") from exc
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="palwarden-jobd",
        description="Root worker for the palwarden web UI job queue.")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--once", action="store_true",
                      help="reap, run at most one queued job, prune, exit")
    mode.add_argument("--reap", action="store_true",
                      help="mark jobs left running by a crash as failed, then exit")
    args = ap.parse_args(argv)

    # The lock is held for the life of the process in all three modes, so a
    # second worker can never run concurrently — that exclusivity is what makes
    # claim_next's unlocked read-then-write safe. Reaping only happens once we
    # hold it: reaping before could mark a job "failed" that a still-running
    # sibling worker legitimately owns.
    lock_fd = acquire_lock()
    if lock_fd is None:
        print(f"another palwarden-jobd holds {JOBD_LOCK}; exiting", file=sys.stderr)
        return 1

    if args.reap:
        reap_orphans()
        return 0
    if args.once:
        reap_orphans()
        poll_once()
        jobs.prune()
        return 0

    reap_orphans()
    while True:
        # Belt and braces around poll_once's own guard: a failure in
        # claim_next/prune (a corrupt directory, a full disk) must also not end
        # the loop.
        try:
            poll_once()
            jobs.prune()
        except Exception:  # noqa: BLE001 - keep draining the queue
            traceback.print_exc()
        time.sleep(JOBD_INTERVAL)


if __name__ == "__main__":
    raise SystemExit(main())
