#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
"""Root worker for the web UI control plane's job queue.

Runs as root. Its only input is a job file dropped in `PALWARDEN_JOBS_DIR` by
`palwarden-webui`, which runs unprivileged and is treated as untrusted: a bug
in that HTTP handler, or a hand-edited job file, must not be able to run
anything this worker did not itself validate. So every action name and every
parameter is re-checked here, from scratch, against a fixed allowlist — the
job file's contents are a *request*, never a command.

Every action maps to a fixed argv list built from typed, validated slots.
Nothing is ever passed through a shell, and no parameter is ever interpolated
into a string that reaches one.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import importlib.machinery
import importlib.util
import os
import re
import secrets
import select
import subprocess
import sys
import time
import traceback
from pathlib import Path

# Mirror how palworld-health-report locates palworld-fps: prepend the
# bare-metal lib dir and the repo's lib/ so `palwarden_jobs` resolves in both
# installed and dev-checkout layouts (tests set PYTHONPATH instead).
sys.path.insert(0, "/usr/local/lib")
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import palwarden_archive as archive  # noqa: E402
import palwarden_jobs as jobs  # noqa: E402

SBIN = Path(os.environ.get("PALWARDEN_SBIN_DIR", "/usr/local/sbin"))
ENGINE_ENV = Path(os.environ.get("PALWORLD_ENGINE_ENV", "/etc/palworld/engine.env"))
BACKUP_DIR = Path(os.environ.get("PALWORLD_BACKUP_DIR", "/opt/palworld/config-backups"))
# Staged uploads, written by palwarden-webui as the unprivileged service account —
# so every name and every entry in here is attacker-influenced (see validate_staged).
UPLOAD_DIR = Path(os.environ.get("PALWARDEN_UPLOAD_DIR", "/var/lib/palworld/uploads"))
# The *save*-archive directory. Deliberately the same variable palworld-backup
# writes to, palworld-restore imports into and palwarden-webui lists, because
# PALWORLD_BACKUP_DIR above already means *config* backups in this repo — the two
# are different directories with different contents, and conflating them is exactly
# the mistake validate_save_archive exists to avoid.
SAVE_BACKUP_DIR = Path(os.environ.get("PALWARDEN_SAVE_BACKUP_DIR", "/opt/palworld/backups"))
# The scheduled-backup settings file, written only here (as root) and read by
# palworld-backups' tick. Same variable that tool uses, so one override moves the
# writer and the reader together.
SCHEDULE_ENV = Path(os.environ.get("PALWORLD_BACKUP_SCHEDULE", "/etc/palworld/backup.env"))
# UI-saved PalWorldSettings values, written by settings_save and applied *after*
# settings.env by palworld-config-apply-env — same variable that script reads, so
# one override moves the writer and the reader together. Like the backup schedule,
# the compose file points this at the palwarden-state volume; the bare-metal
# default under /etc/palworld is genuinely persistent on a real host.
SETTINGS_OVERRIDES = Path(os.environ.get(
    "PALWORLD_SETTINGS_OVERRIDES", "/etc/palworld/settings-overrides.env"))
# The live game config: settings_save validates every requested key and value
# against the shapes *actually in this file* (the same schema config_apply will
# use), so a value that would be silently dropped at apply time is refused at
# the form instead. Same variable palwarden-webui and the apply script read.
CONFIG_FILE = Path(os.environ.get(
    "PALWORLD_CONFIG_FILE",
    "/opt/palworld/server/Pal/Saved/Config/LinuxServer/PalWorldSettings.ini"))
# Same variable (and the same reasoning) as palwarden-webui's PARSER_BIN: the
# module we load for its key resolver / value renderer is a Python script, not
# one of the stub *commands* PALWARDEN_SBIN_DIR points tests at.
PARSER_BIN = Path(os.environ.get(
    "PALWARDEN_PARSER_BIN", "/usr/local/bin/palworld-config-parser"))
# Deliberately NOT derived from SBIN: SBIN is where *invoked commands* live
# (tests point it at stub binaries), but the module we load here for its
# setting definitions is palwarden-jobd's own neighbour — same directory in
# both the installed layout (/usr/local/sbin) and a dev checkout (repo sbin/).
# Consequence for real deployments: if you set PALWARDEN_SBIN_DIR you must set
# PALWARDEN_ENGINE_CONFIG_BIN to match, or jobd validates settings against one
# copy of palworld-engine-config's table and applies them with another.
ENGINE_CONFIG_BIN = Path(os.environ.get(
    "PALWARDEN_ENGINE_CONFIG_BIN", str(Path(__file__).resolve().parent / "palworld-engine-config")))
JOBD_LOCK = Path(os.environ.get("PALWARDEN_JOBD_LOCK", "/run/palwarden-jobd.lock"))
JOBD_INTERVAL_DEFAULT = 2.0

# The *save-backup* lock, shared with the scheduled tick — the same path
# palworld-backup-auto.service already flocks, and (as of this release) the
# container's backup-auto service too. jobd's own lock only makes the worker
# single, which says nothing about the timer: a panel-driven backup, delete or
# restore could run straight through a scheduled `--if-due --prune`. That is not
# benign. Two backups started in the same UTC second collide on one archive name;
# a prune can unlink the archive a delete is unlinking; and a restore renames the
# whole world tree out from under a tick's tar.
#
# So the four actions that write in the backups directory or move the world take
# this lock for the duration of their command. The tick takes it with `-n` and
# simply skips — a missed tick is recovered by the next one, whereas a panel action
# the operator is watching must not be dropped, so this side WAITS.
BACKUP_LOCK = Path(os.environ.get("PALWARDEN_BACKUP_LOCK", "/run/palworld-backups.lock"))
BACKUP_LOCK_WAIT_DEFAULT = 1800.0

# How long one step of a job may run before it is killed. A ceiling, not a
# budget: a full-world tar or a cross-mount restore copy can legitimately take
# many minutes, and the point of the bound is that a wedged step does not hold
# the worker forever. `_run_step` records the step's output as it arrives, so
# reaching this is diagnosable rather than silent. Overridable so an operator
# whose world takes longer than this to copy across a mount boundary can raise it
# without a patch - and so the suite can drive the timeout path in one second
# instead of thirty minutes, which is the only reason it was previously untested.
STEP_TIMEOUT = float(archive.env_int("PALWARDEN_JOBD_STEP_TIMEOUT", 1800))
# Only actions that mutate the collection or the world. backup_schedule_save writes
# SCHEDULE_ENV and is deliberately absent: it races nothing (the tick
# re-reads the file each time), and holding a lock across it would let a slow tar
# block the operator from switching backups off.
BACKUP_LOCKED_ACTIONS = frozenset({"backup", "backup_import", "backup_restore", "backup_delete"})


def _interval_from_env(raw: str | None) -> float:
    """Poll interval from the environment, tolerating a bad value.

    A typo in a unit file or compose env must not turn into a traceback at
    import time: that would take out *every* action rather than just slowing
    the loop, so warn and fall back to the default.
    """
    if raw is None or raw.strip() == "":
        return JOBD_INTERVAL_DEFAULT
    try:
        value = float(raw)
    except ValueError:
        value = -1.0
    if value <= 0 or value > 3600:
        print(f"PALWARDEN_JOBD_INTERVAL={raw!r} is not a sane number of seconds; "
              f"using {JOBD_INTERVAL_DEFAULT}", file=sys.stderr)
        return JOBD_INTERVAL_DEFAULT
    return value


JOBD_INTERVAL = _interval_from_env(os.environ.get("PALWARDEN_JOBD_INTERVAL"))

LABEL_RE = re.compile(r"[A-Za-z0-9._-]{1,64}")
# The exact shape palworld-engine-config writes: `Engine.ini.<UTC stamp>` from
# `backup_engine`/`command_apply`, plus `Engine.ini.pre-rollback.<stamp>` from
# `rollback_engine`. Anchoring on that (rather than any name at all) is what
# stops an attacker-chosen file in the web-writable backup dir from being
# rolled into place; see validate_backup.
# The trailing `-<n>` is the de-duplicating suffix write_new_nofollow adds when two
# applies land in the same UTC second; without it those backups would list but
# refuse to roll back.
BACKUP_RE = re.compile(r"Engine\.ini\.(?:pre-rollback\.)?[0-9]{8}T[0-9]{6}Z(?:-[0-9]{1,2})?")

# The scheduled-backup settings, with the design spec's inclusive ranges.
#
# Duplicated from palworld-backups' RANGES/DEFAULTS rather than loaded from that
# script the way SETTING_BY_ENV is loaded from palworld-engine-config, and the
# reason is import safety, not taste: this module is imported by *every* action, so
# a host where palworld-backups is not installed (it ships later than jobd did)
# would lose the whole queue to an ImportError instead of losing one action. The
# two tables must agree — a bound this side accepts and that side rejects would be
# a value the UI saves and the tick then silently replaces with the default — so
# tests/unit/test_jobd.sh asserts they are equal rather than leaving it to comments.
#
# Note the deliberately *different* semantics either side of that shared bound:
# palworld-backups warns and falls back to the default (its tick must keep running),
# while a job here is refused outright (the operator is at a form and can be told).
SCHEDULE_RANGES: dict[str, tuple[int, int]] = {
    "BACKUP_INTERVAL_HOURS": (1, 720),
    "BACKUP_RETENTION_DAYS": (1, 3650),
    "BACKUP_KEEP_MIN": (1, 100),
}
SCHEDULE_BOOL_KEYS = ("BACKUP_ENABLED",)
SCHEDULE_KEYS = SCHEDULE_BOOL_KEYS + tuple(SCHEDULE_RANGES)


def load_engine_config_module():
    """Load palworld-engine-config as a module rather than duplicating its
    settings table: the 15 known engine settings, their types and their
    min/max ranges must live in exactly one place.

    Same pattern as palworld-health-report's load_fps_module / palwarden-webui's
    load_parser_module (hyphenated script names cannot be imported normally).
    """
    loader = importlib.machinery.SourceFileLoader("palwarden_engine_config_for_jobd", str(ENGINE_CONFIG_BIN))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


_engine = load_engine_config_module()
SETTING_BY_ENV = _engine.SETTING_BY_ENV
normalize_value = _engine.normalize_value


def load_parser_module():
    """Load palworld-config-parser for its resolver/renderer, not a copy of them.

    settings_save must agree exactly with what config_apply will later do —
    which env name finds which INI key, what value shape each key accepts, how
    an env file reads back — and the only way two moments in time agree exactly
    is to run the same code at both. Same pattern as load_engine_config_module
    above and palwarden-webui's load_parser_module.
    """
    loader = importlib.machinery.SourceFileLoader("palwarden_cfg_parser_for_jobd", str(PARSER_BIN))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


_parser = load_parser_module()


# --- parameter validators ---------------------------------------------------
# Each raises ValueError with a message safe to surface in job output.


def validate_label(params: dict, key: str = "label") -> str:
    value = params.get(key)
    if not isinstance(value, str) or not LABEL_RE.fullmatch(value):
        raise ValueError(f"{key} must match {LABEL_RE.pattern!r}, got {value!r}")
    return value


def validate_text(params: dict, key: str = "text") -> str:
    value = params.get(key)
    if not isinstance(value, str) or len(value) > 200 or not value.isprintable():
        raise ValueError(f"{key} must be <=200 printable characters")
    return value


def validate_wait(params: dict) -> int | None:
    """Validate the *optional* `wait` seconds.

    Returns None when the caller did not ask for a particular wait, so the argv
    builders can omit `--wait` entirely and let the invoked tool apply its own
    default (palworld-update's is 300s) rather than jobd inventing a second one.
    """
    if "wait" not in params or params.get("wait") is None:
        return None
    value = params["wait"]
    # bool is an int subclass in Python; reject it explicitly so {"wait": true}
    # doesn't silently become wait=1.
    if isinstance(value, bool) or not isinstance(value, int) or not (0 <= value <= 1800):
        raise ValueError(f"wait must be an integer 0-1800, got {value!r}")
    return value


def validate_dry_run(params: dict) -> bool:
    value = params.get("dry_run", False)
    if not isinstance(value, bool):
        raise ValueError(f"dry_run must be a boolean, got {value!r}")
    return value


def validate_backup(params: dict) -> str:
    """Validate a rollback source in the *web-writable* backup directory.

    BACKUP_DIR is owned by the unprivileged web user, so anything in it — names
    and symlinks alike — is attacker-controlled. A rollback ends in "copy
    <backup> over Engine.ini", chown-to-palworld, chmod 0644, so accepting a
    symlink here would publish any root-readable file (settings.env,
    /etc/shadow) to the web user. Hence: never stat through the link before the
    name is validated, reject links outright, and require the exact name shape
    palworld-engine-config itself writes.

    These checks are a *pre-flight*, not the security boundary. jobd validates
    the name and then spawns palworld-engine-config as a separate process, which
    re-resolves it — the entry can be swapped for a symlink inside that window,
    and the attacker can retry by re-enqueueing. What actually closes that race
    is palworld-engine-config opening the source with O_NOFOLLOW (see
    read_backup_nofollow there): a kernel refusal at the moment of use, with no
    check-then-use gap. Refusing here still matters — it fails the job with a
    clear reason instead of relying on the tool's error path.

    A *hardlink* with a legitimate-looking name passes every check below (it is
    a regular file, not a symlink). Considered and deliberately not checked:
    `fs.protected_hardlinks=1` (default on the target distros) stops an
    unprivileged user hardlinking a file it does not own, and the O_NOFOLLOW
    read covers what remains.
    """
    value = params.get("backup")
    if not isinstance(value, str) or "/" in value or "\\" in value:
        raise ValueError(f"backup must be a bare file name, got {value!r}")
    if not BACKUP_RE.fullmatch(value):
        raise ValueError(f"backup must match {BACKUP_RE.pattern!r}, got {value!r}")
    candidate = BACKUP_DIR / value
    # lstat/is_symlink do NOT follow the link, so this decides on the entry
    # itself; is_file() below would have followed it.
    if candidate.is_symlink():
        raise ValueError(f"backup must not be a symlink: {value!r}")
    if not candidate.is_file():
        raise ValueError(f"backup not found: {value!r}")
    # No containment check on the resolved path: with a bare name (no separators)
    # that is not itself a symlink, realpath resolves a symlinked *parent*
    # identically on both sides of any comparison, so such a check could never
    # fire. Containment is structural here; the target's O_NOFOLLOW open is what
    # enforces it at the moment of use.
    return value


def _validate_archive_in(params: dict, key: str, directory: Path, what: str) -> str:
    """Shared body of validate_staged/validate_save_archive: one archive name, in
    one directory, proven to be a plain file we could have written.

    Shared rather than written twice because the *rules* are identical and only the
    directory differs; kept separate from `validate_backup` because its rules are
    genuinely different (a different name pattern, a different directory, a
    different tool consuming it). Widening validate_backup to cover save archives
    would have quietly taught `engine_rollback` to accept a world save.

    Same three-step shape as validate_backup, for the same reasons: never stat
    through a link before the name is known-good, refuse a link outright rather
    than following it, and require the exact name shape palworld-backup writes so
    an attacker-chosen file in a web-writable directory cannot be nominated.

    As there, this is a *pre-flight*, not the security boundary: palworld-restore
    and palworld-backups are separate processes that re-resolve the name and open
    it with O_NOFOLLOW (palwarden_archive.open_archive_fd), which is what closes the
    swap-it-after-the-check window. Refusing here buys a clear failure reason.
    """
    value = params.get(key)
    if not isinstance(value, str) or "/" in value or "\\" in value:
        raise ValueError(f"{key} must be a bare file name, got {value!r}")
    # The one shared rule for "a name palworld-backup could have written", imported
    # rather than re-spelled: palwarden_archive owns it and both the web side and
    # the tools already use it.
    if not archive.valid_archive_name(value):
        raise ValueError(f"{key} must match {archive.ARCHIVE_RE.pattern!r}, got {value!r}")
    candidate = directory / value
    # lstat semantics: decides on the entry itself. is_file() below would follow it.
    if candidate.is_symlink():
        raise ValueError(f"{key} must not be a symlink: {value!r}")
    if not candidate.is_file():
        raise ValueError(f"{key} not found in the {what} directory: {value!r}")
    return value


def validate_staged(params: dict) -> str:
    """Validate an uploaded archive awaiting import, in UPLOAD_DIR.

    UPLOAD_DIR is written by the unprivileged web process, so its contents are
    untrusted in the strongest sense here: the bytes came from a browser.
    """
    return _validate_archive_in(params, "staged", UPLOAD_DIR, "upload")


def validate_save_archive(params: dict) -> str:
    """Validate a world-save archive in SAVE_BACKUP_DIR (restore/delete source).

    Separate from validate_staged only in *which* directory the name must exist in,
    and that distinction is the point: a name that has merely been uploaded must not
    be restorable or deletable until `backup_import` has promoted it into the
    root-owned backups directory.
    """
    return _validate_archive_in(params, "backup", SAVE_BACKUP_DIR, "backups")


def validate_message(params: dict) -> str | None:
    # message is optional; validate only when present.
    if "message" not in params or params.get("message") is None:
        return None
    return validate_text(params, "message")


def validate_settings(params: dict) -> dict[str, str]:
    raw = params.get("settings")
    if not isinstance(raw, dict) or not raw:
        raise ValueError("settings must be a non-empty object")
    normalised: dict[str, str] = {}
    for key, value in raw.items():
        setting = SETTING_BY_ENV.get(key)
        if setting is None:
            raise ValueError(f"unknown engine setting: {key!r}")
        # A JSON UI naturally posts numbers as numbers, so accept int/float and
        # coerce to the string form normalize_value parses. bool is an int
        # subclass — reject it explicitly rather than storing True as "1".
        if isinstance(value, bool) or not isinstance(value, (str, int, float)):
            raise ValueError(f"{key} value must be a string or number, got {value!r}")
        normalised[key] = normalize_value(setting, str(value))
    return normalised


# PalWorldSettings has ~119 keys; the whole form is well under this. The cap is
# a body-size backstop like the API's 64 KiB limit, not a schema.
GAME_SETTINGS_MAX = 200
GAME_KEY_RE = re.compile(r"[A-Za-z][A-Za-z0-9_]{0,63}")
# Keys the web UI must never write, normalised: the REST API is the control
# plane's own lifeline — graceful save-on-stop, telemetry, health, the update
# flow all ride on it. A settings_save of RESTAPIEnabled=False would land in
# the overrides file, which is applied *after* settings.env on every boot, so
# one browser click would force the API off permanently and cut off the very
# tooling the operator would use to recover. These stay managed through
# settings.env (ADMIN_PASSWORD implies REST on; PALWORLD_REST_PORT sets the
# port), exactly like the password keys in _parser.SECRET_KEYS.
REST_LIFELINE_KEYS = frozenset({"restapienabled", "restapiport"})


def validate_game_settings(params: dict) -> dict[str, str]:
    """Validate PalWorldSettings values against the live config's own shape.

    Unlike validate_settings (engine), there is no hardcoded table of the game's
    ~119 keys to rot: the live PalWorldSettings.ini *is* the schema, exactly as
    it is for palworld-config-parser at apply time — and it is that parser's own
    resolver and renderer doing the checking here, so "refused at the form" and
    "would have been dropped at apply" can never disagree. Returns
    {canonical INI key: raw value string} ready for the overrides env file.

    The two password keys are refused outright: they are managed through
    settings.env (rendered from ADMIN_PASSWORD at container start), the UI
    redacts them on read, and the overrides file is deliberately 0644 tuning,
    not a secret store. The REST API keys are refused too — see
    REST_LIFELINE_KEYS on why a browser must not be able to cut the control
    plane's own management path.
    """
    raw = params.get("settings")
    if not isinstance(raw, dict) or not raw:
        raise ValueError("settings must be a non-empty object")
    if len(raw) > GAME_SETTINGS_MAX:
        raise ValueError(f"settings carries {len(raw)} keys; refusing more than {GAME_SETTINGS_MAX}")
    try:
        text = CONFIG_FILE.read_text(errors="ignore")
    except OSError as exc:
        raise ValueError(
            f"cannot read {CONFIG_FILE} to validate against ({exc.strerror}); "
            "the apply would fail the same way") from None
    match = re.search(r"^OptionSettings=\((.*)\)[ \t]*$", text, re.MULTILINE)
    if match is None:
        raise ValueError(f"no OptionSettings=(...) line in {CONFIG_FILE}")
    parts = _parser.split_settings(match.group(1))
    keys, by_norm = _parser.index_keys(parts)
    normalised: dict[str, str] = {}
    for key, value in raw.items():
        if not isinstance(key, str) or not GAME_KEY_RE.fullmatch(key):
            raise ValueError(f"setting names must match {GAME_KEY_RE.pattern!r}, got {key!r}")
        # A JSON UI naturally posts numbers as numbers; bool is an int subclass,
        # rejected explicitly rather than stored as "True"/"1" by accident.
        if isinstance(value, bool) or not isinstance(value, (str, int, float)):
            raise ValueError(f"{key} value must be a string or number, got {value!r}")
        value = str(value)
        if len(value) > 256 or not (value == "" or value.isprintable()):
            raise ValueError(f"{key} value must be <=256 printable characters")
        ini_key = _parser.EXCEPTIONS.get(key) or by_norm.get(_parser.normalise(key))
        if ini_key is None or ini_key not in keys:
            raise ValueError(f"no matching Palworld setting for {key!r} in the live config")
        if _parser.normalise(ini_key) in _parser.SECRET_KEYS:
            raise ValueError(f"{ini_key} is managed via settings.env, not the web UI")
        if _parser.normalise(ini_key) in REST_LIFELINE_KEYS:
            raise ValueError(
                f"{ini_key} is the control plane's own management path and cannot be "
                "changed from the web UI (it would cut off telemetry, graceful "
                "save-on-stop and updates); it is managed via settings.env "
                "(ADMIN_PASSWORD / PALWORLD_REST_PORT)")
        if ini_key in normalised:
            raise ValueError(f"{key!r} resolves to {ini_key}, which the request already sets")
        _, _, old_raw = parts[keys[ini_key]].partition("=")
        _, error = _parser.render_value(ini_key, old_raw, value)
        if error is not None:
            raise ValueError(error)
        normalised[ini_key] = value
    return normalised


def validate_schedule(params: dict) -> dict[str, str]:
    """Validate the scheduled-backup settings, returning env-file strings.

    validate_settings' shape, over the four schedule keys instead of the engine
    table, and deliberately *not* that function with a second table bolted on: the
    two write different files with different consumers, and one function serving
    both would let an engine key be posted to the schedule form (or the reverse) and
    be accepted.

    Unknown keys are named in the error rather than dropped, for the reason
    validate_params gives about `waitt`: a caller that posted BACKUP_INTERVAL_HOUR
    meant something by it, and a schedule that silently kept the old interval is
    worse than one that was refused.
    """
    raw = params.get("settings")
    if not isinstance(raw, dict) or not raw:
        raise ValueError("settings must be a non-empty object")
    normalised: dict[str, str] = {}
    for key, value in raw.items():
        if key not in SCHEDULE_KEYS:
            raise ValueError(f"unknown backup schedule setting: {key!r}")
        if key in SCHEDULE_BOOL_KEYS:
            # A real JSON boolean only. "true"/1 are exactly the shape
            # require_confirm refuses for the same reason: a checkbox posts a
            # boolean, and anything else came from something that guessed.
            if not isinstance(value, bool):
                raise ValueError(f"{key} must be a boolean, got {value!r}")
            # palworld-backups' reader accepts 1/true/yes/on; write the word so the
            # file is readable by the operator who ends up cat'ing it.
            normalised[key] = "true" if value else "false"
            continue
        low, high = SCHEDULE_RANGES[key]
        # bool is an int subclass, and a float hour is meaningless here; accept an
        # int or the digit string a form field sends, nothing else.
        if isinstance(value, bool) or not isinstance(value, (int, str)):
            raise ValueError(f"{key} must be an integer {low}-{high}, got {value!r}")
        # int() is more permissive than a form field can be: int("6_0") is 60 and
        # int(" 6 ") is 6, so a client posting "6_0" would silently save 60 hours
        # rather than being refused. Require plain digits from the string branch.
        if isinstance(value, str) and not re.fullmatch(r"[0-9]+", value):
            raise ValueError(f"{key} must be an integer {low}-{high}, got {value!r}")
        try:
            number = int(value)
        except ValueError:
            raise ValueError(f"{key} must be an integer {low}-{high}, got {value!r}") from None
        if not low <= number <= high:
            raise ValueError(f"{key} must be an integer {low}-{high}, got {number}")
        normalised[key] = str(number)
    # All four or nothing, because write_backup_schedule *replaces* the file: a
    # partial post would silently revert the keys it left out to palworld-backups'
    # defaults, which is how a 90-day retention becomes 14 days without anyone
    # touching that field. The form posts all four; anything that does not is either
    # a bug or not the form, and both deserve to be told.
    missing = [key for key in SCHEDULE_KEYS if key not in normalised]
    if missing:
        raise ValueError("the backup schedule must be saved whole; missing "
                         + ", ".join(repr(key) for key in missing))
    return normalised


def require_confirm(params: dict) -> None:
    if params.get("confirm") is not True:
        raise ValueError("disruptive action requires confirm: true")


# --- engine_save: the one action that writes a file instead of running a
# command ---------------------------------------------------------------


def _read_nofollow_text(path: Path) -> str | None:
    """Read `path` through an O_NOFOLLOW descriptor. None when it does not exist.

    A missing engine.env is normal (nothing has been saved yet), so it is None
    rather than an error; a symlink at that name is refused by the kernel.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "r") as fh:  # fdopen takes ownership of the fd
        return fh.read()


class _AlreadyRead:
    """Text pretending to be a Path, for palworld-engine-config's parse_env.

    parse_env(path) only ever calls `path.read_text(errors=...)`, so handing it
    this lets write_engine_env verify through a descriptor it opened O_NOFOLLOW
    instead of re-opening engine.env by name, while still using the *one* env
    parser rather than a second copy of it.
    """

    def __init__(self, text: str) -> None:
        self._text = text

    def read_text(self, *_args, **_kwargs) -> str:
        return self._text


def write_engine_env(settings: dict[str, str]) -> None:
    """Atomically merge already-normalised settings into ENGINE_ENV.

    A *merge*, not a replace: engine.env is the set of values
    `palworld-engine-config apply` manages and its drift check compares against.
    Dropping a key the request happened not to include would silently unmanage
    it — apply would stop enforcing it, the drift check would go blind to it,
    and Engine.ini would keep the stale value.

    Never destroys an existing file on failure: write a temp file in the same
    directory, rename it into place, then re-read and re-parse it to confirm
    the result is sane before declaring success.
    """
    # 0755 to match how /etc/palworld is created elsewhere (install.sh's
    # `install -d -m 0755`); engine.env is tuning, not a secret.
    ENGINE_ENV.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    # Same reader palworld-engine-config uses, so "what is currently managed"
    # means exactly what apply would see (unknown keys are not ours to keep).
    # Read through an O_NOFOLLOW descriptor, like the verify read below. /etc/palworld
    # is root:root 0755 so nothing can plant here today, and parse_env filters to the
    # 15 known keys either way — but one function reading by path and writing by
    # descriptor reads as an oversight, and this is the file that taught us the
    # difference.
    merged: dict[str, str] = {}
    existing = _read_nofollow_text(ENGINE_ENV)
    if existing is not None:
        merged.update(_engine.parse_env(_AlreadyRead(existing)))
    merged.update(settings)
    lines = [
        "# Generated by palwarden-jobd (engine_save). Do not edit by hand;",
        "# use the Engine.ini performance editor instead.",
        f"# Written: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
        "",
    ]
    for key, value in sorted(merged.items()):
        lines.append(f"{key}={value}")
    text = "\n".join(lines) + "\n"

    # Unguessable temp name, O_CREAT|O_EXCL|O_NOFOLLOW, and fchmod on the
    # descriptor rather than chmod on the name — the same shape as
    # palwarden_jobs._write and palworld-engine-config's write_new_nofollow.
    # /etc/palworld is root:root 0755 today, so nothing can plant a link at a fixed
    # "engine.env.tmp" and there is no live escalation here; this closes the
    # *pattern* rather than an instance. It was the last check-then-use-by-path
    # write left in a confirm-free action (engine_save is not disruptive), and it
    # cost nothing to remove: a fixed name would be plantable the moment anything
    # ever loosened /etc/palworld, and it also collided between two concurrent
    # writers.
    tmp = ENGINE_ENV.with_name(f"{ENGINE_ENV.name}.tmp.{os.getpid()}.{secrets.token_hex(4)}")
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o644)
    try:
        os.fchmod(fd, 0o644)  # belt-and-braces: independent of umask
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        # rename(2) replaces a symlink at the destination rather than writing
        # through it, so the destination needs no separate guard.
        tmp.replace(ENGINE_ENV)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise

    # Confirm the file we just wrote actually parses back to what we wrote —
    # a self-check against a corrupt/truncated write, using the same reader
    # palworld-engine-config uses (one parser, not a second copy). Read back
    # through a descriptor we opened O_NOFOLLOW rather than by path: re-opening
    # the name is exactly the check-then-use gap the temp write above just closed,
    # and a symlink swapped in here would make the round-trip check validate some
    # other file entirely (or pass while engine.env is wrong).
    verify_fd = os.open(ENGINE_ENV, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(verify_fd, "r") as fh:  # fdopen takes ownership of the fd
        written = fh.read()
    # Still exactly palworld-engine-config's parse_env — one parser, not a second
    # copy — fed the bytes we read from the descriptor. parse_env's only use of its
    # argument is `.read_text(errors=...)`, so a one-method stand-in is enough to
    # decouple it from re-opening the name.
    reparsed = _engine.parse_env(_AlreadyRead(written))
    for key, value in merged.items():
        if reparsed.get(key) != value:
            raise ValueError(f"engine.env write did not round-trip for {key}")


def write_settings_overrides(settings: dict[str, str]) -> None:
    """Atomically merge already-validated game settings into SETTINGS_OVERRIDES.

    The same contract as write_engine_env, for the same reasons: a *merge*
    (dropping a key the request happened not to include would silently unmanage
    it — the next config_apply would stop asserting it and an env-driven or
    game-rewritten value would win), never destructive on failure, and verified
    by re-reading what landed through the *consumer's own reader* —
    palworld-config-parser's read_env_file, the exact function config_apply
    will feed this file to.

    Values are always written quoted (read_env_file unquotes and unescapes with
    the mirror of _parser.escape), so a value containing spaces, `#` or quotes
    round-trips byte-for-byte instead of depending on env-file lexing luck.
    """
    SETTINGS_OVERRIDES.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    merged: dict[str, str] = {}
    existing = _read_nofollow_text(SETTINGS_OVERRIDES)
    if existing is not None:
        merged.update(_parser.read_env_file(_AlreadyRead(existing)))
    merged.update(settings)
    lines = [
        "# Generated by palwarden-jobd (settings_save). Do not edit by hand;",
        "# use the PalWorld settings editor instead. Applied after settings.env",
        "# by palworld-config-apply-env, so these values win over PALWORLD_CFG_*.",
        f"# Written: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
        "",
    ]
    for key, value in sorted(merged.items()):
        lines.append(f'{key}="{_parser.escape(value)}"')
    text = "\n".join(lines) + "\n"

    # Same shape as write_engine_env's temp write, and for the same reasons:
    # unguessable name, O_CREAT|O_EXCL|O_NOFOLLOW, fchmod on the descriptor.
    # 0644 on purpose — validate_game_settings refuses the password keys, so
    # this file is tuning, never a secret store.
    tmp = SETTINGS_OVERRIDES.with_name(
        f"{SETTINGS_OVERRIDES.name}.tmp.{os.getpid()}.{secrets.token_hex(4)}")
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o644)
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        tmp.replace(SETTINGS_OVERRIDES)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise

    # Round-trip through an O_NOFOLLOW descriptor, exactly like write_engine_env.
    verify_fd = os.open(SETTINGS_OVERRIDES, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(verify_fd, "r") as fh:  # fdopen takes ownership of the fd
        written = fh.read()
    reparsed = _parser.read_env_file(_AlreadyRead(written))
    for key, value in merged.items():
        if reparsed.get(key) != value:
            raise ValueError(f"settings overrides write did not round-trip for {key}")


def _parse_schedule_text(text: str) -> dict[str, str]:
    """Our four keys as raw strings, from env-file text. Ignores anything else.

    A local parser rather than palworld-backups' `read_schedule`, and not because
    that one is unavailable: `read_schedule` is a *repairing* reader — it swallows a
    bad value and substitutes the default so the tick can never stop — so a
    truncated or corrupt write would verify perfectly green through it. A verifier
    has to be able to say "that is not what I wrote", which is the opposite
    contract. Same tolerances as palworld-engine-config's parse_env otherwise.
    """
    values: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key in SCHEDULE_KEYS:
            values[key] = value.strip().strip('"').strip("'")
    return values


def write_backup_schedule(settings: dict[str, str]) -> None:
    """Atomically write already-normalised schedule values to SCHEDULE_ENV.

    A *replace*, not a merge — the one place this deliberately differs from
    write_engine_env, which merges. Two reasons, and both have to hold: the schedule
    form always posts all four keys (validate_schedule refuses a partial save, so a
    key can never go missing here), and unlike engine.env there is no second writer
    whose values a replace could drop — nothing else writes this file, and
    palworld-backups only ever reads it. Given that, a merge would only add a way for
    a stale key to survive a save that meant to remove it.

    Otherwise identical to write_engine_env, on purpose: unguessable temp name,
    O_CREAT|O_EXCL|O_WRONLY|O_NOFOLLOW, fchmod on the descriptor, rename into place,
    then read the result back through an O_NOFOLLOW descriptor and re-parse it. Never
    destroys the existing schedule on failure — a host that fails a save keeps
    backing up on the settings it had.
    """
    # 0755 like /etc/palworld is created elsewhere; the schedule is tuning, not a
    # secret (0644 below, matching what palworld-backups documents it as).
    SCHEDULE_ENV.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    lines = [
        "# Generated by palwarden-jobd (backup_schedule_save). Do not edit by hand;",
        "# use the backup panel instead.",
        f"# Written: {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
        "",
    ]
    for key, value in sorted(settings.items()):
        lines.append(f"{key}={value}")
    text = "\n".join(lines) + "\n"

    tmp = SCHEDULE_ENV.with_name(
        f"{SCHEDULE_ENV.name}.tmp.{os.getpid()}.{secrets.token_hex(4)}")
    fd = os.open(tmp, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o644)
    try:
        os.fchmod(fd, 0o644)  # independent of umask
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        # rename(2) replaces a symlink at the destination rather than writing
        # through it, so the destination needs no separate guard.
        tmp.replace(SCHEDULE_ENV)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise

    verify_fd = os.open(SCHEDULE_ENV, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(verify_fd, "r") as fh:  # fdopen takes ownership of the fd
        written = fh.read()
    reparsed = _parse_schedule_text(written)
    for key, value in settings.items():
        if reparsed.get(key) != value:
            raise ValueError(f"backup.env write did not round-trip for {key}")


# --- action table ------------------------------------------------------------
# Each entry maps to argv(params) -> list of argv lists, run in order, plus
# whether the action is disruptive (requires confirm) and the exact set of
# parameter names the action recognises. engine_save and backup_schedule_save have
# no command at all — they only write a file — so they are handled separately in
# build_commands/run_job.
#
# Every action runs as root, the uid this worker already has. A `drop_priv` flag
# on the file-only actions (mark, snapshot_create, config_pretty) was tried and
# reverted: it was justified by root leaving root-owned SQLite `-wal`/`-shm` side
# files that unprivileged fps-samples could then not write, but SQLite's
# robustFchown() (os_unix.c) chowns both side files to the *database's* owner when
# it is running as root, precisely so the original owner keeps working — measured,
# then confirmed in the source. Dropping privilege instead *created* a bare-metal
# failure: palworld-fps-sample.service has no User=, so root created
# /var/lib/palworld/metrics.sqlite3 on first use and a `mark` dropped to the
# service account then died on every write with "attempt to write a readonly
# database" (every connect() runs PRAGMA journal_mode=WAL, which is a write).
#
# Half of that condition is now gone: install.sh pre-creates the DB owned by the
# service account, exactly as the container entrypoint already did, because the
# *unprivileged* side needed it — palwarden-webui runs as $SVC_USER and its
# /api/fps, /api/events, /api/service-events and /api/health all open the same DB.
# A root-created DB degraded three read endpoints on every fresh bare-metal
# install. The other half stands: palworld-fps-sample.service still has no `User=`,
# so root remains a legitimate writer, and robustFchown is what keeps the two
# compatible. Re-introducing drop_priv would still need that unit changed first.
#
# Ownership of an action's *outputs* is the individual tool's job, done on the
# descriptor it wrote — see palworld-config-pretty's fchown. It is deliberately
# *not* done for snapshots or save backups: those roots are root-owned precisely
# so root never writes an attacker-nameable path (see palworld-config-snapshot).
#
# `params` is a whitelist, not documentation: validate_params refuses any key
# not listed (plus `confirm`, which every disruptive action takes) and builds the
# normalised dict from these names alone. Both halves matter. Copying the request
# through meant a typo'd `waitt: 30` was silently ignored instead of reported,
# and it let an authenticated caller store arbitrary JSON in the queue — the API
# accepts a 64 KiB body, so that was 64 KiB of junk written to disk per request.
# Fixing it here rather than in palwarden-webui fixes the API too: the web
# process enqueues whatever this function returns, and the worker is the side
# that must not trust the queue.


def _argv_config_apply(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-config-apply-env")]]


def _argv_engine_apply(params: dict) -> list[list[str]]:
    dry_run = validate_dry_run(params)
    argv = [str(SBIN / "palworld-engine-config"), "apply"]
    if dry_run:
        argv.append("--dry-run")
    return [argv]


def _argv_config_pretty(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-config-pretty")]]


def _argv_snapshot_create(params: dict) -> list[list[str]]:
    label = validate_label(params)
    # `--` before every parameter-derived positional: `-` is a legal label
    # character and `text` only has to be printable, so a value like "--no-mark"
    # would otherwise be parsed as an *option* by the target's argparse.
    return [[str(SBIN / "palworld-config-snapshot"), "create", "--", label]]


def _argv_backup(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-backup")]]


def _argv_mark(params: dict) -> list[list[str]]:
    text = validate_text(params)
    # --category must precede the `--`: argparse treats *everything* after the
    # terminator as positional, so `mark -- <text> --category manual` fails.
    return [[str(SBIN / "palworld-fps"), "mark", "--category", "manual", "--", text]]


def _argv_graceful_restart(params: dict) -> list[list[str]]:
    wait = validate_wait(params)
    message = validate_message(params)
    argv = [str(SBIN / "palworld-graceful-restart")]
    if wait is not None:  # absent wait: let the tool's own default stand
        argv += ["--wait", str(wait)]
    if message is not None:
        # No `--` protects an option *value*: a terminator can only mark the end
        # of options, so a flag-shaped message ("--force") is safe here purely
        # because of what the targets do with it — not because of anything jobd
        # can add. Current chain: palworld-graceful-restart →
        # palworld-graceful-stop → palworld-api-stop → palworld-api, every hop
        # bash positionals, and the message itself ends up in an environment
        # variable consumed by json.dumps. No argparse, no shell interpolation.
        # That is a property of today's targets, not an invariant: if any of them
        # becomes argparse-based, the fix is the single-token `--message=<value>`
        # form (argparse never treats the value as a separate option), not a `--`.
        argv += ["--message", message]
    return [argv]


def _argv_graceful_stop(params: dict) -> list[list[str]]:
    wait = validate_wait(params)
    message = validate_message(params)
    argv = [str(SBIN / "palworld-graceful-stop")]
    if wait is not None:
        argv += ["--wait", str(wait)]
    if message is not None:
        argv += ["--message", message]  # see _argv_graceful_restart on `--`
    return [argv]


def _argv_update_check(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-update"), "--check"]]


def _argv_update_apply(params: dict) -> list[list[str]]:
    wait = validate_wait(params)
    argv = [str(SBIN / "palworld-update")]
    if wait is not None:  # else palworld-update's own default (300s) applies
        argv += ["--wait", str(wait)]
    return [argv]


def _argv_engine_rollback(params: dict) -> list[list[str]]:
    backup = validate_backup(params)
    return [[str(SBIN / "palworld-engine-config"), "rollback", "--", backup]]


def _argv_api_save(_params: dict) -> list[list[str]]:
    return [[str(SBIN / "palworld-api-save")]]


def _argv_engine_save_apply_restart(params: dict) -> list[list[str]]:
    # engine_save itself writes no command (build_commands handles it before
    # calling here); this only builds the restart that follows. The apply runs
    # *inside* the restart (--apply-engine), after the server has fully
    # stopped: the game rewrites its config files from memory as it exits, so
    # an apply issued while it still runs is silently clobbered mid-shutdown.
    wait = validate_wait(params)
    restart = [str(SBIN / "palworld-graceful-restart"), "--apply-engine"]
    if wait is not None:
        restart += ["--wait", str(wait)]
    return [restart]


def _argv_settings_save_apply_restart(params: dict) -> list[list[str]]:
    # settings_save itself writes no command (build_commands handles the file
    # write before calling here); this builds the restart that follows. The
    # apply runs *inside* the restart (--apply-config), after the server has
    # fully stopped — the game rewrites its config from memory as it exits, so
    # an apply issued while it still runs is silently clobbered mid-shutdown
    # (observed on v1.0.3). The apply script applies settings.env first and the
    # overrides file just written second, so the operator's values win.
    wait = validate_wait(params)
    restart = [str(SBIN / "palworld-graceful-restart"), "--apply-config"]
    if wait is not None:
        restart += ["--wait", str(wait)]
    return [restart]


def _argv_backup_import(params: dict) -> list[list[str]]:
    staged = validate_staged(params)
    # No `--` before the name, and that is not an oversight: the name is the *value*
    # of `--import`, and `--import -- <name>` makes argparse fail with "expected one
    # argument" (a terminator can only mark the end of options, never sit between an
    # option and its value). The repo's `--` convention applies to positionals, as in
    # _argv_snapshot_create above. Nothing is lost: valid_archive_name pins the name
    # to `palworld-save-<stamp>.tar.gz`, which cannot be flag-shaped.
    return [[str(SBIN / "palworld-restore"), "--import", staged]]


def _argv_backup_restore(params: dict) -> list[list[str]]:
    name = validate_save_archive(params)
    wait = validate_wait(params)
    argv = [str(SBIN / "palworld-restore"), "--restore", name]
    if wait is not None:  # absent wait: palworld-restore's own default stands
        argv += ["--wait", str(wait)]
    return [argv]


def _argv_backup_delete(params: dict) -> list[list[str]]:
    name = validate_save_archive(params)
    return [[str(SBIN / "palworld-backups"), "--delete", name]]


ACTIONS: dict[str, dict] = {
    "config_apply": {"argv": _argv_config_apply, "disruptive": False, "params": ()},
    "engine_apply": {"argv": _argv_engine_apply, "disruptive": False, "params": ("dry_run",)},
    "config_pretty": {"argv": _argv_config_pretty, "disruptive": False, "params": ()},
    "snapshot_create": {"argv": _argv_snapshot_create, "disruptive": False,
                        "params": ("label",)},
    "backup": {"argv": _argv_backup, "disruptive": False, "params": ()},
    "mark": {"argv": _argv_mark, "disruptive": False, "params": ("text",)},
    "engine_save": {"argv": None, "disruptive": False, "params": ("settings",)},
    # The PalWorldSettings twins of engine_save / engine_save_apply_restart:
    # same file-write-first shape, different validator and different env file.
    "settings_save": {"argv": None, "disruptive": False, "params": ("settings",)},
    "settings_save_apply_restart": {"argv": _argv_settings_save_apply_restart,
                                    "disruptive": True, "params": ("settings", "wait")},
    "graceful_restart": {"argv": _argv_graceful_restart, "disruptive": True,
                         "params": ("wait", "message")},
    "graceful_stop": {"argv": _argv_graceful_stop, "disruptive": True,
                      "params": ("wait", "message")},
    "update_check": {"argv": _argv_update_check, "disruptive": True, "params": ()},
    "update_apply": {"argv": _argv_update_apply, "disruptive": True, "params": ("wait",)},
    "engine_rollback": {"argv": _argv_engine_rollback, "disruptive": True,
                        "params": ("backup",)},
    "api_save": {"argv": _argv_api_save, "disruptive": True, "params": ()},
    "engine_save_apply_restart": {"argv": _argv_engine_save_apply_restart, "disruptive": True,
                                  "params": ("settings", "wait")},
    # Promoting an upload into the backups directory stops nothing and destroys
    # nothing, so it is not disruptive — the archive it creates is additive.
    "backup_import": {"argv": _argv_backup_import, "disruptive": False,
                      "params": ("staged",)},
    "backup_restore": {"argv": _argv_backup_restore, "disruptive": True,
                       "params": ("backup", "wait")},
    # Disruptive despite stopping no service. The flag gates *irreversible* actions
    # behind confirm: true, not slow ones, and deleting the archive that would have
    # recovered the world is the least reversible thing in this project — there is no
    # rollback, no second copy, and the operator finds out at the moment they needed
    # it. palworld-backups --delete has no retention floor for exactly the same
    # reason it is gated here.
    "backup_delete": {"argv": _argv_backup_delete, "disruptive": True,
                      "params": ("backup",)},
    "backup_schedule_save": {"argv": None, "disruptive": False, "params": ("settings",)},
}


def recognised_params(action: str) -> frozenset[str]:
    """Every parameter name `action` accepts, `confirm` included where it applies."""
    spec = ACTIONS[action]
    names = set(spec["params"])
    if spec["disruptive"]:
        # Not listed per action: it is required of *all* of them, and forgetting
        # it in one entry would make that action unenqueueable.
        names.add("confirm")
    return frozenset(names)


def validate_params(action: str, params: dict) -> tuple[dict | None, str | None]:
    """Re-validate action + params from scratch. Returns (normalised_params, error).

    Exactly one of the two return slots is populated. Never trust that params
    already passed validation elsewhere (the API, or an earlier version of this
    same job file) — the job file is untrusted input.

    The returned dict is built key by key from the action's whitelist, so it
    contains recognised, normalised values and nothing else. An unrecognised key
    is an *error* rather than a silent drop: a caller that wrote `waitt` meant
    something by it, and a restart that quietly ignored the wait it was asked for
    is worse than one that was refused.
    """
    spec = ACTIONS.get(action)
    if spec is None:
        return None, f"{action!r} is not an allowed action"
    if not isinstance(params, dict):
        return None, "params must be an object"
    unknown = sorted(k for k in params if k not in recognised_params(action))
    if unknown:
        allowed = ", ".join(sorted(recognised_params(action))) or "no parameters"
        return None, (f"{action} does not take the parameter "
                      f"{', '.join(repr(k) for k in unknown)}; it takes: {allowed}")
    if spec["disruptive"]:
        try:
            require_confirm(params)
        except ValueError as exc:
            return None, str(exc)
    try:
        # Whitelist, not a copy: only the slots below ever reach the job file.
        normalised: dict = {}
        if spec["disruptive"]:
            normalised["confirm"] = True  # already proven to be exactly True
        if action in ("engine_save", "engine_save_apply_restart"):
            normalised["settings"] = validate_settings(params)
        # A different schema and a different file, so deliberately not the branch
        # above: `settings` names the payload slot, not one schema.
        if action in ("settings_save", "settings_save_apply_restart"):
            normalised["settings"] = validate_game_settings(params)
        # Same slot again, third schema (the four BACKUP_* keys).
        if action == "backup_schedule_save":
            normalised["settings"] = validate_schedule(params)
        if action in ("graceful_restart", "graceful_stop", "update_apply",
                      "engine_save_apply_restart", "settings_save_apply_restart",
                      "backup_restore"):
            normalised["wait"] = validate_wait(params)
        if action in ("graceful_restart", "graceful_stop"):
            normalised["message"] = validate_message(params)
        if action == "engine_apply":
            normalised["dry_run"] = validate_dry_run(params)
        if action == "snapshot_create":
            normalised["label"] = validate_label(params)
        if action == "mark":
            normalised["text"] = validate_text(params)
        if action == "engine_rollback":
            normalised["backup"] = validate_backup(params)
        # The same parameter *name* as engine_rollback's, validated by a different
        # function against a different directory: a rollback source is an
        # `Engine.ini.<stamp>` config backup, a restore/delete target is a
        # `palworld-save-<stamp>.tar.gz` world save. Neither must ever accept the
        # other's names, which is why validate_backup was left alone.
        if action in ("backup_restore", "backup_delete"):
            normalised["backup"] = validate_save_archive(params)
        if action == "backup_import":
            normalised["staged"] = validate_staged(params)
    except ValueError as exc:
        return None, str(exc)
    return normalised, None


def build_commands(action: str, params: dict) -> list[list[str]]:
    """Build the fixed argv list(s) for an already-validated action+params.

    Callers must run validate_params first; this does not re-validate (it can
    raise if given bad input, but run_job always calls validate_params first).
    """
    spec = ACTIONS[action]
    if spec["argv"] is None:
        return []  # engine_save / backup_schedule_save: file-only, no command
    # Exactly the tool's own command line, with no privilege-changing prefix: the
    # worker is already root and every action stays there (see the ACTIONS
    # preamble on the reverted drop_priv flag).
    return spec["argv"](params)


@contextlib.contextmanager
def backup_lock(job_id: str):
    """Hold the shared save-backup lock for a backup-family action.

    Blocking (bounded), unlike every other flock in this project: the scheduled
    tick takes the same lock with `-n` and skipping a tick costs nothing, but an
    action the operator queued from the browser must not be silently dropped
    because a tar happened to be running. `PALWARDEN_BACKUP_LOCK_WAIT` bounds the
    wait so a wedged holder fails the job with a message instead of parking the
    single worker forever.

    Not fatal when the lock file cannot be opened at all (an unprivileged dev run,
    a read-only /run): the action still runs, unserialised, with a warning on the
    service log. Refusing instead would make the *lock* able to stop backups, which
    is a worse failure than the race it prevents.
    """
    wait = BACKUP_LOCK_WAIT_DEFAULT
    raw = os.environ.get("PALWARDEN_BACKUP_LOCK_WAIT")
    if raw is not None:
        try:
            parsed = float(raw)
            if parsed >= 0:
                wait = parsed
        except ValueError:
            print(f"palwarden-jobd: ignoring PALWARDEN_BACKUP_LOCK_WAIT={raw!r}",
                  file=sys.stderr)
    try:
        BACKUP_LOCK.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(BACKUP_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError as exc:
        print(f"palwarden-jobd: cannot open {BACKUP_LOCK} ({exc.strerror}); running "
              "this backup action without serialising it against the scheduled tick",
              file=sys.stderr)
        yield
        return
    started = time.monotonic()
    announced = False
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                waited = time.monotonic() - started
                if waited >= wait:
                    raise TimeoutError(
                        f"another backup operation has held {BACKUP_LOCK} for "
                        f"{waited:.0f}s (the scheduled tick, most likely)")
                if not announced:
                    # Said once, and only when there is really something to wait
                    # for: a job that sat behind a 40-minute tar must say why, and
                    # an uncontended one must not add noise to its output.
                    announced = True
                    jobs.append_output(
                        job_id, f"waiting for {BACKUP_LOCK} (a scheduled backup is running)\n")
                time.sleep(1.0)
        yield
    finally:
        os.close(fd)  # releases the flock


def _run_step(job_id: str, argv: list[str]) -> int:
    """Run one step, recording its output **as it arrives**. Returns an exit code.

    This was `subprocess.run(..., capture_output=True, timeout=STEP_TIMEOUT)`, which
    buffers everything in the child's pipes and hands it over at the end — so a step
    that hit the timeout was killed and *all* of its output discarded, with only
    `TimeoutExpired`'s `str()` recorded. That was survivable while a timed-out step
    could only be a long backup. It stopped being survivable when `--restore` began
    swapping `Pal/Saved`'s contents entry by entry: a SIGKILL can now land *mid-swap*
    (a directory rename could only be interrupted before or after itself), the
    containerised restore copies the world rather than relinking it and so takes
    roughly twice as long, and the entire mitigation for a mixed tree is that every
    failure names the exact state the tree is in. Discarding the output discards the
    mitigation.

    So the output is appended in whole lines as the step produces it, and the
    timeout only decides when to stop reading. Whatever `palworld-restore` had
    printed — the safety archive's name, which entries had moved, the replaced
    tree's path — is on the job before the kill.

    **Chosen over deriving the timeout from the world size**, which was the other
    option. A size-derived bound is a guess about disk throughput, it still throws
    everything away when the guess is wrong, and it makes the failure mode depend on
    a measurement taken before the copy starts. A fixed bound whose output survives
    is strictly better than a clever bound whose output does not — and nothing stops
    the bound being raised later, now that exceeding it is diagnosable.

    stderr is merged into stdout rather than appended after it, so the interleaving
    the tool actually printed is what the operator reads. `palworld-restore` prints
    its recovery routes to stderr and its progress to stdout; those two belong in
    order.

    Decoded with `errors="replace"` and not by `text=True`: a step emitting a byte
    that is not UTF-8 used to raise `UnicodeDecodeError` out of `subprocess.run`,
    which is neither an `OSError` nor a `TimeoutExpired` and so took the worker down
    instead of failing the job.
    """
    proc = subprocess.Popen(argv, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT)
    deadline = time.monotonic() + STEP_TIMEOUT
    pending = b""
    timed_out = False

    def flush(data: bytes) -> None:
        if data:
            jobs.append_output(job_id, data.decode("utf-8", "replace"))

    try:
        stream = proc.stdout
        assert stream is not None
        fd = stream.fileno()
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                timed_out = True
                break
            try:
                # A bounded select rather than a blocking read, so the deadline is
                # enforced while the step is quiet as well as while it is talking.
                ready, _, _ = select.select([fd], [], [], min(left, 5.0))
            except InterruptedError:
                continue
            if not ready:
                continue
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            pending += chunk
            # Whole lines only: a half-written line appended now and completed later
            # would still read correctly, but a partial line is also how a truncated
            # multi-byte character gets mangled by the decode above.
            head, sep, pending = pending.rpartition(b"\n")
            if sep:
                flush(head + sep)
    finally:
        flush(pending)
        if timed_out:
            proc.kill()
        with contextlib.suppress(OSError):
            if proc.stdout is not None:
                proc.stdout.close()
        rc = proc.wait()
    if timed_out:
        jobs.append_output(
            job_id,
            f"timed out after {STEP_TIMEOUT:.0f}s and was killed: {argv!r}. The "
            f"output above is everything the step printed before it was killed - "
            f"for a restore, read it for which entries had already moved before "
            f"trusting the state of the world directory.\n")
        # 1, the code the TimeoutExpired handler used to return: the timeout is a
        # failed step, and nothing downstream distinguishes flavours of failure.
        return 1
    return rc


def _run_commands(job_id: str, action: str, params: dict) -> int:
    """Run an action's steps in order, stopping at the first failure."""
    exit_code = 0
    for argv in build_commands(action, params):
        try:
            exit_code = _run_step(job_id, argv)
        except OSError as exc:
            jobs.append_output(job_id, f"failed to run {argv!r}: {exc}\n")
            return 1
        if exit_code != 0:
            break
    return exit_code


def run_job(job: dict) -> int:
    """Validate, then execute a job's steps in order, recording output/state.

    Stops at the first failing step (composite actions like
    engine_save_apply_restart never reach a restart after a failed apply).
    Returns the exit code recorded on the job (0 on success).
    """
    job_id = job["id"]
    action = job.get("action")
    params, error = validate_params(action, job.get("params") or {})
    if error is not None:
        jobs.append_output(job_id, f"refused: {error}\n")
        jobs.update_job(job_id, state="failed", exit_code=1, finished_at=int(time.time()))
        return 1

    # engine_save (and the save half of the composite action) writes a file
    # rather than running a command; do that first so a bad write fails the
    # whole job before any command runs.
    if action in ("engine_save", "engine_save_apply_restart"):
        try:
            write_engine_env(params["settings"])
        except (OSError, ValueError) as exc:
            jobs.append_output(job_id, f"engine_save failed: {exc}\n")
            jobs.update_job(job_id, state="failed", exit_code=1, finished_at=int(time.time()))
            return 1
        jobs.append_output(job_id, "wrote engine.env\n")

    # The PalWorldSettings twin of the branch above: write the overrides file
    # first so a bad write fails the job before any apply/restart runs.
    if action in ("settings_save", "settings_save_apply_restart"):
        try:
            write_settings_overrides(params["settings"])
        except (OSError, ValueError) as exc:
            jobs.append_output(job_id, f"settings_save failed: {exc}\n")
            jobs.update_job(job_id, state="failed", exit_code=1, finished_at=int(time.time()))
            return 1
        jobs.append_output(job_id, f"wrote {SETTINGS_OVERRIDES.name}\n")

    # The other file-only action. Separate branch, not an extra name in the tuple
    # above: it writes a different file through a different writer, and the two share
    # only the "no command runs" property.
    if action == "backup_schedule_save":
        try:
            write_backup_schedule(params["settings"])
        except (OSError, ValueError) as exc:
            jobs.append_output(job_id, f"backup_schedule_save failed: {exc}\n")
            jobs.update_job(job_id, state="failed", exit_code=1, finished_at=int(time.time()))
            return 1
        jobs.append_output(job_id, "wrote the backup schedule\n")

    # The backup family runs under the shared save-backup lock, so a panel action
    # and the scheduled `--if-due --prune` tick can never overlap; everything else
    # is unaffected (nullcontext, not a second code path).
    if action in BACKUP_LOCKED_ACTIONS:
        guard: contextlib.AbstractContextManager = backup_lock(job_id)
    else:
        guard = contextlib.nullcontext()
    try:
        with guard:
            exit_code = _run_commands(job_id, action, params)
    except TimeoutError as exc:
        jobs.append_output(job_id, f"gave up waiting for the backup lock: {exc}\n")
        jobs.update_job(job_id, state="failed", exit_code=1, finished_at=int(time.time()))
        return 1

    state = "succeeded" if exit_code == 0 else "failed"
    jobs.update_job(job_id, state=state, exit_code=exit_code, finished_at=int(time.time()))
    return exit_code


def reap_orphans() -> int:
    """Mark any job left `running` (from a crash/restart) as failed.

    A job can only be `running` here because a previous worker claimed it and
    then died before finishing — this process only ever sees `running` jobs
    of its own making, moved there by claim_next just before run_job.
    """
    reaped = 0
    for job in jobs.list_jobs(limit=1000):
        if job.get("state") == "running":
            jobs.append_output(job["id"], "worker restarted; this job did not finish\n")
            jobs.update_job(job["id"], state="failed", exit_code=1, finished_at=int(time.time()))
            reaped += 1
    return reaped


def poll_once() -> None:
    # claim_next is an unlocked read-modify-write; that is safe here only
    # because every mode of main() holds the flock, so at most one worker
    # process ever calls it.
    #
    # It is *inside* the guard, not before it: a raise from claim_next may fail a
    # job or fail this poll, but must never end the daemon. It was outside, and a
    # job file whose `id` disagreed with its filename made claim_next raise
    # KeyError straight past this handler into main's loop — a traceback every
    # interval and no job ever draining again. palwarden_jobs.read_job now refuses
    # that file outright, but the structural point stands regardless of which
    # single bug prompted it.
    job = None
    try:
        job = jobs.claim_next()
        if job is None:
            return
        run_job(job)
    except Exception:  # noqa: BLE001 - one bad job must not stop the queue
        # A job file that vanished between claim and completion makes
        # append_output/update_job raise KeyError. Letting that escape would
        # end the worker's loop and silently stop the whole queue draining, so
        # fail this job (best effort — the file may genuinely be gone) and go
        # on. KeyboardInterrupt/SystemExit are BaseException and still escape.
        traceback.print_exc()
        if job is None:
            # The failure was in claim_next itself, so there is no claimed job to
            # record it on. Logged and swallowed: the next poll retries.
            return
        try:
            # Say *something* on the job itself: the traceback only goes to the
            # service log, and a job that flipped to "failed" with no output at
            # all is indistinguishable in the UI from a tool that printed nothing.
            jobs.append_output(job["id"],
                               "worker hit an internal error; see the service log\n")
        except Exception:  # noqa: BLE001 - the job file may genuinely be gone
            pass
        try:
            jobs.update_job(job["id"], state="failed", exit_code=1,
                            finished_at=int(time.time()))
        except Exception:  # noqa: BLE001 - nothing left to record it on
            pass


def acquire_lock() -> int | None:
    """Take the exclusive, non-blocking worker lock, or None if already held.

    *Every* mode takes it, not just the daemon loop: reap_orphans cannot tell a
    live sibling's `running` job from a crashed one, so a stray `--once`/`--reap`
    would mark a 20-minute update_apply as failed while it kept running, and
    would race the daemon in claim_next.
    """
    # Opening the lock is now on the path of *every* mode, including the one-shots
    # an operator may try by hand. The default lives in /run, which only root can
    # write, so a non-root invocation used to die with a raw PermissionError
    # traceback; say what is actually wrong instead.
    try:
        JOBD_LOCK.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(JOBD_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError as exc:
        raise SystemExit(
            f"cannot open lock {JOBD_LOCK}: {exc.strerror}; "
            "palwarden-jobd must run as root") from exc
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="palwarden-jobd",
        description="Root worker for the palwarden web UI job queue.")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--once", action="store_true",
                      help="reap, run at most one queued job, prune, exit")
    mode.add_argument("--reap", action="store_true",
                      help="mark jobs left running by a crash as failed, then exit")
    args = ap.parse_args(argv)

    # The lock is held for the life of the process in all three modes, so a
    # second worker can never run concurrently — that exclusivity is what makes
    # claim_next's unlocked read-then-write safe. Reaping only happens once we
    # hold it: reaping before could mark a job "failed" that a still-running
    # sibling worker legitimately owns.
    lock_fd = acquire_lock()
    if lock_fd is None:
        print(f"another palwarden-jobd holds {JOBD_LOCK}; exiting", file=sys.stderr)
        return 1

    if args.reap:
        reap_orphans()
        return 0
    if args.once:
        reap_orphans()
        poll_once()
        jobs.prune()
        return 0

    reap_orphans()
    while True:
        # Belt and braces around poll_once's own guard: a failure in
        # claim_next/prune (a corrupt directory, a full disk) must also not end
        # the loop.
        try:
            poll_once()
            jobs.prune()
        except Exception:  # noqa: BLE001 - keep draining the queue
            traceback.print_exc()
        time.sleep(JOBD_INTERVAL)


if __name__ == "__main__":
    raise SystemExit(main())
