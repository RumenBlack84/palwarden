#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
set -euo pipefail
source /usr/local/lib/palworld-notify 2>/dev/null || true
# Notifications are optional: no-op when the helper isn't installed, rather than
# aborting on "command not found".
declare -F palworld_notify >/dev/null || palworld_notify() { :; }

# Task 3 (idle-shutdown/knock-wake): shared lifecycle lock. Acquire-or-reuse the
# lock before any mutation so concurrent stop/restart/update/restore operations
# serialize. Sourced optionally (no-op when not installed, e.g. a bare dev
# checkout); must run before the arg parser below consumes "$@".
# See lib/palwarden-lifecycle-bash and spec section 4.1.
# Find the helper: explicit PALWARDEN_LIB_DIR, else the sibling lib/ of a dev
# checkout (sbin/../lib), else the installed /usr/local/lib. When the helper
# genuinely isn't installed anywhere (a bare checkout without it), fall back to
# a no-op; when it IS found but the lock cannot be taken, maybe_acquire fails
# loudly — enrollment never degrades silently to unlocked.
_pw_lc_helper="${PALWARDEN_LIB_DIR:-}"
if [[ -z "$_pw_lc_helper" ]]; then
  _pw_lc_cand="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" 2>/dev/null && pwd)" || _pw_lc_cand=""
  if [[ -n "$_pw_lc_cand" && -f "$_pw_lc_cand/palwarden-lifecycle-bash" ]]; then
    _pw_lc_helper="$_pw_lc_cand"
  else
    _pw_lc_helper=/usr/local/lib
  fi
fi
source "$_pw_lc_helper/palwarden-lifecycle-bash" 2>/dev/null || true
declare -F palworld_lifecycle_maybe_acquire >/dev/null \
  || palworld_lifecycle_maybe_acquire() { :; }
palworld_lifecycle_maybe_acquire "$@"
waittime=300
message="Server maintenance: saving and stopping in 5 minutes."
while [[ $# -gt 0 ]]; do
  case "$1" in
    --wait|-w) waittime="$2"; shift 2 ;;
    --message|-m) message="$2"; shift 2 ;;
    *) echo "Usage: $0 [--wait seconds] [--message text]" >&2; exit 64 ;;
  esac
done

# In-container: bring the server's s6 service down (its stop handler forwards
# SIGINT so the world saves) and keep it down. Avoids fighting s6 auto-restart.
if [[ "${PALWARDEN_CONTAINER:-0}" == "1" ]]; then
  PATH="/command:$PATH"   # ensure s6 tools are reachable
  svcdir="${PALWARDEN_S6_SVC_DIR:-/run/service}/palworld-server"
  palworld_notify start "graceful stop requested (container); bringing the server service down (SIGINT save)."
  # Mark wanted-down BEFORE the stop: s6-svc -d creates no marker file, and
  # idle-watch/knock classify stopped vs crash-backoff by its presence.
  if declare -F palworld_wanted_down_mark >/dev/null; then
      palworld_wanted_down_mark
  else
      mkdir -p "$svcdir" 2>/dev/null || true
      : > "$svcdir/down" 2>/dev/null || true
  fi
  s6-svc -wD -d "$svcdir"
  palworld_notify success "server service stopped (container)."
  echo "server service stopped."
  exit 0
fi

if ! systemctl is-active --quiet palworld.service; then echo "palworld.service is not active; nothing to stop."; exit 0; fi
echo "Calling Palworld REST API save..."
/usr/local/sbin/palworld-api-save
echo "Calling Palworld REST API timed stop with ${waittime}s notice..."
/usr/local/sbin/palworld-api-stop "$waittime" "$message"
deadline=$((SECONDS + waittime + 120))
while systemctl is-active --quiet palworld.service; do
  if (( SECONDS >= deadline )); then
    palworld_notify error "graceful stop timed out; palworld.service is still active. Manual inspection needed."
    echo "Timed out waiting for palworld.service to stop" >&2; exit 1
  fi
  sleep 5
done
palworld_notify success "graceful stop completed; palworld.service is inactive."
echo "palworld.service is inactive."
