# Scheduled world-save backups, read by palworld-backups on every tick.
#
# Installed to /etc/palworld/backup.env. Root-owned 0644 — tuning, not a secret,
# and the unprivileged web UI must never be able to rewrite it.
#
# This is live state, not just a template: the backup panel saves through
# palwarden-jobd's `backup_schedule_save` action, which rewrites this whole file.
# install.sh therefore never clobbers an existing copy (use --force-config to
# reset it to these values).
#
# The values below are palworld-backups' own defaults, written out so an operator
# can see and edit the schedule without opening a browser. A bad value here is
# never fatal: the tool warns on stderr and falls back to the default for that key,
# because a parse error must not silently stop backups on the one host whose
# operator was mid-edit.
#
# The service that reads this fires on a short fixed tick
# (palworld-backup-auto.timer, or the container's `backup-auto` s6 service); the
# interval below is what decides whether a backup actually happens. So changing
# any of this needs no daemon-reload and no restart.

# Master switch over *creating* archives. false makes each tick print that it is
# creating nothing — the schedule is disabled without disabling the timer/service,
# which is what lets the panel turn backups back on with nothing to reload.
#
# **It does not stop retention.** The tick runs `--if-due --prune` in one
# invocation on both platforms, and `--prune` is deliberately unconditional: the
# likeliest reason a backup fails is a full volume, and retention is what frees the
# space for the next attempt. So with BACKUP_ENABLED=false the existing archives
# still age out past BACKUP_RETENTION_DAYS, down to BACKUP_KEEP_MIN (and never the
# last one).
#
# To freeze a known-good set, raise BACKUP_RETENTION_DAYS and BACKUP_KEEP_MIN —
# that is the setting that decides what survives. Switching backups off is the one
# thing that does not, and an operator who reached for it to hold a set would watch
# it age out.
BACKUP_ENABLED=true

# Hours between scheduled backups (1-720). A backup is due when the newest archive
# is at least this old; the first tick on a host with no archives is always due.
BACKUP_INTERVAL_HOURS=24

# Delete archives older than this many days (1-3650) on each tick.
BACKUP_RETENTION_DAYS=14

# Always keep at least this many of the newest archives (1-100), whatever their
# age. Retention also never deletes the last remaining archive, regardless of this
# value: a policy that can empty the backups directory is a data-loss bug, not a
# configuration choice.
BACKUP_KEEP_MIN=3
