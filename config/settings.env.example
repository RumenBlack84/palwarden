# Palworld settings.env template for /usr/local/sbin/palworld-config-apply-env
#
# Copy lines you want into /etc/palworld/settings.env, or uncomment them here
# after copying this template. The parser only changes variables that are set
# and not commented out. Omitted/commented variables leave the live config as-is.
#
# Syntax examples:
#   SERVER_NAME="Yggdrasil Palworld"
#   MAX_PLAYERS=32
#   REST_API_ENABLED=False
#
# Booleans must be capitalized exactly: True or False
# Secrets such as ADMIN_PASSWORD and SERVER_PASSWORD are omitted from Discord diffs.

# --- Server identity / access ---
#SERVER_NAME="Yggdrasil Palworld"
#SERVER_DESCRIPTION="Yggdrasil dedicated Palworld server"
#SERVER_PASSWORD=""
#ADMIN_PASSWORD=""
#SERVER_REGION=""
#USE_AUTH=True
#BAN_LIST_URL="https://b.palworldgame.com/api/banlist.txt"
#SHOW_PLAYER_LIST=False

# --- Networking ---
#PUBLIC_IP=""
#SERVER_IP=""
#SERVER_PORT=8211
#REST_API_ENABLED=False
#REST_API_PORT=8212
#RCON_ENABLE=False
#RCON_PORT=25575
#CROSSPLAY_PLATFORMS="Steam,Xbox,PS5,Mac"

# --- Player / multiplayer limits ---
#MAX_PLAYERS=32
#COOP_PLAYER_MAX_NUM=4
#GUILD_PLAYER_MAX_NUM=20
#BASE_CAMP_MAX_NUM_IN_GUILD=4
#IS_MULTIPLAY=True
#IS_PVP=False
#ENABLE_PLAYER_TO_PLAYER_DAMAGE=False
#ENABLE_FRIENDLY_FIRE=False
#CAN_PICKUP_OTHER_GUILD_DEATH_PENALTY_DROP=False
#ENABLE_DEFENSE_OTHER_GUILD_PLAYER=False
#EXIST_PLAYER_AFTER_LOGOUT=False
#ENABLE_NON_LOGIN_PENALTY=True

# --- Gameplay / world balance ---
#DIFFICULTY=None
#DAY_TIME_SPEED_RATE=1.000000
#NIGHT_TIME_SPEED_RATE=1.000000
#EXP_RATE=1.000000
#PAL_CAPTURE_RATE=1.000000
#PAL_SPAWN_NUM_RATE=1.000000
#DEATH_PENALTY=All
#ENABLE_FAST_TRAVEL=True
#IS_START_LOCATION_SELECT_BY_MAP=True
#HARDCORE=False
#PAL_LOST=False
#CHARACTER_RECREATE_IN_HARDCORE=False
#RANDOMIZER_TYPE=None
#RANDOMIZER_SEED=""
#IS_RANDOMIZER_PAL_LEVEL_RANDOM=False

# --- Player stats ---
#PLAYER_DAMAGE_RATE_ATTACK=1.000000
#PLAYER_DAMAGE_RATE_DEFENSE=1.000000
#PLAYER_STOMACH_DECREACE_RATE=1.000000
#PLAYER_STAMINA_DECREACE_RATE=1.000000
#PLAYER_AUTO_HP_REGENE_RATE=1.000000
#PLAYER_AUTO_HP_REGENE_RATE_IN_SLEEP=1.000000
#ITEM_WEIGHT_RATE=1.000000

# --- Pal stats ---
#PAL_DAMAGE_RATE_ATTACK=1.000000
#PAL_DAMAGE_RATE_DEFENSE=1.000000
#PAL_STOMACH_DECREACE_RATE=1.000000
#PAL_STAMINA_DECREACE_RATE=1.000000
#PAL_AUTO_HP_REGENE_RATE=1.000000
#PAL_AUTO_HP_REGENE_RATE_IN_SLEEP=1.000000
#PAL_EGG_DEFAULT_HATCHING_TIME=72.000000
#ALLOW_GLOBAL_PALBOX_EXPORT=True
#ALLOW_GLOBAL_PALBOX_IMPORT=False
#ENABLE_PREDATOR_BOSS_PAL=True

# --- Base / building / work ---
#BASE_CAMP_MAX_NUM=128
#BASE_CAMP_WORKER_MAX_NUM=15
#BUILD_OBJECT_HP_RATE=1.000000
#BUILD_OBJECT_DAMAGE_RATE=1.000000
#BUILD_OBJECT_DETERIORATION_DAMAGE_RATE=1.000000
#WORK_SPEED_RATE=1.000000
#MAX_BUILDING_LIMIT_NUM=0
#BUILD_AREA_LIMIT=False
#INVISIBLE_OTHER_GUILD_BASE=False
#SERVER_REPLICATE_PAWN_CULL_DISTANCE=15000.000000

# --- Drops / resources / enemies ---
#COLLECTION_DROP_RATE=1.000000
#COLLECTION_OBJECT_HP_RATE=1.000000
#COLLECTION_OBJECT_RESPAWN_SPEED_RATE=1.000000
#ENEMY_DROP_ITEM_RATE=1.000000
#ENABLE_ENEMY=True
#DROP_ITEM_MAX_NUM=3000
#DROP_ITEM_MAX_NUM_UNKO=100
#DROP_ITEM_ALIVE_MAX_HOURS=1.000000
#ACTIVE_UNKO=False

# --- Server management / performance ---
#AUTO_SAVE_SPAN=30
#USE_BACKUP_SAVE_DATA=True
#LOG_FORMAT_TYPE=Text
#SUPPLY_DROP_SPAN=180
#CHAT_POST_LIMIT=30
#ITEM_CONTAINER_FORCE_MARK_DIRTY_INTERVAL=1.000000
