#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
#
# Minimal systemctl -> s6 adapter, installed ONLY in the palwarden container
# (ahead of any real systemctl on PATH). It implements the small subset of
# systemctl the tooling scripts actually call, translating to s6 supervision and
# cgroup v2 reads, so those scripts run unchanged in the container. On bare metal
# this shim is not installed and the real systemctl is used.
set -u

# s6 tools live in /command; ensure they're reachable regardless of caller PATH.
PATH="/command:$PATH"
S6_SVC_DIR="${PALWARDEN_S6_SVC_DIR:-/run/service}"
CGROUP_MEM="${PALWARDEN_CGROUP_MEM:-/sys/fs/cgroup/memory.current}"

map_svc() {
  case "$1" in
    palworld.service|palworld) echo "palworld-server" ;;
    *.service) echo "${1%.service}" ;;
    *) echo "$1" ;;
  esac
}

cmd="${1:-}"; shift || true
quiet=0; value=0; props=(); positional=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet|-q) quiet=1; shift ;;
    --value) value=1; shift ;;
    --no-pager|--all|--full|-l|--plain) shift ;;
    # `systemctl show` accepts several -p flags at once (health-report asks for
    # five in one call), so collect them all rather than keeping the last.
    -p) props+=("$2"); shift 2 ;;
    -p*) props+=("${1#-p}"); shift ;;
    --property=*) props+=("${1#--property=}"); shift ;;
    -*) shift ;;
    *) positional+=("$1"); shift ;;
  esac
done

svc_raw="${positional[0]:-}"
svc="$(map_svc "$svc_raw")"
svcdir="$S6_SVC_DIR/$svc"

# s6-svstat needs root, but the telemetry/watchdog jobs run as `steam`. When it is
# unavailable, fall back to looking for the game process, which any user can see in
# /proc — otherwise an unprivileged caller sees a running server as "inactive".
# The fallback is server-specific, so it only applies to that service.
SERVER_PROCESS="${PALWARDEN_SERVER_PROCESS:-PalServer-Linux-Shipping}"
svstat_works() { s6-svstat "$svcdir" >/dev/null 2>&1; }
is_server_svc() { [[ "$svc" == "palworld-server" ]]; }

svc_up() {
  if svstat_works; then
    s6-svstat "$svcdir" 2>/dev/null | grep -q '^up'
  elif is_server_svc; then
    pgrep -f "$SERVER_PROCESS" >/dev/null 2>&1
  else
    return 1
  fi
}

svc_pid() {
  local pid=""
  if svstat_works; then
    pid="$(s6-svstat "$svcdir" 2>/dev/null | grep -oE 'pid [0-9]+' | grep -oE '[0-9]+' | head -1)"
  elif is_server_svc; then
    pid="$(pgrep -f "$SERVER_PROCESS" 2>/dev/null | head -1)"
  fi
  printf '%s' "$pid"
}
# s6-svstat reports "up (pid N pgid N) S seconds"; S is the service's uptime.
svc_uptime_seconds() { s6-svstat "$svcdir" 2>/dev/null | grep -oE '[0-9]+ seconds' | grep -oE '^[0-9]+'; }

case "$cmd" in
  is-active)
    if svc_up; then [[ $quiet -eq 1 ]] || echo active; exit 0
    else [[ $quiet -eq 1 ]] || echo inactive; exit 3; fi ;;
  is-enabled)
    if [[ -e "/etc/s6-overlay/s6-rc.d/user/contents.d/$svc" ]]; then echo enabled; exit 0
    else echo disabled; exit 1; fi ;;
  is-failed) exit 1 ;;
  show)
    for prop in "${props[@]}"; do
      out=""
      case "$prop" in
        MemoryCurrent) out="$(cat "$CGROUP_MEM" 2>/dev/null || echo 0)" ;;
        MainPID)       out="$(svc_pid)"; out="${out:-0}" ;;
        ActiveState)   svc_up && out="active" || out="inactive" ;;
        SubState)      svc_up && out="running" || out="dead" ;;
        ExecMainStartTimestamp)
          # Derive the start time from the service's uptime, which is all s6 knows.
          secs="$(svc_uptime_seconds)"
          if [[ -n "$secs" ]]; then
            out="$(date -u -d "@$(( $(date -u +%s) - secs ))" '+%a %Y-%m-%d %H:%M:%S UTC' 2>/dev/null || echo "")"
          fi
          ;;
        # s6 keeps no restart counter, so this is genuinely unknown here; report
        # it empty rather than inventing a zero.
        NRestarts)     out="" ;;
        *)             out="" ;;
      esac
      if [[ $value -eq 1 ]]; then echo "$out"; else echo "${prop}=${out}"; fi
    done
    exit 0 ;;
  start)   s6-svc -u "$svcdir" 2>/dev/null; exit $? ;;
  stop)    s6-svc -wD -d "$svcdir" 2>/dev/null; exit $? ;;
  restart) s6-svc -r "$svcdir" 2>/dev/null; exit $? ;;
  daemon-reload|enable|disable) exit 0 ;;
  list-timers) echo "container: timers run as s6 services (palwarden-run-periodic/-daily)"; exit 0 ;;
  cat) echo "# container: ${svc_raw:-service} is managed by s6, not systemd"; exit 0 ;;
  *) echo "systemctl-shim: '$cmd' not implemented in container" >&2; exit 0 ;;
esac
