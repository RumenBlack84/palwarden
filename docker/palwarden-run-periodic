#
# palwarden-run-periodic <interval_seconds> <label> <command> [args...]
#
# Minimal periodic runner for the container's background jobs: run the command,
# sleep, repeat. Replaces the systemd timers that drive these on bare metal.
# Intended to be launched by an s6 service (already dropped to the steam user).
# Command failures are logged, never fatal, so one bad tick doesn't stop the job.
set -u

interval="${1:?usage: palwarden-run-periodic <interval> <label> <command...>}"; shift
label="${1:?usage: palwarden-run-periodic <interval> <label> <command...>}"; shift

# No SIGTERM trap: on stop, the default action terminates this runner promptly so
# it never delays container shutdown. (A bash trap here does not fire reliably
# under s6 supervision, which would make s6 wait out S6_KILL_GRACETIME.)
printf '[periodic:%s] every %ss: %s\n' "$label" "$interval" "$*"
while true; do
  "$@" || printf '[periodic:%s] command exited %s\n' "$label" "$?"
  sleep "$interval"
done
