#!/command/with-contenv bash
# shellcheck shell=bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
#
# Palworld dedicated server, supervised by s6 as the unprivileged `steam` user.
#
# We exec the game binary DIRECTLY (the work PalServer.sh does — copying
# steamclient.so and chmod'ing the binary — is done once in the entrypoint
# bootstrap). Supervising the binary directly means s6 can deliver the stop
# signal to the actual process. The service's `down-signal` is SIGINT, which is
# how Palworld saves its world on shutdown/restart (matching KillSignal=SIGINT
# from the systemd unit).
cd /opt/palworld/server || exit 1
exec s6-setuidgid steam ./Pal/Binaries/Linux/PalServer-Linux-Shipping Pal \
  -useperfthreads \
  -NoAsyncLoadingThread \
  -UseMultithreadForDS
