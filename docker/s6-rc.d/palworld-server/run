#!/command/with-contenv bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Brian Grant
#
# Palworld dedicated server, supervised by s6 and run as the unprivileged
# `steam` user. Preserves the VM launch flags and the SIGINT save-on-stop
# behavior from the systemd unit / runbook.
set -u
cd /opt/palworld/server || exit 1

term() {
  # Palworld saves its world on SIGINT. On stop (s6 sends SIGTERM), forward
  # SIGINT to the actual game process — PalServer.sh does not reliably propagate
  # signals — falling back to the launched child if the game isn't found yet.
  pkill -INT -f 'PalServer-Linux-Shipping' 2>/dev/null \
    || kill -INT "${child:-0}" 2>/dev/null \
    || true
}
trap term TERM INT

s6-setuidgid steam ./PalServer.sh \
  -useperfthreads \
  -NoAsyncLoadingThread \
  -UseMultithreadForDS &
child=$!

# Re-enter wait after the trap interrupts it, until the server has really exited.
while kill -0 "$child" 2>/dev/null; do
  wait "$child" && break
done
