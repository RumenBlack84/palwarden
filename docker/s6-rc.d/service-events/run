# Crash/restart watchdog (embedded). Samples the server's state + main PID and
# records a marker when it changed, so unexpected restarts show up on the FPS
# graphs and in the daily health report. Runs as the unprivileged steam user.
exec s6-setuidgid steam palwarden-run-periodic \
  "${SERVICE_EVENTS_INTERVAL:-60}" service-events \
  palworld-service-events sample
