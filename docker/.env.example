# palwarden Docker configuration — copy to .env and edit.
#
#   cp .env.example .env
#
# .env is git-ignored; never put real passwords here for a public repo.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# Which services compose starts. "embedded" runs the Palworld server in-stack.
# For external management (next increment), leave this empty and set
# PALWARDEN_MODE=external below.
COMPOSE_PROFILES=embedded

# Role of the palwarden image at runtime:
#   embedded = run the server here (self-contained)
#   external = manage an existing Palworld server at PALWORLD_TARGET_HOST
PALWARDEN_MODE=embedded

# ---------------------------------------------------------------------------
# Embedded mode (self-contained server)
# ---------------------------------------------------------------------------
# Run a SteamCMD validate/update every time the container starts. Keep true so
# the first run installs the game; set false for faster restarts once installed.
UPDATE_ON_START=true

# Host UDP port players connect to (maps to 8211/udp in the container).
PALWORLD_GAME_PORT=8211

# ---------------------------------------------------------------------------
# External mode (manage an existing server) — used by the tooling increment
# ---------------------------------------------------------------------------
# Where the management tooling reaches the existing server's REST API.
# In embedded mode this defaults to the in-stack service name (palworld-server).
PALWORLD_TARGET_HOST=palworld-server
PALWORLD_REST_PORT=8212
