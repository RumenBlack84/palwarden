# palwarden Docker configuration — copy to .env and edit.
#
#   cp .env.example .env
#
# .env is git-ignored; never put real passwords here for a public repo.
#
# Everything in .env is BOTH used to fill in compose.yaml AND passed into the
# container, which is what lets open-ended settings like PALWORLD_CFG_<KEY> work.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# Which services compose starts. "embedded" runs the Palworld server in-stack.
# For external management (next increment), leave this empty and set
# PALWARDEN_MODE=external below.
COMPOSE_PROFILES=embedded

# Role of the palwarden image at runtime:
#   embedded = run the server here (self-contained)
#   external = manage an existing Palworld server at PALWORLD_TARGET_HOST
PALWARDEN_MODE=embedded

# ---------------------------------------------------------------------------
# Embedded mode (self-contained server)
# ---------------------------------------------------------------------------
# Run a SteamCMD validate/update every time the container starts. Keep true so
# the first run installs the game; set false for faster restarts once installed.
UPDATE_ON_START=true

# Host UDP port players connect to (maps to 8211/udp in the container).
PALWORLD_GAME_PORT=8211

# Host port for the config web UI (published to 127.0.0.1 only).
WEBUI_PORT=8088

# ---------------------------------------------------------------------------
# REST API credentials + notifications (used by the tooling in BOTH modes)
# ---------------------------------------------------------------------------
# Palworld REST API admin password. Required for telemetry and management.
# Leave blank to disable the tooling entirely. NEVER commit a real value.
#   Embedded: the server's PalWorldSettings.ini must also enable the REST API
#   with this same password (server-config rendering lands in a later increment).
ADMIN_PASSWORD=

# Discord webhook for notifications/reports (optional).
DISCORD_WEBHOOK=

# ---------------------------------------------------------------------------
# Server settings (embedded) — applied to PalWorldSettings.ini on boot
# ---------------------------------------------------------------------------
# Any PALWORLD_CFG_<KEY> is written to settings.env as <KEY> and applied by
# palworld-config-apply-env before the server starts. Setting ADMIN_PASSWORD
# above already enables the REST API. Examples:
#PALWORLD_CFG_SERVER_NAME=Yggdrasil Palworld
#PALWORLD_CFG_SERVER_DESCRIPTION=Yggdrasil dedicated Palworld server
#PALWORLD_CFG_MAX_PLAYERS=32
#PALWORLD_CFG_SERVER_PASSWORD=
#PALWORLD_CFG_DIFFICULTY=None

# ---------------------------------------------------------------------------
# Telemetry sampler
# ---------------------------------------------------------------------------
FPS_SAMPLE_INTERVAL=15
FPS_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Memory watchdog (embedded only) — restarts the server if memory is too high
# ---------------------------------------------------------------------------
MEMORY_THRESHOLD=85          # percent of host RAM / container cgroup
MEMORY_CHECK_INTERVAL=300    # seconds between checks
MEMORY_WAIT=300              # player warning window before restart

# ---------------------------------------------------------------------------
# Daily Discord report (needs DISCORD_WEBHOOK). Time is UTC.
# ---------------------------------------------------------------------------
DAILY_REPORT_AT=09:00

# ---------------------------------------------------------------------------
# Steam auto-update (embedded, opt-in). When a new build is published the server
# is gracefully stopped, updated via SteamCMD, and restarted.
# ---------------------------------------------------------------------------
UPDATE_CHECK=false
UPDATE_CHECK_INTERVAL=1800    # seconds between checks

# ---------------------------------------------------------------------------
# Public join-info watcher (embedded, opt-in). Set PUBLIC_HOSTNAME to enable;
# publishes hostname/IP/port/password to Discord when they change.
# ---------------------------------------------------------------------------
#PUBLIC_HOSTNAME=palworld.example.com
PUBLIC_INFO_INTERVAL=600

# ---------------------------------------------------------------------------
# Web UI (http://127.0.0.1:8088) — Basic auth on every path
# ---------------------------------------------------------------------------
# Leave blank to have credentials generated on first start; read them back with
#   docker compose exec palwarden cat /etc/palworld/webui.env
# WARNING: Credentials are regenerated if the container is recreated
# (docker compose up --build), so set WEBUI_USER/WEBUI_PASSWORD below
# if you want them to persist across rebuilds.
#WEBUI_USER=admin
#WEBUI_PASSWORD=
#WEBUI_TOKEN=

# ---------------------------------------------------------------------------
# External mode (manage an existing server)
# ---------------------------------------------------------------------------
# Where the tooling reaches the existing server's REST API. Required for
# external mode. The server there must have its REST API enabled.
PALWORLD_TARGET_HOST=192.0.2.10
PALWORLD_REST_PORT=8212
