# Python/runtime artifacts
__pycache__/
*.pyc

# Local secrets / live config — never commit these.
# The tooling reads them at runtime from /etc/palworld and /var/lib/palworld.
settings.env
notify.env
public-info.env
*.sqlite3
*.pem
*.key

# Local editor state
.DS_Store
*.swp

# Docker local env
docker/.env

# Runtime state written into the test fixture by container runs
tests/fixtures/fake-server/Pal/Saved/

# Claude Code local state (permission allowlists, temp files)
.claude/
